{% set rows = panel.showSplit ? panel.sources : [] %}
{% set total = 0 %}
{% for row in rows %}{% set total = total + (row.qty ?? 0) %}{% endfor %}
<section class="stockviz mt-6 max-w-sm border-y border-ash-200 py-4" data-level="{{ panel.level }}">
    <p class="font-mono text-[0.66rem] uppercase tracking-[0.2em] text-ash-500">{{ panel.title }}</p>
    <p class="mt-2 flex items-baseline gap-2">
        {%- apply island_if(panel.showFigure) -%}
            <span class="stockviz__figure font-mono text-2xl leading-none text-ink">{{ panel.qty }}</span>
        {%- endapply -%}
        <span class="text-sm text-ink-soft">{{ panel.statusWord }}</span>
    </p>
    {%- if panel.showSplit -%}
        <div class="stockviz__rail mt-3 flex h-1.5 w-full overflow-hidden rounded-full bg-ash-200" role="img" aria-label="{{ panel.statusWord }}">
            {%- apply island_list -%}
                {%- for row in rows -%}
                    <span class="stockviz__seg h-full {{ loop.index0 % 2 == 0 ? 'stockviz__seg--a' : 'stockviz__seg--b' }}"
                          style="width: {{ total > 0 ? ((row.qty ?? 0) / total * 100)|round : 0 }}%;"></span>
                {%- endfor -%}
            {%- endapply -%}
        </div>
    {%- elseif panel.showRail -%}
        <div class="stockviz__rail mt-3 h-1.5 w-full overflow-hidden rounded-full bg-ash-200">
            <span class="stockviz__seg stockviz__seg--a block h-full" style="width: {{ panel.fill }}%;"></span>
        </div>
    {%- else -%}
        {%- apply island_if(false) %}{% endapply -%}
    {%- endif -%}
    {%- apply island_if(panel.isChildren and panel.sets is not null) -%}
        <p class="mt-2 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-ash-500">
            {{ panel.sets > 0 ? panel.setsTemplate|replace({'%1': panel.sets}) : panel.noSetsText }}
        </p>
    {%- endapply -%}
    {%- apply island_if(panel.isChildren and panel.children|length) -%}
        <dl class="mt-3 space-y-1.5">
            {%- apply island_list -%}
                {%- for child in panel.children -%}
                    <div class="flex items-baseline justify-between gap-4">
                        <dt class="truncate font-mono text-[0.66rem] uppercase tracking-[0.14em] text-ash-500">{{ child.label }}</dt>
                        <dd class="stockviz__figure shrink-0 font-mono text-xs text-ink-soft">{{ child.qty }}</dd>
                    </div>
                {%- endfor -%}
            {%- endapply -%}
        </dl>
    {%- endapply -%}
    {%- apply island_if(panel.showSplit) -%}
        <dl class="mt-3 space-y-1.5">
            {%- apply island_list -%}
                {%- for row in rows -%}
                    <div class="flex items-baseline justify-between gap-4">
                        <dt class="flex min-w-0 items-center gap-1.5 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-ash-500">
                            {{- hero_icon('map-pin', 'outline', '24', 'size-3.5 shrink-0 text-ash-400') -}}
                            <span class="truncate">{{ row.name }}</span>
                        </dt>
                        <dd class="stockviz__figure shrink-0 font-mono text-xs text-ink-soft">{{ row.qty }}</dd>
                    </div>
                {%- endfor -%}
            {%- endapply -%}
        </dl>
    {%- endapply -%}
    {%- apply island_if(panel.onDemand and not panel.revealed) -%}
        <button type="button" class="stockviz__cta mt-3 font-mono text-[0.66rem] uppercase tracking-[0.2em] text-ink-soft">{{ panel.ctaLabel }}</button>
    {%- endapply -%}
    {%- apply island_if(false) %}{% endapply -%}
</section>
