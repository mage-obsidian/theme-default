{#
  Contact form. `block` is the native ContactForm (form action + UserDataProvider
  prefill). Native field names (name/email/telephone/comment) POST to
  contact/index/post; required + email validation are server-side, so it works
  with no JS. HTML5 attributes give a basic client-side check on top.
#}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set vm = block.getViewModel() %}
<div class="contact mx-auto w-full max-w-[640px] px-4 py-12 md:px-8">
    <p class="font-mono text-sm text-ink-soft">
        {{ __('Jot us a note and we’ll get back to you as quickly as possible.') }}
    </p>

    <form class="mt-8 flex flex-col gap-6" action="{{ block.getFormAction()|escape_url }}" method="post" id="contact-form" data-busy-submit>
        {{ block.getBlockHtml('formkey')|raw }}

        {{ form.field({
            name: 'name',
            id: 'name',
            label: __('Name'),
            value: vm.getUserName(),
            required: true,
            autocomplete: 'name'
        }) }}

        {{ form.field({
            name: 'email',
            id: 'email',
            label: __('Email'),
            type: 'email',
            value: vm.getUserEmail(),
            required: true,
            autocomplete: 'email'
        }) }}

        {{ form.field({
            name: 'telephone',
            id: 'telephone',
            label: __('Phone Number'),
            type: 'tel',
            value: vm.getUserTelephone(),
            autocomplete: 'tel'
        }) }}

        {{ form.field({
            name: 'comment',
            id: 'comment',
            label: __('What’s on your mind?'),
            type: 'textarea',
            required: true,
            attrs: { rows: 5 }
        }) }}

        {# The platform's challenges, when it asks for one. Inside the form so a native
           POST carries their answer without JavaScript. #}
        {{ child_html('captcha') }}
        {{ child_html('recaptcha') }}

        {{ form.required_note(__('Required Fields')) }}

        <button type="submit"
                class="btn btn--solid btn--lg self-start">
            {{ __('Submit') }}
        </button>
    </form>
</div>
{{ script('MageObsidian_Storefront::js/form-busy') }}
