{#
  Popular search terms cloud. `block` is Magento\Search\Block\Term: getTerms()
  returns the terms that produced results, each carrying a getRatio() between 0
  and 1 for how popular it is relative to the rest.

  The ratio rides on a custom property instead of an inline font-size, so the type
  scale stays in the stylesheet — the core phtml hard-codes `ratio*70+75%` in the
  markup. No <h1> here: page.main.title already emits it from the page title.
#}
{% import 'Magento_Theme::macros/state.twig' as state %}
{% set terms = block.getTerms() %}

<div class="search-terms mx-auto max-w-shell px-4 pb-16 md:px-8">
    {% if terms is not empty %}
        {# The weight is the term's own ratio, so it cannot live in the stylesheet
           — and a style attribute is what an enforcing policy drops. #}
        {{ style_rules(terms|reduce((rules, entry) => rules|merge({
            ('.search-terms__item--' ~ entry.getQueryId()): '--term-weight: ' ~ entry.getRatio()|round(3)
        }), {})) }}
        <ul class="search-terms__list">
            {% for term in terms %}
                <li class="search-terms__item search-terms__item--{{ term.getQueryId() }}">
                    <a class="search-terms__link" href="{{ block.getSearchUrl(term)|escape_url }}">
                        {{ term.getQueryText() }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        {# No icon: the core Search\Block\Term cannot render one. #}
        {{ state.empty(block, {
            title: __('There are no search terms available.'),
            cta: __('Continue Shopping'),
            cta_url: block.getUrl('')
        }) }}
    {% endif %}
</div>
