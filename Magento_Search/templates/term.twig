{#
  Popular search terms cloud. `block` is Magento\Search\Block\Term: getTerms()
  returns the terms that produced results, each carrying a getRatio() between 0
  and 1 for how popular it is relative to the rest.

  The ratio rides on a custom property instead of an inline font-size, so the type
  scale stays in the stylesheet — the core phtml hard-codes `ratio*70+75%` in the
  markup. No <h1> here: page.main.title already emits it from the page title.
#}
{% set terms = block.getTerms() %}

<div class="search-terms mx-auto max-w-[1320px] px-4 pb-16 md:px-8">
    {% if terms is not empty %}
        <ul class="search-terms__list">
            {% for term in terms %}
                <li class="search-terms__item" style="--term-weight: {{ term.getRatio()|round(3) }}">
                    <a class="search-terms__link" href="{{ block.getSearchUrl(term)|escape_url }}">
                        {{ term.getQueryText() }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <div class="search-terms__empty py-16 text-center">
            <p class="font-mono text-sm uppercase tracking-[0.16em] text-ink-soft">
                {{ __('There are no search terms available.') }}
            </p>
            <a href="{{ block.getUrl('') }}" class="btn btn--solid btn--lg mt-8">
                {{ __('Continue Shopping') }}
            </a>
        </div>
    {% endif %}
</div>
