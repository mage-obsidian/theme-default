{#
  Featured category tiles, from the FeaturedCategories ViewModel (real catalog
  categories). Each tile links to the category; the category image (when present)
  sits behind a vitreous scrim for legibility. Renders nothing when the catalog
  has no menu categories. Capped at 4 by the ViewModel → static lg:grid-cols-4.
#}
{% set featured = block.getFeatured().getItems() %}
{% if featured|length %}
    <section class="mx-auto max-w-shell px-6 py-16 md:px-8 md:py-24" aria-labelledby="featured-categories-heading">
        <h2 id="featured-categories-heading" class="sr-only">{{ __('Shop by category') }}</h2>
        <div class="grid grid-cols-1 gap-px overflow-hidden rounded-edge border border-ash-200 bg-ash-200 sm:grid-cols-2 lg:grid-cols-4">
            {% for item in featured %}
                <a href="{{ item.url|escape_url }}"
                   class="group relative flex aspect-[4/5] flex-col justify-end overflow-hidden bg-obsidian-900 p-6 text-on-obsidian">
                    {% if item.image %}
                        <img src="{{ item.image|escape_url }}" alt="" loading="lazy" decoding="async"
                             class="absolute inset-0 h-full w-full object-cover opacity-70 transition-transform duration-500 ease-out group-hover:scale-105">
                        <span class="absolute inset-0 bg-gradient-to-t from-obsidian-950/85 via-obsidian-950/20 to-transparent"></span>
                    {% endif %}
                    <span class="relative font-display text-2xl leading-tight">{{ item.label }}</span>
                    <span class="relative mt-1 font-mono text-eyebrow uppercase tracking-label text-on-obsidian-soft">
                        {{ __('Shop now') }} <span aria-hidden="true">→</span>
                    </span>
                </a>
            {% endfor %}
        </div>
    </section>
{% endif %}
