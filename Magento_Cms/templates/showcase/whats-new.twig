{#
  What's New showcase page — repurposes the nav slot to present the framework's
  modern approach: a page hero, then the feature grid, the stack and the
  community band. The visible category <h1> is suppressed for this slot (see the
  showcase rule in the theme CSS); this hero owns the heading.
#}
<section class="showcase-bleed sheen relative isolate overflow-hidden bg-obsidian-950 text-on-obsidian">
    <div class="relative z-10 mx-auto max-w-[1320px] px-6 py-24 md:px-8 md:py-36">
        <p class="font-mono uppercase tracking-[0.3em] text-on-obsidian-soft" style="font-size:var(--text-eyebrow)">{{ __('What’s New') }}</p>
        <h1 class="mt-6 max-w-[16ch] font-display font-semibold leading-[0.95]" style="font-size:var(--text-hero)">
            {{ __('A new way to build Magento frontends') }}
        </h1>
        <p class="mt-8 max-w-2xl font-body text-on-obsidian-soft" style="font-size:var(--text-lead)">
            {{ __('MageObsidian brings Vite, TailwindCSS, Vue and Twig to Magento’s native Layouts, Blocks and Templates — a modern, lazy-hydrated frontend without leaving the platform behind.') }}
        </p>
        <a href="https://mage-obsidian.jeanmarcos.dev/" target="_blank" rel="noopener"
           class="btn btn--lg btn--invert-outline mt-10 gap-3 px-6">
            {{ __('Read the docs') }} <span aria-hidden="true">→</span>
        </a>
    </div>
</section>
{% include 'Magento_Cms::showcase/features.twig' %}
{% include 'Magento_Cms::showcase/tech-stack.twig' %}
{% include 'Magento_Cms::showcase/community.twig' %}
