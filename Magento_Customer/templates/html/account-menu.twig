{# Header account state. Rendered by a MageObsidian Template child block so
   render_vue is available; mounts eager (above the fold). The AccountMenu island
   reads the client-side `customer` section (guest "Sign In" vs the logged-in
   disclosure). The <noscript> link is the no-JS fallback — it points at
   customer/account, which natively redirects guests to sign-in. `account_state`
   is the AccountState ViewModel (layout argument). #}
{% set acc = block.getAccountState() %}
{# The component's own state before customer-data arrives, so Vue adopts it —
   keep in step with the `v-else` branch of AccountMenu.vue. A visitor whose
   customer-data is already cached resolves a different branch on the very first
   render, which is a legitimate swap rather than drift, so this node is exempted
   from the mismatch check. #}
{% set initial %}<span data-allow-mismatch class="mo-prepaint-guest whitespace-nowrap font-mono text-[0.72rem] uppercase tracking-[0.12em] text-ink-soft">{{ __('Sign In') }}</span>{% endset %}
{{ render_vue('MageObsidian_Customer::account/AccountMenu', {
    accountUrl: acc.getAccountUrl(),
    loginUrl: acc.getLoginUrl(),
    logoutUrl: acc.getLogoutUrl(),
    ordersUrl: acc.getOrdersUrl(),
    addressesUrl: acc.getAddressesUrl(),
    signInLabel: __('Sign In'),
    menuLabel: __('Account'),
    myAccountLabel: __('My Account'),
    myOrdersLabel: __('My Orders'),
    addressBookLabel: __('Address Book'),
    signOutLabel: __('Sign Out')
}, true, initial, true) }}
<noscript>
    <a href="{{ acc.getAccountUrl()|escape_url }}" class="hidden transition-colors hover:text-ink sm:inline">{{ __('Account') }}</a>
</noscript>
