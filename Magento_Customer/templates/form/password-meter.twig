<p class="field__hint" data-password-policy>
    {{ __('At least %1 characters, using %2 of: lower case, upper case, digits and special characters.', policy.minLength(), policy.requiredClasses()) }}
</p>
<div class="pwd-strength" data-password-strength data-level="0" role="status" aria-live="polite"
     data-label-1="{{ __('Weak')|escape_html_attr }}"
     data-label-2="{{ __('Fair')|escape_html_attr }}"
     data-label-3="{{ __('Good')|escape_html_attr }}"
     data-label-4="{{ __('Strong')|escape_html_attr }}">
    <span class="pwd-strength__bar" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span class="pwd-strength__label" data-strength-label></span>
</div>
