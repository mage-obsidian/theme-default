{# Forgot-password page. Native POST to forgotPasswordPost (sends the reset email);
   forgot-enhancer.ts adds inline email validation only. `form_data` is the core
   Forgotpassword block (the controller seeds it with the persisted email). #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set forgot = block.getChildBlock('form_data') %}

<section class="shell">
    <div class="auth-split">
        <div class="auth-split__form">
            <div class="auth-split__inner">
                <p class="account-head__eyebrow">{{ __('Account') }}</p>
                <h1 class="mt-2 font-display text-3xl tracking-display text-ink">{{ __('Reset Your Password') }}</h1>
                <p class="mt-3 text-sm text-ink-soft">{{ __('Enter your email address and we will send you a link to reset your password.') }}</p>

                <form
                    action="{{ block.getUrl('customer/account/forgotpasswordpost')|escape_url }}"
                    method="post"
                    class="mt-8 flex flex-col gap-5"
                    data-forgot-form
    data-busy-submit
                    data-err-required="{{ __('This is a required field.') }}"
                    data-err-email="{{ __('Please enter a valid email address.') }}"
                >
                    {{ block.getBlockHtml('formkey')|raw }}

                    {{ form.field({
                        name: 'email',
                        id: 'forgot-email',
                        label: __('Email'),
                        type: 'email',
                        value: forgot.getEmailValue(),
                        required: true,
                        autocomplete: 'email',
                        attrs: { autocapitalize: 'off' }
                    }) }}

                    {{ form.required_note(__('Required fields')) }}

                    <div class="flex flex-wrap items-center gap-5">
                        <button type="submit" class="btn btn--solid">{{ __('Reset My Password') }}</button>
                        <a href="{{ block.getUrl('customer/account/login')|escape_url }}" class="link link--meta">{{ __('Back to Sign In') }}</a>
                    </div>
                </form>
            </div>
        </div>

        {% include 'Magento_Customer::form/auth-aside.twig' with {
            block: block,
            line: __('It happens. The link lands in a moment.'),
            items: [
                __('The link is good for a short while'),
                __('Nothing changes until you set a new one'),
                __('Your orders and addresses stay put')
            ]
        } only %}
    </div>
</section>

{{ script('MageObsidian_Customer::js/forgot-enhancer') }}
{{ script('MageObsidian_Storefront::js/form-busy') }}
