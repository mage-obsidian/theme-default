{# Forgot-password page. Native POST to forgotPasswordPost (sends the reset email);
   forgot-enhancer.ts adds inline email validation only. `form_data` is the core
   Forgotpassword block (the controller seeds it with the persisted email). #}
{% set forgot = block.getChildBlock('form_data') %}
<section class="mx-auto w-full max-w-md px-4 py-16">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Reset Your Password') }}</h1>
    <p class="mt-2 max-w-prose font-sans text-sm text-ink-soft">{{ __('Enter your email address and we will send you a link to reset your password.') }}</p>

    <form
        action="{{ block.getUrl('customer/account/forgotpasswordpost')|escape_url }}"
        method="post"
        class="mt-8 flex flex-col gap-5"
        data-forgot-form
        data-err-required="{{ __('This is a required field.')|escape_html_attr }}"
        data-err-email="{{ __('Please enter a valid email address.')|escape_html_attr }}"
    >
        {{ block.getBlockHtml('formkey')|raw }}

        <div class="flex flex-col gap-2">
            <label for="forgot-email" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Email') }}</label>
            <input type="email" id="forgot-email" name="email" value="{{ forgot.getEmailValue()|escape_html_attr }}" required autocomplete="email" autocapitalize="off" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
        </div>

        <div class="flex items-center gap-4">
            <button type="submit" class="h-11 flex-1 rounded-edge bg-ink font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Reset My Password') }}</button>
            <a href="{{ block.getUrl('customer/account/login')|escape_url }}" class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Back to Sign In') }}</a>
        </div>
    </form>
</section>

<script type="module" src="{{ vite_url('MageObsidian_Customer::js/forgot-enhancer') }}"></script>
