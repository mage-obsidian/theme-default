{# Reset-password page, reached from the emailed link. `form_data` is the core
   Magento\Customer\Block\Account\Resetpassword data source (reset token, customer
   id, configured min length). Native POST to resetPasswordPost; reset-enhancer.ts
   adds inline length/match validation only. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set reset = block.getChildBlock('form_data') %}

<section class="shell">
    <div class="auth-split">
        <div class="auth-split__form">
            <div class="auth-split__inner">
                <p class="account-head__eyebrow">{{ __('Account') }}</p>
                <h1 class="mt-2 font-display text-3xl tracking-display text-ink">{{ __('Set a New Password') }}</h1>

                <form
                    action="{{ reset.getUrl('customer/account/resetpasswordpost', {'_query': {'id': reset.getRpCustomerId(), 'token': reset.getResetPasswordLinkToken()}})|escape_url }}"
                    method="post"
                    class="mt-8 flex flex-col gap-5"
                    data-reset-form
                    data-pwd-show="{{ __('Show password')|escape_html_attr }}"
                    data-pwd-hide="{{ __('Hide password')|escape_html_attr }}"
    data-busy-submit
                    data-password-min-length="{{ reset.getMinimumPasswordLength()|escape_html_attr }}"
                    data-err-required="{{ __('This is a required field.') }}"
                    data-err-minlength="{{ __('Please use at least %1 characters.', reset.getMinimumPasswordLength()) }}"
                    data-err-match="{{ __('The two passwords do not match.') }}"
                >
                    {{ block.getBlockHtml('formkey')|raw }}

                    {{ form.field({
                        name: 'password',
                        id: 'reset-password',
                        label: __('New Password'),
                        type: 'password',
                        required: true,
                        autocomplete: 'new-password',
                        attrs: { minlength: reset.getMinimumPasswordLength() }
                    }) }}

                    {{ form.field({
                        name: 'password_confirmation',
                        id: 'reset-password-confirmation',
                        label: __('Confirm New Password'),
                        type: 'password',
                        required: true,
                        autocomplete: 'new-password'
                    }) }}

                    {{ form.required_note(__('Required fields')) }}

                    <button type="submit" class="btn btn--solid mt-1">{{ __('Set a New Password') }}</button>
                </form>
            </div>
        </div>

        {% include 'Magento_Customer::form/auth-aside.twig' with {
            block: block,
            line: __('Pick something you will actually remember.'),
            items: [
                __('At least %1 characters', reset.getMinimumPasswordLength()),
                __('This link works once'),
                __('You stay signed out until you use it')
            ]
        } only %}
    </div>
</section>

{{ script('MageObsidian_Customer::js/reset-enhancer') }}
{{ script('MageObsidian_Storefront::js/form-busy') }}
{{ script('MageObsidian_Storefront::js/password-toggle') }}
