{# Reset-password page, reached from the emailed link. `form_data` is the core
   Magento\Customer\Block\Account\Resetpassword data source (reset token, customer
   id, configured min length). Native POST to resetPasswordPost; reset-enhancer.ts
   adds inline length/match validation only. #}
{% set reset = block.getChildBlock('form_data') %}
<section class="mx-auto w-full max-w-md px-4 py-16">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Set a New Password') }}</h1>

    <form
        action="{{ reset.getUrl('customer/account/resetpasswordpost', {'_query': {'id': reset.getRpCustomerId(), 'token': reset.getResetPasswordLinkToken()}})|escape_url }}"
        method="post"
        class="mt-8 flex flex-col gap-5"
        data-reset-form
        data-password-min-length="{{ reset.getMinimumPasswordLength()|escape_html_attr }}"
        data-err-required="{{ __('This is a required field.')|escape_html_attr }}"
        data-err-minlength="{{ __('Please use at least %1 characters.', reset.getMinimumPasswordLength())|escape_html_attr }}"
        data-err-match="{{ __('The two passwords do not match.')|escape_html_attr }}"
    >
        {{ block.getBlockHtml('formkey')|raw }}

        <div class="flex flex-col gap-2">
            <label for="reset-password" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('New Password') }}</label>
            <input type="password" id="reset-password" name="password" required minlength="{{ reset.getMinimumPasswordLength()|escape_html_attr }}" autocomplete="new-password" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
        </div>

        <div class="flex flex-col gap-2">
            <label for="reset-password-confirmation" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Confirm New Password') }}</label>
            <input type="password" id="reset-password-confirmation" name="password_confirmation" required autocomplete="new-password" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
        </div>

        <button type="submit" class="mt-1 h-11 rounded-edge bg-ink font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Set a New Password') }}</button>
    </form>
</section>

<script type="module" src="{{ vite_url('MageObsidian_Customer::js/reset-enhancer') }}"></script>
