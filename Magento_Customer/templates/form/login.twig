{# Sign-in page. `block` is the MageObsidian Template wrapper; `form_data` is the
   core Magento\Customer\Block\Form\Login used only as a data source (post URL and
   the username persisted after a failed no-JS attempt). The form POSTs natively
   to loginPost; login-enhancer.ts adds inline validation and an AJAX sign-in. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set login = block.getChildBlock('form_data') %}

<section class="shell">
    <div class="auth-split">
        <div class="auth-split__form">
            <div class="auth-split__inner">
                <p class="account-head__eyebrow">{{ __('Account') }}</p>
                <h1 class="mt-2 font-display text-3xl tracking-display text-ink">{{ __('Sign In') }}</h1>

                <form
                    action="{{ login.getPostActionUrl()|escape_url }}"
                    method="post"
                    class="mt-8 flex flex-col gap-5"
                    data-login-form
                    data-pwd-show="{{ __('Show password')|escape_html_attr }}"
                    data-pwd-hide="{{ __('Hide password')|escape_html_attr }}"
                    data-ajax-login="{{ block.getUrl('customer/ajax/login')|escape_url }}"
                    data-redirect="{{ block.getUrl('customer/account')|escape_url }}"
                    data-err-required="{{ __('This is a required field.') }}"
                    data-err-email="{{ __('Please enter a valid email address.') }}"
                    data-err-failed="{{ __('We could not sign you in. Check your details and try again.') }}"
                >
                    {{ block.getBlockHtml('formkey')|raw }}

                    <p data-login-error role="alert" class="form-banner"></p>

                    {{ form.field({
                        name: 'login[username]',
                        id: 'login-email',
                        label: __('Email'),
                        type: 'email',
                        value: login.getUsername(),
                        required: true,
                        autocomplete: 'email',
                        attrs: { autocapitalize: 'off' }
                    }) }}

                    {{ form.field({
                        name: 'login[password]',
                        id: 'login-password',
                        label: __('Password'),
                        type: 'password',
                        required: true,
                        autocomplete: 'current-password'
                    }) }}

                    {# Remember-me (Magento_Persistent; the VM self-gates on the enable flags). #}
                    {% include 'Magento_Persistent::remember-me.twig' with { remember: block.getRemember() } only %}

                    <button type="submit" class="btn btn--solid mt-1">{{ __('Sign In') }}</button>

                    {{ form.required_note(__('Required fields')) }}

                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <a href="{{ login.getForgotPasswordUrl()|escape_url }}" class="link link--meta">{{ __('Forgot your password?') }}</a>
                        <a href="{{ block.getUrl('customer/account/create')|escape_url }}" class="link link--meta">{{ __('Create an account') }}</a>
                    </div>
                </form>
            </div>
        </div>

        {% include 'Magento_Customer::form/auth-aside.twig' with {
            block: block,
            line: __('Everything you have with us, waiting where you left it.'),
            items: [
                __('Every order and its documents'),
                __('Addresses ready at checkout'),
                __('A wish list that follows you')
            ]
        } only %}
    </div>
</section>

{{ script('MageObsidian_Customer::js/login-enhancer') }}
{{ script('MageObsidian_Storefront::js/password-toggle') }}
