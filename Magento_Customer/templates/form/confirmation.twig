{# Resend account-confirmation email. `block` is a MageObsidian Template (getUrl,
   formkey). Native POST to customer/account/confirmation — the controller resends
   the link. No JS (native email-input validation). #}
{% import 'Magento_Theme::macros/form.twig' as form %}

<section class="mx-auto w-full max-w-[1320px] px-4 md:px-8">
    <div class="auth-split">
        <div class="auth-split__form">
            <div class="auth-split__inner">
                <p class="account-head__eyebrow">{{ __('Account') }}</p>
                <h1 class="mt-2 font-display text-3xl tracking-[0.04em] text-ink">{{ __('Send confirmation link') }}</h1>
                <p class="mt-3 text-sm text-ink-soft">{{ __('Please enter your email below and we will send you the confirmation link.') }}</p>

                <form action="{{ block.getUrl('customer/account/confirmation')|escape_url }}" method="post" class="mt-8 flex flex-col gap-5">
                    {{ block.getBlockHtml('formkey')|raw }}

                    {{ form.field({
                        name: 'email',
                        id: 'email_address',
                        label: __('Email'),
                        type: 'email',
                        required: true,
                        autocomplete: 'email',
                        attrs: { autocapitalize: 'off' }
                    }) }}

                    {{ form.required_note(__('Required fields')) }}

                    <div class="flex flex-wrap items-center gap-5">
                        <button type="submit" class="btn btn--solid">{{ __('Send confirmation link') }}</button>
                        <a href="{{ block.getUrl('customer/account/login')|escape_url }}" class="link link--meta">{{ __('Back to Sign In') }}</a>
                    </div>
                </form>
            </div>
        </div>

        {% include 'Magento_Customer::form/auth-aside.twig' with {
            block: block,
            line: __('One click and the account is yours.'),
            items: [
                __('Check the spam folder if it is slow'),
                __('The link opens your account straight away'),
                __('Ask for another whenever you need it')
            ]
        } only %}
    </div>
</section>
