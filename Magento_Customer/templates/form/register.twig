{# Create-account page. `form_data` is the core Magento\Customer\Block\Form\Register
   data source (post URL and the values persisted after a failed attempt). Native
   POST to createPost (email confirmation / redirects unchanged); register-enhancer.ts
   adds inline validation only. Optional profile/address attributes are deferred to
   a later batch — this covers the default name/email/password registration. #}
{% set register = block.getChildBlock('form_data') %}
{% set fd = register.getFormData() %}
<section class="mx-auto w-full max-w-md px-4 py-16">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Create an Account') }}</h1>
    <p class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Join OBSIDIAN') }}</p>

    <form
        action="{{ register.getPostActionUrl()|escape_url }}"
        method="post"
        class="mt-8 flex flex-col gap-5"
        data-register-form
        data-password-min-length="8"
        data-err-required="{{ __('This is a required field.')|escape_html_attr }}"
        data-err-email="{{ __('Please enter a valid email address.')|escape_html_attr }}"
        data-err-minlength="{{ __('Please use at least 8 characters.')|escape_html_attr }}"
        data-err-match="{{ __('The two passwords do not match.')|escape_html_attr }}"
    >
        {{ block.getBlockHtml('formkey')|raw }}

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div class="flex flex-col gap-2">
                <label for="reg-firstname" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('First Name') }}</label>
                <input type="text" id="reg-firstname" name="firstname" value="{{ fd.getFirstname()|escape_html_attr }}" required autocomplete="given-name" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
            </div>
            <div class="flex flex-col gap-2">
                <label for="reg-lastname" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Last Name') }}</label>
                <input type="text" id="reg-lastname" name="lastname" value="{{ fd.getLastname()|escape_html_attr }}" required autocomplete="family-name" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
            </div>
        </div>

        <div class="flex flex-col gap-2">
            <label for="reg-email" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Email') }}</label>
            <input type="email" id="reg-email" name="email" value="{{ fd.getEmail()|escape_html_attr }}" required autocomplete="email" autocapitalize="off" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
        </div>

        <div class="flex flex-col gap-2">
            <label for="reg-password" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Password') }}</label>
            <input type="password" id="reg-password" name="password" required minlength="8" autocomplete="new-password" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
        </div>

        <div class="flex flex-col gap-2">
            <label for="reg-password-confirmation" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Confirm Password') }}</label>
            <input type="password" id="reg-password-confirmation" name="password_confirmation" required autocomplete="new-password" class="h-11 rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none">
        </div>

        <label class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.12em] text-ink-soft">
            <input type="checkbox" name="is_subscribed" value="1" class="h-4 w-4 rounded-edge border-ash-300 text-accent focus:ring-accent">
            {{ __('Sign up for our newsletter') }}
        </label>

        <button type="submit" class="mt-1 h-11 rounded-edge bg-ink font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Create an Account') }}</button>

        <p class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft">
            {{ __('Already have an account?') }}
            <a href="{{ block.getUrl('customer/account/login')|escape_url }}" class="underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Sign In') }}</a>
        </p>
    </form>
</section>

<script type="module" src="{{ vite_url('MageObsidian_Customer::js/register-enhancer') }}"></script>
