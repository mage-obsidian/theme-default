{# Create-account page. `form_data` is the core Magento\Customer\Block\Form\Register
   data source (post URL and the values persisted after a failed attempt). Native
   POST to createPost (email confirmation / redirects unchanged); register-enhancer.ts
   adds inline validation only. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set register = block.getChildBlock('form_data') %}
{% set checkoutContext = block.getCheckoutContext() %}
{% set fd = register.getFormData() %}
{% set attributes = block.getFormAttributes() %}
{% set policy = block.getPasswordPolicy() %}

<section class="shell">
    <div class="auth-split">
        <div class="auth-split__form">
            <div class="auth-split__inner">
                <p class="account-head__eyebrow">{{ __('Account') }}</p>
                <h1 class="mt-2 font-display text-3xl tracking-display text-ink">{{ __('Create an Account') }}</h1>

                <form
                    action="{{ register.getPostActionUrl()|escape_url }}"
                    method="post"
                    class="mt-8 flex flex-col gap-5"
                    data-register-form
                    data-pwd-show="{{ __('Show password')|escape_html_attr }}"
                    data-pwd-hide="{{ __('Hide password')|escape_html_attr }}"
    data-busy-submit
                    data-password-min-length="{{ policy.minLength() }}"
                    data-password-classes="{{ policy.requiredClasses() }}"
                    data-err-classes="{{ __('Use at least %1 of: lower case, upper case, digits and special characters.', policy.requiredClasses())|escape_html_attr }}"
                    data-err-required="{{ __('This is a required field.') }}"
                    data-err-email="{{ __('Please enter a valid email address.') }}"
                    data-err-minlength="{{ __('Please use at least %1 characters.', policy.minLength())|escape_html_attr }}"
                    data-err-match="{{ __('The two passwords do not match.') }}"
                >
                    {{ block.getBlockHtml('formkey')|raw }}
                    {% if checkoutContext.isActive() %}<input type="hidden" name="context" value="checkout">{% if checkoutContext.getReferer() %}<input type="hidden" name="referer" value="{{ checkoutContext.getReferer()|escape_html_attr }}">{% endif %}{% endif %}

                    {% include 'Magento_Customer::form/name-fields.twig' with { attributes: attributes, data: fd, idPrefix: 'reg' } only %}

                    {{ form.field({
                        name: 'email',
                        id: 'reg-email',
                        label: __('Email'),
                        type: 'email',
                        value: fd.getEmail(),
                        required: true,
                        autocomplete: 'email',
                        attrs: { autocapitalize: 'off' }
                    }) }}

                    {% include 'Magento_Customer::form/profile-extras.twig' with { attributes: attributes, data: fd, idPrefix: 'reg' } only %}

                    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                        {{ form.field({
                            name: 'password',
                            id: 'reg-password',
                            label: __('Password'),
                            type: 'password',
                            required: true,
                            autocomplete: 'new-password',
                            attrs: { minlength: policy.minLength() }
                        }) }}
                        {{ form.field({
                            name: 'password_confirmation',
                            id: 'reg-password-confirmation',
                            label: __('Confirm Password'),
                            type: 'password',
                            required: true,
                            autocomplete: 'new-password'
                        }) }}
                    </div>
                    {% include 'Magento_Customer::form/password-meter.twig' with { policy: policy } only %}

                    {% if register.isNewsletterEnabled() %}
                        {{ form.checkbox({
                            name: 'is_subscribed',
                            label: __('Sign up for our newsletter')
                        }) }}
                    {% endif %}

                    {# Remember-me (Magento_Persistent; the VM self-gates on the enable flags). #}
                    {% include 'Magento_Persistent::remember-me.twig' with { remember: block.getRemember() } only %}

                    {# The platform's challenges, when it asks for one. Both live inside the form so
                       a native POST carries their answer without JavaScript. #}
                    {{ child_html('captcha') }}
                    {{ child_html('recaptcha') }}

                    <button type="submit" class="btn btn--solid mt-1">{{ __('Create an Account') }}</button>

                    {# The customer's own decision about being assisted, when the store offers it. #}
                    {{ child_html('assistance') }}

                    {{ form.required_note(__('Required fields')) }}

                    <p class="text-sm text-ink-soft">
                        {{ __('Already have an account?') }}
                        <a href="{{ checkoutContext.urlTo('customer/account/login')|escape_url }}" class="link link--meta">{{ __('Sign In') }}</a>
                    </p>
                </form>
            </div>
        </div>

        {% include 'Magento_Customer::form/auth-aside.twig' with {
            block: block,
            line: __('One account, and checkout stops asking twice.'),
            items: [
                __('Your orders and their documents in one place'),
                __('Addresses saved for next time'),
                __('A wish list that survives the tab')
            ]
        } only %}
    </div>
</section>

{{ script('MageObsidian_Customer::js/register-enhancer') }}
{{ script('MageObsidian_Storefront::js/form-busy') }}
{{ script('MageObsidian_Storefront::js/password-toggle') }}
