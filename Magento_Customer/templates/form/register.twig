{# Create-account page. `form_data` is the core Magento\Customer\Block\Form\Register
   data source (post URL and the values persisted after a failed attempt). Native
   POST to createPost (email confirmation / redirects unchanged); register-enhancer.ts
   adds inline validation only. Optional profile/address attributes are deferred to
   a later batch — this covers the default name/email/password registration. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set register = block.getChildBlock('form_data') %}
{% set fd = register.getFormData() %}
<section class="mx-auto w-full max-w-md px-4 py-16">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Create an Account') }}</h1>
    <p class="mt-2 font-mono text-xs uppercase tracking-[0.14em] text-ink-soft">{{ __('Join OBSIDIAN') }}</p>

    <form
        action="{{ register.getPostActionUrl()|escape_url }}"
        method="post"
        class="mt-8 flex flex-col gap-5"
        data-register-form
        data-password-min-length="8"
        data-err-required="{{ __('This is a required field.') }}"
        data-err-email="{{ __('Please enter a valid email address.') }}"
        data-err-minlength="{{ __('Please use at least 8 characters.') }}"
        data-err-match="{{ __('The two passwords do not match.') }}"
    >
        {{ block.getBlockHtml('formkey')|raw }}

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            {{ form.field({
                name: 'firstname',
                id: 'reg-firstname',
                label: __('First Name'),
                value: fd.getFirstname(),
                required: true,
                autocomplete: 'given-name'
            }) }}
            {{ form.field({
                name: 'lastname',
                id: 'reg-lastname',
                label: __('Last Name'),
                value: fd.getLastname(),
                required: true,
                autocomplete: 'family-name'
            }) }}
        </div>

        {{ form.field({
            name: 'email',
            id: 'reg-email',
            label: __('Email'),
            type: 'email',
            value: fd.getEmail(),
            required: true,
            autocomplete: 'email',
            attrs: { autocapitalize: 'off' }
        }) }}

        {{ form.field({
            name: 'password',
            id: 'reg-password',
            label: __('Password'),
            type: 'password',
            required: true,
            autocomplete: 'new-password',
            attrs: { minlength: 8 }
        }) }}

        {{ form.field({
            name: 'password_confirmation',
            id: 'reg-password-confirmation',
            label: __('Confirm Password'),
            type: 'password',
            required: true,
            autocomplete: 'new-password'
        }) }}

        <label class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.12em] text-ink-soft">
            <input type="checkbox" name="is_subscribed" value="1" class="h-4 w-4 rounded-edge border-ash-300 text-accent focus:ring-accent">
            {{ __('Sign up for our newsletter') }}
        </label>

        {# Remember-me (Magento_Persistent; the VM self-gates on the enable flags). #}
        {% include 'Magento_Persistent::remember-me.twig' with { remember: block.getRemember() } only %}

        <button type="submit" class="mt-1 h-11 rounded-edge bg-ink font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Create an Account') }}</button>

        {{ form.required_note(__('Required fields')) }}

        <p class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft">
            {{ __('Already have an account?') }}
            <a href="{{ block.getUrl('customer/account/login')|escape_url }}" class="underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Sign In') }}</a>
        </p>
    </form>
</section>

<script type="module" src="{{ vite_url('MageObsidian_Customer::js/register-enhancer') }}"></script>
