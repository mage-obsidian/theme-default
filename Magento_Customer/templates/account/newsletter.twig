{# Newsletter subscriptions. `newsletter` is the core Customer\Newsletter block
   (current subscription state + save URL). Native POST to newsletter/manage/save;
   works without JS (a single checkbox). #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set newsletter = block.getChildBlock('newsletter') %}
{% set labelClass = 'font-mono text-xs uppercase tracking-[0.14em] text-ink-soft' %}

<h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Newsletter Subscriptions') }}</h1>

<form action="{{ newsletter.getAction()|escape_url }}" method="post" class="mt-8 flex max-w-lg flex-col gap-6">
    {{ block.getBlockHtml('formkey')|raw }}
    {{ form.checkbox({
        name: 'is_subscribed',
        id: 'subscription',
        label: __('General Subscription'),
        checked: newsletter.getIsSubscribed()
    }) }}
    <div class="flex items-center gap-4">
        <button type="submit" class="btn btn--solid">{{ __('Save') }}</button>
        <a href="{{ block.getUrl('customer/account')|escape_url }}" class="{{ labelClass }} link">{{ __('Back') }}</a>
    </div>
</form>
