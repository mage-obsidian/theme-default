{# Address book. `book` is the core Address\Book block (default addresses),
   `grid` is Address\Grid (additional entries). Delete is a native POST form
   (form key + id); the data-confirm-* attributes are the contract of
   MageObsidian_Storefront::js/confirm-action, which asks before it goes through
   and does nothing at all without JS. #}
{% import 'Magento_Theme::macros/account.twig' as account %}

{% set book = block.getChildBlock('book') %}
{% set grid = block.getChildBlock('grid') %}
{% set defaultBilling = book.getDefaultBilling() %}
{% set defaultShipping = book.getDefaultShipping() %}
{% set additional = grid.getAdditionalAddresses() %}

{% set addAction %}<a href="{{ grid.getAddAddressUrl()|escape_url }}" class="btn btn--solid">{{ __('Add New Address') }}</a>{% endset %}
{{ account.page_header({
    eyebrow: __('Account'),
    title: __('Address Book'),
    action: addAction
}) }}

{# No empty state here: the core Address\Index controller redirects a customer with
   no addresses at all straight to the "add address" form. #}
<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {% set billingBody %}
        {% if defaultBilling %}
            <address class="address-lines">{{ book.getAddressHtml(book.getAddressById(defaultBilling))|raw }}</address>
            <a href="{{ book.getAddressEditUrl(defaultBilling)|escape_url }}" class="link link--meta mt-4 inline-block">{{ __('Change Billing Address') }}</a>
        {% else %}
            <p class="text-sm text-ink-soft">{{ __('You have no default billing address in your address book.') }}</p>
        {% endif %}
    {% endset %}
    {{ account.panel({ title: __('Default Billing Address'), content: billingBody }) }}

    {% set shippingBody %}
        {% if defaultShipping %}
            <address class="address-lines">{{ book.getAddressHtml(book.getAddressById(defaultShipping))|raw }}</address>
            <a href="{{ book.getAddressEditUrl(defaultShipping)|escape_url }}" class="link link--meta mt-4 inline-block">{{ __('Change Shipping Address') }}</a>
        {% else %}
            <p class="text-sm text-ink-soft">{{ __('You have no default shipping address in your address book.') }}</p>
        {% endif %}
    {% endset %}
    {{ account.panel({ title: __('Default Shipping Address'), content: shippingBody }) }}
</div>

<section class="mt-10">
    <h2 class="account-panel__title">{{ __('Additional Address Entries') }}</h2>
    {% if additional is not empty %}
        <ul class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {% for address in additional %}
                <li class="address-card">
                    <address class="address-card__body">
                        <span class="address-card__name">{{ address.getFirstname() }} {{ address.getLastname() }}</span>
                        {{ grid.getStreetAddress(address) }}<br>
                        {{ address.getCity() }}, {{ address.getRegion().getRegion() }} {{ address.getPostcode() }}<br>
                        {{ grid.getCountryByCode(address.getCountryId()) }}<br>
                        {{ address.getTelephone() }}
                    </address>
                    <div class="address-card__actions">
                        <a href="{{ grid.getAddressEditUrl(address.getId())|escape_url }}" class="link link--meta">{{ __('Edit') }}</a>
                        <form
                            action="{{ block.getUrl('customer/address/delete')|escape_url }}"
                            method="post"
                            class="inline"
                            data-confirm-title="{{ __('Delete this address?')|escape_html_attr }}"
                            data-confirm-body="{{ __('It will be removed from your address book. Orders already placed keep the address they were shipped to.')|escape_html_attr }}"
                            data-confirm-ok="{{ __('Delete')|escape_html_attr }}"
                            data-confirm-cancel="{{ __('Keep it')|escape_html_attr }}"
                            data-busy-submit
                        >
                            {{ block.getBlockHtml('formkey')|raw }}
                            <input type="hidden" name="id" value="{{ address.getId()|escape_html_attr }}">
                            <button type="submit" class="link link--meta">{{ __('Delete') }}</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="mt-3 text-sm text-ink-soft">{{ __('You have no other address entries in your address book.') }}</p>
    {% endif %}
</section>

{{ script('MageObsidian_Storefront::js/confirm-action') }}
{{ script('MageObsidian_Storefront::js/form-busy') }}
