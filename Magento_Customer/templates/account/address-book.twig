{# Address book. `book` is the core Address\Book block (default addresses),
   `grid` is Address\Grid (additional entries). Delete is a native POST form
   (form key + id); address-book-enhancer.ts adds a confirm dialog. #}
{% set book = block.getChildBlock('book') %}
{% set grid = block.getChildBlock('grid') %}
{% set defaultBilling = book.getDefaultBilling() %}
{% set defaultShipping = book.getDefaultShipping() %}
{% set additional = grid.getAdditionalAddresses() %}
{% set boxClass = 'rounded-edge border border-ash-200 p-6' %}
{% set titleClass = 'font-mono text-xs uppercase tracking-[0.16em] text-ink-soft' %}
{% set editLinkClass = 'font-mono text-xs uppercase tracking-[0.12em] text-accent underline-offset-4 transition-colors hover:underline' %}

<div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Address Book') }}</h1>
    <a href="{{ grid.getAddAddressUrl()|escape_url }}" class="h-11 rounded-edge bg-ink px-6 font-mono text-xs uppercase leading-[2.75rem] tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Add New Address') }}</a>
</div>

<section class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2">
    <div class="{{ boxClass }}">
        <h2 class="{{ titleClass }}">{{ __('Default Billing Address') }}</h2>
        {% if defaultBilling %}
            <address class="mt-3 text-sm not-italic leading-relaxed text-ink-soft">{{ book.getAddressHtml(book.getAddressById(defaultBilling))|raw }}</address>
            <a href="{{ book.getAddressEditUrl(defaultBilling)|escape_url }}" class="mt-4 inline-block {{ editLinkClass }}">{{ __('Change Billing Address') }}</a>
        {% else %}
            <p class="mt-3 text-sm text-ink-soft">{{ __('You have no default billing address in your address book.') }}</p>
        {% endif %}
    </div>
    <div class="{{ boxClass }}">
        <h2 class="{{ titleClass }}">{{ __('Default Shipping Address') }}</h2>
        {% if defaultShipping %}
            <address class="mt-3 text-sm not-italic leading-relaxed text-ink-soft">{{ book.getAddressHtml(book.getAddressById(defaultShipping))|raw }}</address>
            <a href="{{ book.getAddressEditUrl(defaultShipping)|escape_url }}" class="mt-4 inline-block {{ editLinkClass }}">{{ __('Change Shipping Address') }}</a>
        {% else %}
            <p class="mt-3 text-sm text-ink-soft">{{ __('You have no default shipping address in your address book.') }}</p>
        {% endif %}
    </div>
</section>

<section class="mt-12" data-address-book>
    <h2 class="font-display text-2xl tracking-[0.06em] text-ink">{{ __('Additional Address Entries') }}</h2>
    {% if additional is not empty %}
        <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {% for address in additional %}
                <li class="{{ boxClass }} flex flex-col gap-3">
                    <address class="text-sm not-italic leading-relaxed text-ink">
                        <span class="block text-ink">{{ address.getFirstname()}} {{ address.getLastname()}}</span>
                        {{ grid.getStreetAddress(address)}}<br>
                        {{ address.getCity()}}, {{ address.getRegion().getRegion()}} {{ address.getPostcode()}}<br>
                        {{ grid.getCountryByCode(address.getCountryId())}}<br>
                        {{ address.getTelephone()}}
                    </address>
                    <div class="mt-auto flex items-center gap-5 pt-2">
                        <a href="{{ grid.getAddressEditUrl(address.getId())|escape_url }}" class="{{ editLinkClass }}">{{ __('Edit') }}</a>
                        <form action="{{ block.getUrl('customer/address/delete')|escape_url }}" method="post" data-delete-address class="inline">
                            {{ block.getBlockHtml('formkey')|raw }}
                            <input type="hidden" name="id" value="{{ address.getId()|escape_html_attr }}">
                            <button type="submit" data-confirm="{{ __('Are you sure you want to delete this address?')|escape_html_attr }}" class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Delete') }}</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="mt-4 text-sm text-ink-soft">{{ __('You have no other address entries in your address book.') }}</p>
    {% endif %}
</section>

<script type="module" src="{{ vite_url('MageObsidian_Customer::js/address-book-enhancer') }}"></script>
