{# Account dashboard. `info` and `address` are the core Dashboard\Info /
   Dashboard\Address blocks used as data sources; `account_nav` is the same
   ViewModel the rail uses — the metric tiles ARE its counters, so a module that
   contributes a counted entry gets a tile for free. #}
{% import 'Magento_Theme::macros/account.twig' as account %}

{% set info = block.getChildBlock('info') %}
{% set address = block.getChildBlock('address') %}
{% set summary = block.getAccountSummary() %}
{% set counted = block.getAccountNav().getLinks()|filter(link => link.count is not null) %}

{{ account.page_header({
    eyebrow: __('Account'),
    title: __('Hello, %1', summary.getFirstName() ?: summary.getName()),
    lead: __('Everything you have with us — orders, addresses and preferences — in one place.')
}) }}

<div class="account-stats mt-8">
    {% for link in counted %}
        {{ account.stat({ value: link.count, label: link.label }) }}
    {% endfor %}
    {{ account.stat({ value: summary.getAddressCount(), label: __('Addresses') }) }}
    {% if summary.getMemberSinceYear() %}
        {{ account.stat({ value: summary.getMemberSinceYear(), label: __('Member Since') }) }}
    {% endif %}
</div>

{# Extension slot: Magento_Sales' latest order + recent list. #}
{{ child_html('recent_orders')|raw }}

<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
    {% set contact %}
        <p class="text-sm text-ink">{{ info.getName() }}</p>
        <p class="text-sm text-ink-soft">{{ info.getCustomer().getEmail() }}</p>
        <div class="mt-5 flex flex-wrap gap-5">
            <a href="{{ block.getUrl('customer/account/edit')|escape_url }}" class="link link--meta">{{ __('Edit') }}</a>
            <a href="{{ info.getChangePasswordUrl()|escape_url }}" class="link link--meta">{{ __('Change Password') }}</a>
        </div>
    {% endset %}
    {{ account.panel({ title: __('Contact Information'), content: contact }) }}

    {% set addresses %}
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
                <h3 class="account-stat__label">{{ __('Billing') }}</h3>
                <div class="mt-2 text-sm leading-relaxed text-ink-soft">{{ address.getPrimaryBillingAddressHtml()|raw }}</div>
            </div>
            <div>
                <h3 class="account-stat__label">{{ __('Shipping') }}</h3>
                <div class="mt-2 text-sm leading-relaxed text-ink-soft">{{ address.getPrimaryShippingAddressHtml()|raw }}</div>
            </div>
        </div>
    {% endset %}
    {% set manage %}<a href="{{ block.getUrl('customer/address')|escape_url }}" class="link link--meta">{{ __('Manage') }}</a>{% endset %}
    {{ account.panel({ title: __('Default Addresses'), action: manage, content: addresses }) }}
</div>

{# Extension slot: modules add their own dashboard sections here. #}
{{ child_html('recent_reviews')|raw }}

{% set shortcuts %}
    <div class="flex flex-wrap gap-3">
        <a href="{{ block.getUrl('customer/address/new')|escape_url }}" class="btn btn--outline btn--sm">{{ __('Add an Address') }}</a>
        <a href="{{ block.getUrl('customer/account/edit')|escape_url }}" class="btn btn--outline btn--sm">{{ __('Account Information') }}</a>
        <a href="{{ block.getUrl('newsletter/manage')|escape_url }}" class="btn btn--outline btn--sm">{{ __('Newsletter') }}</a>
        <a href="{{ block.getUrl('wishlist')|escape_url }}" class="btn btn--outline btn--sm">{{ __('Wish List') }}</a>
    </div>
{% endset %}
<div class="mt-8">
    {{ account.panel({ title: __('Shortcuts'), content: shortcuts }) }}
</div>
