{# Add / edit address. `edit` is the core Address\Edit block (saved address, URLs,
   region JSON, default flags). `address_form` (AddressForm ViewModel) supplies
   country/region option lists. The region select is rendered server-side for the
   current country so the form works without JS; address-form-enhancer.ts swaps
   regions when the country changes. Native POST to the save URL. #}
{% import 'Magento_Theme::macros/account.twig' as account %}
{% import 'Magento_Theme::macros/form.twig' as form %}

{% set edit = block.getChildBlock('edit') %}
{% set addressForm = block.getAddressForm() %}
{% set attributes = block.getFormAttributes() %}
{% set prefixRule = attributes.addressField('prefix') %}
{% set middlenameRule = attributes.addressField('middlename') %}
{% set suffixRule = attributes.addressField('suffix') %}
{% set companyRule = attributes.addressField('company') %}
{% set telephoneRule = attributes.addressField('telephone') %}
{% set faxRule = attributes.addressField('fax') %}
{% set vatRule = attributes.addressField('vat_id') %}
{% set optionalZip = attributes.optionalZipCountries() %}
{% set addr = edit.getAddress() %}
{% set currentCountry = edit.getCountryId() ?: addressForm.getDefaultCountryId() %}
{% set regionOptions = addressForm.getRegionOptions(currentCountry) %}
{% set hasRegions = regionOptions is not empty %}
{% set regionId = edit.getRegionId() %}
{% set streetLines = attributes.streetLines() %}

{{ account.page_header({
    eyebrow: __('Address Book'),
    title: edit.getTitle()
}) }}

<form
    action="{{ edit.getSaveUrl()|escape_url }}"
    method="post"
    class="mt-8 flex max-w-2xl flex-col gap-6"
    data-address-form
    data-busy-submit
    data-optional-zip="{{ optionalZip|json_encode|escape_html_attr }}"
    data-err-required="{{ __('This is a required field.')|escape_html_attr }}"
>
    {# Region data for the dependent select. Carried in a JSON script (not an
       attribute) so the braces/quotes survive the engine's HTML autoescape. #}
    <script type="application/json" data-region-json>{{ edit.getRegionProvider().getRegionJson()|raw }}</script>
    {{ block.getBlockHtml('formkey')|raw }}
    {# Return URLs seeded by the controller (e.g. multishipping sets these so the
       save returns into its flow); without them formPost falls back to the
       address book. #}
    <input type="hidden" name="success_url" value="{{ edit.getSuccessUrl()|escape_url }}">
    <input type="hidden" name="error_url" value="{{ edit.getErrorUrl()|escape_url }}">

    <section class="account-panel">
        <div class="account-panel__head">
            <h2 class="account-panel__title">{{ __('Contact') }}</h2>
        </div>
        <div class="account-panel__body flex flex-col gap-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                {% if prefixRule.visible %}
                    {{ form.text_or_list({
                        name: 'prefix',
                        id: 'addr-prefix',
                        label: __('Prefix'),
                        value: addr.getPrefix(),
                        options: prefixRule.options,
                        required: prefixRule.required,
                        autocomplete: 'honorific-prefix'
                    }) }}
                {% endif %}
                {{ form.field({
                    name: 'firstname',
                    id: 'addr-firstname',
                    label: __('First Name'),
                    value: addr.getFirstname(),
                    required: true,
                    autocomplete: 'given-name'
                }) }}
                {% if middlenameRule.visible %}
                    {{ form.field({
                        name: 'middlename',
                        id: 'addr-middlename',
                        label: __('Middle Name/Initial'),
                        value: addr.getMiddlename(),
                        required: middlenameRule.required,
                        autocomplete: 'additional-name'
                    }) }}
                {% endif %}
                {{ form.field({
                    name: 'lastname',
                    id: 'addr-lastname',
                    label: __('Last Name'),
                    value: addr.getLastname(),
                    required: true,
                    autocomplete: 'family-name'
                }) }}
                {% if suffixRule.visible %}
                    {{ form.text_or_list({
                        name: 'suffix',
                        id: 'addr-suffix',
                        label: __('Suffix'),
                        value: addr.getSuffix(),
                        options: suffixRule.options,
                        required: suffixRule.required,
                        autocomplete: 'honorific-suffix'
                    }) }}
                {% endif %}
            </div>
            {% if companyRule.visible or telephoneRule.visible %}
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    {% if companyRule.visible %}
                        {{ form.field({
                            name: 'company',
                            id: 'addr-company',
                            label: __('Company'),
                            value: addr.getCompany(),
                            required: companyRule.required,
                            autocomplete: 'organization'
                        }) }}
                    {% endif %}
                    {% if telephoneRule.visible %}
                        {{ form.field({
                            name: 'telephone',
                            id: 'addr-telephone',
                            label: __('Phone Number'),
                            type: 'tel',
                            value: addr.getTelephone(),
                            required: telephoneRule.required,
                            autocomplete: 'tel'
                        }) }}
                    {% endif %}
                </div>
            {% endif %}
            {% if faxRule.visible or vatRule.visible %}
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                    {% if faxRule.visible %}
                        {{ form.field({
                            name: 'fax',
                            id: 'addr-fax',
                            label: __('Fax'),
                            type: 'tel',
                            value: addr.getFax(),
                            required: faxRule.required,
                            autocomplete: 'fax'
                        }) }}
                    {% endif %}
                    {% if vatRule.visible %}
                        {{ form.field({
                            name: 'vat_id',
                            id: 'addr-vat-id',
                            label: __('VAT Number'),
                            value: addr.getVatId(),
                            required: vatRule.required
                        }) }}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </section>

    <section class="account-panel">
        <div class="account-panel__head">
            <h2 class="account-panel__title">{{ __('Address') }}</h2>
        </div>
        <div class="account-panel__body flex flex-col gap-5">
            {# Multi-line street: one label over N controls, so it is assembled by
               hand from the same `.field*` classes the macro emits. #}
            <div class="field">
                <label for="street_1" class="field__label">{{ __('Street Address') }}<span class="field__required" aria-hidden="true">*</span></label>
                <input type="text" id="street_1" name="street[0]" value="{{ edit.getStreetLine(1)|escape_html_attr }}" required aria-required="true" autocomplete="address-line1" aria-describedby="street_1-error" class="field__control">
                {% if streetLines > 1 %}
                    {% for i in 1..(streetLines - 1) %}
                        <input type="text" name="street[{{ i }}]" value="{{ edit.getStreetLine(i + 1)|escape_html_attr }}" autocomplete="address-line{{ i + 1 }}" aria-label="{{ __('Street Address: Line %1', i + 1)|escape_html_attr }}" class="field__control">
                    {% endfor %}
                {% endif %}
                <p class="field__error" id="street_1-error" role="alert"></p>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div class="field">
                    <label for="country" class="field__label">{{ __('Country') }}<span class="field__required" aria-hidden="true">*</span></label>
                    <select id="country" name="country_id" required aria-required="true" autocomplete="country" data-country aria-describedby="country-error" class="field__control">
                        {% for option in addressForm.getCountryOptions() %}
                            <option value="{{ option.value|escape_html_attr }}"{{ option.value == currentCountry ? ' selected' : '' }}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                    <p class="field__error" id="country-error" role="alert"></p>
                </div>
                {# Region is a select or a free-text input depending on the country,
                   and the enhancer swaps them; one label covers whichever is live. #}
                <div class="field" data-region-field>
                    <label for="region_id" class="field__label">{{ __('State/Province') }}</label>
                    <select id="region_id" name="region_id" data-region-select{{ hasRegions ? '' : ' disabled' }} aria-describedby="region_id-error" class="field__control{{ hasRegions ? '' : ' hidden' }}">
                        <option value="">{{ __('Please select a region, state or province.') }}</option>
                        {% for option in regionOptions %}
                            <option value="{{ option.value|escape_html_attr }}"{{ option.value == regionId ? ' selected' : '' }}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                    <input type="text" id="region" name="region" value="{{ edit.getRegion()|escape_html_attr }}" data-region-input autocomplete="address-level1"{{ hasRegions ? ' disabled' : '' }} aria-describedby="region-error" class="field__control{{ hasRegions ? ' hidden' : '' }}">
                    <p class="field__error" id="region_id-error" role="alert"></p>
                    <p class="field__error" id="region-error" role="alert"></p>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                {{ form.field({
                    name: 'city',
                    id: 'city',
                    label: __('City'),
                    value: addr.getCity(),
                    required: true,
                    autocomplete: 'address-level2'
                }) }}
                {{ form.field({
                    name: 'postcode',
                    id: 'zip',
                    label: __('Zip/Postal Code'),
                    value: addr.getPostcode(),
                    required: currentCountry not in optionalZip,
                    autocomplete: 'postal-code',
                    attrs: { 'data-postcode': '' }
                }) }}
            </div>
        </div>
    </section>

    {# The very first address is silently made the default for both, so there is
       nothing to ask and no panel to draw — only the two hidden inputs. #}
    {% set billingChoice = edit.isDefaultBilling() or edit.canSetAsDefaultBilling() %}
    {% set shippingChoice = edit.isDefaultShipping() or edit.canSetAsDefaultShipping() %}

    {% if billingChoice or shippingChoice %}
        <section class="account-panel">
            <div class="account-panel__head">
                <h2 class="account-panel__title">{{ __('Defaults') }}</h2>
            </div>
            <div class="account-panel__body flex flex-col items-start gap-4">
                {% if edit.isDefaultBilling() %}
                    {{ account.chip(__('Default billing address'), 'good') }}
                {% elseif edit.canSetAsDefaultBilling() %}
                    {{ form.checkbox({
                        name: 'default_billing',
                        label: __('Use as my default billing address')
                    }) }}
                {% endif %}

                {% if edit.isDefaultShipping() %}
                    {{ account.chip(__('Default shipping address'), 'good') }}
                {% elseif edit.canSetAsDefaultShipping() %}
                    {{ form.checkbox({
                        name: 'default_shipping',
                        label: __('Use as my default shipping address')
                    }) }}
                {% endif %}
            </div>
        </section>
    {% endif %}

    {% if not billingChoice %}<input type="hidden" name="default_billing" value="1">{% endif %}
    {% if not shippingChoice %}<input type="hidden" name="default_shipping" value="1">{% endif %}

    {{ form.required_note(__('Required fields')) }}

    <div class="flex items-center gap-5">
        <button type="submit" class="btn btn--solid">{{ __('Save Address') }}</button>
        <a href="{{ edit.getBackUrl()|escape_url }}" class="link link--meta">{{ __('Cancel') }}</a>
    </div>
</form>

{{ script('MageObsidian_Customer::js/address-form-enhancer') }}
{{ script('MageObsidian_Storefront::js/form-busy') }}
