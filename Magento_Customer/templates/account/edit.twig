{# Edit account information. `form_data` is the core Form\Edit block (post data,
   min length). Native POST to editPost; edit-enhancer.ts toggles the email /
   password fieldsets and validates conditionally. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set edit = block.getChildBlock('form_data') %}
{% set cust = edit.getCustomer() %}
{% set labelClass = 'font-mono text-xs uppercase tracking-[0.14em] text-ink-soft' %}
<h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Account Information') }}</h1>

<form
    action="{{ block.getUrl('customer/account/editPost')|escape_url }}"
    method="post"
    class="mt-8 flex max-w-lg flex-col gap-5"
    data-edit-form
    data-password-min-length="{{ edit.getMinimumPasswordLength()|escape_html_attr }}"
    data-err-required="{{ __('This is a required field.')|escape_html_attr }}"
    data-err-email="{{ __('Please enter a valid email address.')|escape_html_attr }}"
    data-err-minlength="{{ __('Please use at least %1 characters.', edit.getMinimumPasswordLength())|escape_html_attr }}"
    data-err-match="{{ __('The two passwords do not match.')|escape_html_attr }}"
>
    {{ block.getBlockHtml('formkey')|raw }}

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {{ form.field({
            name: 'firstname',
            id: 'edit-firstname',
            label: __('First Name'),
            value: cust.getFirstname(),
            required: true,
            autocomplete: 'given-name'
        }) }}
        {{ form.field({
            name: 'lastname',
            id: 'edit-lastname',
            label: __('Last Name'),
            value: cust.getLastname(),
            required: true,
            autocomplete: 'family-name'
        }) }}
    </div>

    <label class="flex items-center gap-3 {{ labelClass }}">
        <input type="checkbox" name="change_email" value="1" class="h-4 w-4 rounded-edge border-ash-300 text-accent focus:ring-accent">
        {{ __('Change Email') }}
    </label>
    <div data-email-fields>
        {{ form.field({
            name: 'email',
            id: 'edit-email',
            label: __('Email'),
            type: 'email',
            value: cust.getEmail(),
            autocomplete: 'email',
            attrs: { autocapitalize: 'off' }
        }) }}
    </div>

    <label class="flex items-center gap-3 {{ labelClass }}">
        <input type="checkbox" name="change_password" value="1" class="h-4 w-4 rounded-edge border-ash-300 text-accent focus:ring-accent">
        {{ __('Change Password') }}
    </label>
    <div data-current-password-fields>
        {{ form.field({
            name: 'current_password',
            id: 'edit-current-password',
            label: __('Current Password'),
            type: 'password',
            autocomplete: 'current-password'
        }) }}
    </div>
    <div data-password-fields class="flex flex-col gap-5">
        {{ form.field({
            name: 'password',
            id: 'edit-password',
            label: __('New Password'),
            type: 'password',
            autocomplete: 'new-password'
        }) }}
        {{ form.field({
            name: 'password_confirmation',
            id: 'edit-password-confirmation',
            label: __('Confirm New Password'),
            type: 'password',
            autocomplete: 'new-password'
        }) }}
    </div>

    {{ form.required_note(__('Required fields')) }}

    <div class="flex items-center gap-4">
        <button type="submit" class="h-11 rounded-edge bg-ink px-6 font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Save') }}</button>
        <a href="{{ block.getUrl('customer/account')|escape_url }}" class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Back') }}</a>
    </div>
</form>

<script type="module" src="{{ vite_url('MageObsidian_Customer::js/edit-enhancer') }}"></script>
