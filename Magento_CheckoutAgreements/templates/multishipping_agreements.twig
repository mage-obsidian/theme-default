{% set agreements = block.getAgreements() %}
{% if agreements %}
    <ol id="checkout-agreements" class="mb-6 flex flex-col gap-6">
        {% for agreement in agreements %}
            {% set agreementId = agreement.getAgreementId() %}
            <li class="flex flex-col gap-3">
                <div id="agreement-content-{{ agreementId }}" class="max-h-40 overflow-y-auto rounded-edge border border-ash-200 p-4 text-sm text-ink-soft">
                    {% if agreement.getIsHtml() %}{{ agreement.getContent()|raw }}{% else %}{{ agreement.getContent()|nl2br }}{% endif %}
                </div>
                {% if agreement.getMode() == constant('Magento\\CheckoutAgreements\\Model\\AgreementModeOptions::MODE_MANUAL') %}
                    <label class="field-check" for="agreement-{{ agreementId }}">
                        <input class="field-check__input" type="checkbox" id="agreement-{{ agreementId }}" name="agreement[{{ agreementId }}]" value="1" required="required">
                        <span class="field-check__label">{% if agreement.getIsHtml() %}{{ agreement.getCheckboxText()|raw }}{% else %}{{ agreement.getCheckboxText() }}{% endif %}</span>
                    </label>
                {% else %}
                    <p id="agreement-notice-{{ agreementId }}" class="text-sm text-ink">
                        {% if agreement.getIsHtml() %}{{ agreement.getCheckboxText()|raw }}{% else %}{{ agreement.getCheckboxText() }}{% endif %}
                    </p>
                {% endif %}
            </li>
        {% endfor %}
    </ol>
{% endif %}
