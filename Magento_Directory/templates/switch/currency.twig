{#
  Currency switcher (desktop header). Renders only when more than one currency
  is allowed. Data comes from the CurrencySwitcher ViewModel (block argument
  `switcher`).
#}
{% if block.getSwitcher().hasMultiple() %}
    {% include 'Magento_Theme::html/header/switcher.twig' with {
        switcher: block.getSwitcher(),
        srLabel: __('Change currency')
    } %}
{% endif %}
