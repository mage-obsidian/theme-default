{#
  Reusable Twig macros for the OBSIDIAN theme. Imported with
  `{% from 'Magento_Theme::macros/ui.twig' import nav_list %}`. Macros are the
  Twig way to share presentational fragments without a block/layout round-trip;
  a child theme can override this file through the normal theme fallback.
#}

{#
  Renders a flat list of nav anchors from Navigation ViewModel items
  ({label, url, active}). The caller supplies the wrapper (<nav>/<ul>) and the
  link classes, so the same macro serves the header bar and the footer column.
#}
{% macro nav_list(items, link_class = '') %}
    {% for item in items %}
        <a href="{{ item.url|escape_url }}"
           class="{{ link_class }}"
           {%- if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {% endfor %}
{% endmacro %}
