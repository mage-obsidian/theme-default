{# The markup here and Field.vue must stay identical or hydration breaks. #}

{% macro field(config) %}
    {% set name = config.name %}
    {% set id = config.id ?? ('field-' ~ name|replace({'[': '-', ']': '', '_': '-', '.': '-'})|trim('-')) %}
    {% set type = config.type ?? 'text' %}
    {% set required = config.required ?? false %}
    {% set describedBy = [
        config.hint is defined and config.hint ? id ~ '-hint' : null,
        id ~ '-error'
    ]|filter(v => v)|join(' ') %}

    <div class="field">
        <label class="field__label" for="{{ id }}">
            {{- config.label -}}
            {%- if required %}<span class="field__required" aria-hidden="true">*</span>{% endif -%}
        </label>

        {%- if type == 'textarea' -%}
            <textarea
                    class="field__control"
                    id="{{ id }}"
                    name="{{ name }}"
                    {% if required %}required aria-required="true"{% endif %}
                    {% if config.autocomplete is defined %}autocomplete="{{ config.autocomplete|escape_html_attr }}"{% endif %}
                    aria-describedby="{{ describedBy }}"
                    {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
            >{{ config.value|default('') }}</textarea>
        {%- elseif type == 'select' -%}
            <select
                    class="field__control"
                    id="{{ id }}"
                    name="{{ name }}"
                    {% if required %}required aria-required="true"{% endif %}
                    {% if config.autocomplete is defined %}autocomplete="{{ config.autocomplete|escape_html_attr }}"{% endif %}
                    aria-describedby="{{ describedBy }}"
                    {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
            >
                {% for option in config.options|default([]) %}
                    <option value="{{ option.value|escape_html_attr }}"{% if option.value == config.value|default('') %} selected{% endif %}>{{ option.label }}</option>
                {% endfor %}
            </select>
        {%- else -%}
            <input
                    class="field__control"
                    type="{{ type }}"
                    id="{{ id }}"
                    name="{{ name }}"
                    value="{{ config.value|default('')|escape_html_attr }}"
                    {% if required %}required aria-required="true"{% endif %}
                    {% if config.autocomplete is defined %}autocomplete="{{ config.autocomplete|escape_html_attr }}"{% endif %}
                    aria-describedby="{{ describedBy }}"
                    {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
            >
        {%- endif -%}

        {% if config.hint is defined and config.hint %}
            <p class="field__hint" id="{{ id }}-hint">{{ config.hint }}</p>
        {% endif %}

        {# Rendered even when empty: the enhancer fills it instead of injecting one. #}
        <p class="field__error" id="{{ id }}-error" role="alert">{{ config.error|default('') }}</p>
    </div>
{% endmacro %}

{% macro checkbox(config) %}
    {% set name = config.name %}
    {% set id = config.id ?? ('field-' ~ name|replace({'[': '-', ']': '', '_': '-', '.': '-'})|trim('-')) %}

    <label class="field-check" for="{{ id }}">
        <input
                class="field-check__input"
                type="checkbox"
                id="{{ id }}"
                name="{{ name }}"
                value="{{ config.value|default('1')|escape_html_attr }}"
                {% if config.checked|default(false) %}checked{% endif %}
                {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
        >
        <span class="field-check__label">{{ config.label }}</span>
    </label>
{% endmacro %}

{% macro radio(config) %}
    {% set name = config.name %}
    {% set id = config.id ?? ('field-' ~ (name ~ '-' ~ config.value)|replace({'[': '-', ']': '', '_': '-', '.': '-'})|trim('-')) %}

    <label class="field-radio" for="{{ id }}">
        <input
                class="field-radio__input"
                type="radio"
                id="{{ id }}"
                name="{{ name }}"
                value="{{ config.value|default('')|escape_html_attr }}"
                {% if config.checked|default(false) %}checked{% endif %}
                {% if config.required|default(false) %}required{% endif %}
                {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
        >
        <span class="field-radio__label">{{ config.label }}</span>
    </label>
{% endmacro %}

{% macro required_note(label) %}
    <p class="field-note"><span class="field-note__marker">*</span> {{ label }}</p>
{% endmacro %}

{# Buy-box quantity. The four PDP forms (simple, downloadable, bundle,
   configurable) render the same control; the configurable one is driven by its
   island and carries no name. #}
{% macro qty(config) %}
    {% set id = config.id ?? 'pdp-qty' %}
    <div class="pdp__qty">
        <label for="{{ id }}" class="field__label block">{{ config.label ?? __('Qty') }}</label>
        <input id="{{ id }}"
               {% if config.name is defined %}name="{{ config.name }}"{% endif %}
               type="number" inputmode="numeric" min="1" step="1" value="{{ config.value ?? 1 }}"
               class="field__control field-qty mt-2">
    </div>
{% endmacro %}
