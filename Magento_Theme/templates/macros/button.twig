{# Buttons and CTA links. The classes are the contract — Vue islands use the same
   ones — and these macros are the Twig shorthand over them. Pass `content` (a
   captured block) instead of `label` when the button holds markup, e.g. an icon. #}

{% macro classes(config) %}
    {%- set parts = ['btn', 'btn--' ~ (config.variant ?? 'solid')] -%}
    {%- if config.size is defined and config.size %}{% set parts = parts|merge(['btn--' ~ config.size]) %}{% endif -%}
    {%- if config.block ?? false %}{% set parts = parts|merge(['btn--block']) %}{% endif -%}
    {%- if config.class is defined and config.class %}{% set parts = parts|merge([config.class]) %}{% endif -%}
    {{- parts|join(' ') -}}
{% endmacro %}

{% macro button(config) %}
    {% import _self as self %}
    <button
            type="{{ config.type ?? 'submit' }}"
            class="{{ self.classes(config)|trim }}"
            {% if config.name is defined %}name="{{ config.name }}"{% endif %}
            {% if config.value is defined %}value="{{ config.value|escape_html_attr }}"{% endif %}
            {% if config.disabled ?? false %}disabled{% endif %}
            {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
    >{{ config.content ?? config.label }}</button>
{% endmacro %}

{% macro link(config) %}
    {% import _self as self %}
    <a
            href="{{ config.href|escape_url }}"
            class="{{ self.classes(config)|trim }}"
            {% for attribute, attributeValue in config.attrs|default({}) %}{{ attribute }}="{{ attributeValue|escape_html_attr }}" {% endfor %}
    >{{ config.content ?? config.label }}</a>
{% endmacro %}
