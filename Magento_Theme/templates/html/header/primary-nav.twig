{% set links = block.getNavigation().getItems(block.getMaxDepth()|default(1)) %}
{% set label = __('Primary') %}
{% set moreLabel = __('More') %}

<style>{{ block.getOverflow().getStyle(links, {
    container: 'obsidian-nav',
    tracking: 0.18,
    chevron: 16,
    moreLabel: moreLabel,
    moreExtra: 18,
    uppercase: true,
    gaps: [{ gap: 24 }, { from: 1280, gap: 32 }]
})|raw }}</style>

{% set serverHtml %}
    {% include 'Magento_Theme::html/header/primary-nav/initial.twig' with {
        links: links,
        label: label,
        moreLabel: moreLabel
    } only %}
{% endset %}

{{ render_vue(
    'MageObsidian_Storefront::navigation/PrimaryNav',
    {
        links: links,
        label: label,
        moreLabel: moreLabel
    },
    true,
    serverHtml,
    true
) }}
