{# Must be hero_icon, not hand-written SVG: this markup is hydrated by PrimaryNav,
   whose <Icon> renders a sprite <use href> — an inline <path> mismatches and Vue
   throws the whole nav away and rebuilds it. #}
<nav class="flex min-w-0 items-center gap-6 xl:gap-8" aria-label="{{ label }}">
{%- apply island_list -%}
    {%- for link in links -%}
        {%- apply island_list -%}
            {%- if link.children is not defined or link.children is empty -%}
                <a data-nav-item data-nav-index="{{ loop.index0 }}" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %} class="whitespace-nowrap eyebrow transition-colors hover:text-ink">{{ link.label }}</a>
            {%- else -%}
                <div data-nav-item data-nav-index="{{ loop.index0 }}" class="relative">
                    <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %} aria-haspopup="true" aria-expanded="false" class="inline-flex items-center gap-1 whitespace-nowrap eyebrow transition-colors hover:text-ink">{{ link.label }} {{ hero_icon('chevron-down', 'outline', '24', 'h-3 w-3 transition-transform') }}</a>
                    <div class="absolute left-0 top-full z-40 pt-3" style="display:none;">
                        <ul aria-label="{{ link.label }}" class="max-h-[calc(100dvh-9rem)] min-w-[12rem] overflow-y-auto overscroll-contain rounded-edge border border-ash-200 bg-alabaster py-1 shadow-xl">
                        {%- apply island_list -%}
                            {%- for child in link.children -%}
                                <li>
                                    <a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %} class="block whitespace-nowrap px-4 py-2 eyebrow transition-colors hover:bg-ash-100 hover:text-ink">{{ child.label }}</a>
                                    {%- apply island_if(child.children is defined and child.children is not empty) -%}
                                        <ul class="pb-1">
                                        {%- apply island_list -%}
                                            {%- for grandchild in child.children|default([]) -%}
                                                <li><a href="{{ grandchild.url }}" class="block whitespace-nowrap px-4 py-1.5 pl-7 font-mono text-micro uppercase tracking-eyebrow text-ash-500 transition-colors hover:bg-ash-100 hover:text-ink">{{ grandchild.label }}</a></li>
                                            {%- endfor -%}
                                        {%- endapply -%}
                                        </ul>
                                    {%- endapply -%}
                                </li>
                            {%- endfor -%}
                        {%- endapply -%}
                        </ul>
                    </div>
                </div>
            {%- endif -%}
        {%- endapply -%}
    {%- endfor -%}
{%- endapply -%}
    <div data-nav-more class="relative">
        <button type="button" class="inline-flex items-center gap-1 whitespace-nowrap eyebrow transition-colors hover:text-ink" aria-haspopup="true" aria-controls="" aria-expanded="false" data-allow-mismatch="attribute">{{ moreLabel }} {{ hero_icon('chevron-down', 'outline', '24', 'h-3.5 w-3.5 transition-transform') }}</button>
        {%- apply island_if(false) -%}{%- endapply -%}
    </div>
</nav>
