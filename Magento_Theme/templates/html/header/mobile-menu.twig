{#
  Mobile navigation island holder. Rendered by a MageObsidian Template block
  (see layout) so render_vue is available; mounts eager because it sits in the
  above-the-fold header. Nav items come from the shared Navigation ViewModel —
  the same source the desktop nav and footer use, so there is no duplicated list.
  The store/currency switchers (same ViewModels as the desktop islands) are
  passed in only when they have more than one option; the component reuses the
  Switcher in its inline variant inside the drawer.
#}
{% set stores = block.getStoreSwitcher() %}
{% set currencies = block.getCurrencySwitcher() %}
{#
  The component's own closed state, so Vue adopts the hamburger instead of
  clearing it and painting it again — keep in step with MobileMenu.vue. The
  drawer teleports to <body>, and a teleport's anchors cannot be written from a
  template — so the wrapper tolerates the extra child Vue inserts for it.
  `aria-controls` carries an id generated by Vue's useId(), which no server can
  predict, so that one is exempted too rather than guessed.
#}
{% set placeholder %}<div class="lg:hidden" data-allow-mismatch="children"><button type="button" class="-ml-1 inline-flex h-10 w-10 items-center justify-center text-ink-soft transition-colors hover:text-ink" aria-label="{{ __('Menu') }}" aria-haspopup="dialog" aria-controls="" aria-expanded="false" data-allow-mismatch="attribute">{{ hero_icon('bars-3', 'outline', '24', 'h-6 w-6') }}</button></div>{% endset %}
{{ render_vue(
    'MageObsidian_Storefront::navigation/MobileMenu',
    {
        links: block.getNavigation().getItems(block.getMaxDepth()|default(1)),
        utilities: [
            { url: block.getUrl('wishlist'), label: __('My Wish List'), kind: 'wishlist' },
            { url: block.getUrl('catalog/product_compare'), label: __('Compare Products'), kind: 'compare' }
        ],
        label: __('Menu'),
        navLabel: __('Browse'),
        brand: 'OBSIDIAN',
        homeUrl: block.getBaseUrl(),
        stores: stores.hasMultiple()
            ? { label: stores.getCurrentLabel(), srLabel: __('Change language'), items: stores.getItems() }
            : null,
        currencies: currencies.hasMultiple()
            ? { label: currencies.getCurrentLabel(), srLabel: __('Change currency'), items: currencies.getItems() }
            : null
    },
    true,
    placeholder,
    true
) }}
