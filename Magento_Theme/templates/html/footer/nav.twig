{#
  Footer "Shop" column — top level of the shared Navigation ViewModel.
#}
<nav aria-label="{{ __('Shop')|escape_html_attr }}">
    <div class="mb-4 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-on-obsidian">{{ __('Shop') }}</div>
    <ul class="space-y-2 text-sm">
        {% for item in block.getNavigation().getItems() %}
            <li><a href="{{ item.url|escape_url }}" class="transition-colors hover:text-on-obsidian">{{ item.label }}</a></li>
        {% endfor %}
    </ul>
</nav>
