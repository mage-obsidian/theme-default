{#
  OBSIDIAN header — minimal premium. Cool alabaster bar, Bodoni wordmark, mono
  nav/utilities. Nav items come from the Navigation ViewModel (single source,
  shared with the mobile menu and footer); the desktop list is rendered through
  the nav_list macro. The mobile menu is an eager island (child block).
  `block` is the Magento header-content block.
#}
{# Slim utility bar (desktop only): announcement slot on the left, store/currency
   switchers on the right. Not sticky — it scrolls away while the main header below
   stays pinned. On mobile the switchers live in the drawer, so this is lg-only. #}
<div class="hidden border-b border-ash-200 bg-ash-100/70 lg:block print:hidden">
    <div class="mx-auto flex h-9 max-w-[1320px] items-center justify-between gap-4 px-4 font-mono text-[0.66rem] uppercase leading-none tracking-[0.14em] text-ink-soft md:px-8">
        <p class="truncate">{{ __('Powered by MageObsidian — a modern frontend for Magento') }}</p>
        <div class="flex items-center gap-4">
            {{ child_html('switcher_language') }}
            {{ child_html('switcher_currency') }}
        </div>
    </div>
</div>

<div class="sticky top-0 z-30 border-b border-ash-200 bg-alabaster/85 backdrop-blur-md print:hidden">
    <div class="mx-auto flex h-[68px] max-w-[1320px] items-center justify-between gap-2 px-3 sm:gap-4 sm:px-4 md:gap-6 md:px-8">
        <div class="flex items-center gap-2">
            {{ child_html('mobile_menu') }}
            <a href="{{ block.getUrl('') }}"
               class="font-display text-base font-semibold tracking-[0.1em] text-ink min-[360px]:text-lg min-[360px]:tracking-[0.12em] sm:text-2xl sm:tracking-[0.16em]"
               aria-label="{{ __('OBSIDIAN — home')|escape_html_attr }}">OBSIDIAN</a>
        </div>

        {# Desktop nav is the PrimaryNav island (priority+ "More" overflow). The
           wrapper is the shrinkable flex child (min-w-0), so a long category list
           collapses into "More" instead of pushing the page into a horizontal
           scroll. Below lg the nav lives in the hamburger drawer instead. #}
        <div class="hidden min-w-0 flex-1 justify-center lg:flex">
            {{ child_html('primary_nav') }}
        </div>

        <div class="flex items-center gap-3 font-mono text-[0.72rem] uppercase leading-none tracking-[0.12em] text-ink-soft sm:gap-4">
            {{ child_html('account_menu') }}
            {{ child_html('search') }}
            {# Below lg the desktop nav is collapsed into the hamburger drawer, and
               wishlist/compare move there with it (the bar would otherwise wrap in
               the md–lg range); keep them in the bar only once there is room. #}
            <div class="hidden items-center gap-4 lg:flex">
                <a href="{{ block.getUrl('wishlist') }}" class="inline-flex items-center transition-colors hover:text-ink" aria-label="{{ __('My Wish List')|escape_html_attr }}">
                    {{ child_html('wishlist_count') }}
                </a>
                <a href="{{ block.getUrl('catalog/product_compare') }}" class="inline-flex items-center transition-colors hover:text-ink" aria-label="{{ __('Compare Products')|escape_html_attr }}">
                    {{ child_html('compare_count') }}
                </a>
            </div>
            {# `data-minicart-trigger` is a neutral hook: with no JS (or no checkout
               module) this stays a plain link to the cart page; the checkout
               module's mini-cart island enhances it to open the drawer instead.
               The label is icon-only (shopping-bag lives in the cart_count island),
               so the link carries the accessible name itself. #}
            <a href="{{ block.getUrl('checkout/cart') }}" data-minicart-trigger class="inline-flex items-center rounded-edge border border-ash-300 px-3 py-2 transition-colors hover:border-ink" aria-label="{{ __('Bag')|escape_html_attr }}">
                {{ child_html('cart_count') }}
            </a>
        </div>
    </div>
</div>
