{#
  OBSIDIAN type families. The stylesheet is loaded off the critical path
  (preload as=style + onload swap to stylesheet) so it no longer render-blocks;
  display=swap keeps text visible meanwhile. <noscript> restores it without JS.
  TODO(perf): self-host the families in a later performance wave.
#}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&amp;family=Hanken+Grotesk:wght@300;400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap"
      onload="this.onload=null;this.rel='stylesheet'">
<noscript>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&amp;family=Hanken+Grotesk:wght@300;400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap">
</noscript>
