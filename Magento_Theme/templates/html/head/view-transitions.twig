{#
  Scopes the cross-document view transitions this theme opts into
  (@view-transition in theme.source.css) to catalog-internal navigations.

  The rules are inlined rather than shipped in the stylesheet: the browser starts
  the transition at the incoming document's FIRST render, and critical-CSS
  extraction keeps only the rules whose selectors match the rendered DOM — a
  ::view-transition pseudo never appears there.
#}
<style>{{ inline_view_file('Magento_Theme::css/view-transitions.css') }}</style>
<script type="module" src="{{ vite_url('MageObsidian_Storefront::js/viewTransitions') }}"></script>
