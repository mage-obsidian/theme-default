{% set terms = block.getBeacons().searchTerms() %}
{% if terms %}
    <div hidden data-report-beacon="search-term" data-url="{{ terms.url|escape_url }}"></div>
    {{ script('MageObsidian_Catalog::js/report-beacons') }}
{% endif %}
