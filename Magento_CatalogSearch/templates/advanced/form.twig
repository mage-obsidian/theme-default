{# Advanced search form. `block` is the core Advanced\Form: searchable attributes,
   labels, input types and the GET post URL. Native inputs, no JS. The legacy
   per-field validation widget is dropped; native number/date inputs and required
   server-side validation cover it. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{# Max query length cap on free-text inputs (Magento's default search limit). #}
{% set maxlen = 128 %}

<div class="mx-auto w-full max-w-[760px] px-4 py-12 md:px-8">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Advanced Search') }}</h1>

    <form action="{{ block.getSearchPostUrl()|escape_url }}" method="get" class="mt-8 flex flex-col gap-6">
        {% for attribute in block.getSearchableAttributes() %}
            {% set code = attribute.getAttributeCode() %}
            {% set type = block.getAttributeInputType(attribute) %}
            {% if type == 'number' or type == 'price' or type == 'date' %}
                {% set numeric = type != 'date' %}
                <div class="field">
                    <label for="adv-{{ code }}" class="field__label">{{ __(block.getAttributeLabel(attribute)) }}</label>
                    <div class="grid grid-cols-2 gap-3">
                        <input type="{{ numeric ? 'number' : 'date' }}"{{ numeric ? ' step="any"' : '' }} id="adv-{{ code }}" name="{{ code }}[from]" value="{{ block.getAttributeValue(attribute, 'from') }}"{{ numeric ? ' placeholder="' ~ __('From')|escape_html_attr ~ '"' : '' }} aria-describedby="adv-{{ code }}-error" class="field__control w-full">
                        <div class="flex items-center gap-2">
                            <input type="{{ numeric ? 'number' : 'date' }}"{{ numeric ? ' step="any"' : '' }} id="adv-{{ code }}-to" name="{{ code }}[to]" value="{{ block.getAttributeValue(attribute, 'to') }}"{{ numeric ? ' placeholder="' ~ __('To')|escape_html_attr ~ '"' : '' }} aria-label="{{ __('%1: to', __(block.getAttributeLabel(attribute)))|escape_html_attr }}" class="field__control w-full">
                            {% if type == 'price' %}
                                <span class="font-mono text-xs text-ink-soft">{{ block.getCurrency(attribute) }}</span>
                                <input type="hidden" name="{{ code }}[currency]" value="{{ block.getCurrency(attribute)|escape_html_attr }}">
                            {% endif %}
                        </div>
                    </div>
                    <p class="field__error" id="adv-{{ code }}-error" role="alert"></p>
                </div>
            {% elseif type == 'select' or type == 'yesno' %}
                {{ form.field({
                    name: code,
                    id: 'adv-' ~ code,
                    label: __(block.getAttributeLabel(attribute)),
                    type: 'select',
                    value: block.getAttributeValue(attribute),
                    options: attribute.getSource().getAllOptions()
                }) }}
            {% else %}
                {{ form.field({
                    name: code,
                    id: 'adv-' ~ code,
                    label: __(block.getAttributeLabel(attribute)),
                    value: block.getAttributeValue(attribute),
                    attrs: { maxlength: maxlen }
                }) }}
            {% endif %}
        {% endfor %}

        <div class="mt-2">
            <button type="submit" class="btn btn--solid px-8">{{ __('Search') }}</button>
        </div>
    </form>
</div>
