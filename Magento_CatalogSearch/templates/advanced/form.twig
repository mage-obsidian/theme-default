{# Advanced search form. `block` is the core Advanced\Form: searchable attributes,
   labels, input types and the GET post URL. Native inputs, no JS. The legacy
   per-field validation widget is dropped; native number/date inputs and required
   server-side validation cover it. #}
{# Max query length cap on free-text inputs (Magento's default search limit). #}
{% set maxlen = 128 %}
{% set labelClass = 'font-mono text-[0.7rem] uppercase tracking-[0.14em] text-ink-soft' %}
{% set inputClass = 'h-10 w-full rounded-edge border border-ash-300 bg-transparent px-3 text-sm text-ink focus:border-ink focus:outline-none' %}

<div class="mx-auto w-full max-w-[760px] px-4 py-12 md:px-8">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Advanced Search') }}</h1>

    <form action="{{ block.getSearchPostUrl()|escape_url }}" method="get" class="mt-8 flex flex-col gap-6">
        {% for attribute in block.getSearchableAttributes() %}
            {% set code = attribute.getAttributeCode() %}
            {% set type = block.getAttributeInputType(attribute) %}
            <div class="flex flex-col gap-1.5">
                <label for="adv-{{ code }}" class="{{ labelClass }}">{{ __(block.getAttributeLabel(attribute)) }}</label>

                {% if type == 'number' or type == 'price' %}
                    <div class="grid grid-cols-2 gap-3">
                        <input type="number" step="any" id="adv-{{ code }}" name="{{ code }}[from]" value="{{ block.getAttributeValue(attribute, 'from') }}" placeholder="{{ __('From') }}" class="{{ inputClass }}">
                        <div class="flex items-center gap-2">
                            <input type="number" step="any" id="adv-{{ code }}-to" name="{{ code }}[to]" value="{{ block.getAttributeValue(attribute, 'to') }}" placeholder="{{ __('To') }}" class="{{ inputClass }}">
                            {% if type == 'price' %}
                                <span class="font-mono text-xs text-ink-soft">{{ block.getCurrency(attribute) }}</span>
                                <input type="hidden" name="{{ code }}[currency]" value="{{ block.getCurrency(attribute)|escape_html_attr }}">
                            {% endif %}
                        </div>
                    </div>
                {% elseif type == 'date' %}
                    <div class="grid grid-cols-2 gap-3">
                        <input type="date" id="adv-{{ code }}" name="{{ code }}[from]" value="{{ block.getAttributeValue(attribute, 'from') }}" class="{{ inputClass }}">
                        <input type="date" id="adv-{{ code }}-to" name="{{ code }}[to]" value="{{ block.getAttributeValue(attribute, 'to') }}" class="{{ inputClass }}">
                    </div>
                {% elseif type == 'select' or type == 'yesno' %}
                    <select id="adv-{{ code }}" name="{{ code }}" class="{{ inputClass }}">
                        {% for option in attribute.getSource().getAllOptions() %}
                            <option value="{{ option.value|escape_html_attr }}" {% if block.getAttributeValue(attribute) == option.value %}selected{% endif %}>{{ option.label }}</option>
                        {% endfor %}
                    </select>
                {% else %}
                    <input type="text" id="adv-{{ code }}" name="{{ code }}" value="{{ block.getAttributeValue(attribute) }}" maxlength="{{ maxlen }}" class="{{ inputClass }}">
                {% endif %}
            </div>
        {% endfor %}

        <div class="mt-2">
            <button type="submit" class="h-11 rounded-edge bg-ink px-8 font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-obsidian-800">{{ __('Search') }}</button>
        </div>
    </form>
</div>
