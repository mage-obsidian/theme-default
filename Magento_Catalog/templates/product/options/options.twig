{#
  Reusable custom-options renderer. Server-rendered with Magento's native field
  names (options[id], options[id][], options[id][month|day|year|...],
  options_<id>_file) so the form POSTs correctly WITHOUT JS — the server-side
  option model validates and prices it. The `product-options` enhancer reads the
  embedded JSON price config (getJsonConfig) to show a live delta and to validate
  required options accessibly; with JS off the native `required` attributes and
  the plain POST still work.

  Shared by the simple form and the configurable island (one renderer, two hosts).
  `view` is the ProductView ViewModel (plain price formatting + year range);
  `options` are the core option models; `config` is the encoded price JSON.
  `preselected` (optionId => saved value) pre-fills fields when reconfiguring a
  cart item; empty on a normal product view, so the PDP is unchanged.
#}
{% macro select_range(name, from, to, label, pad, selected) %}
    <select name="{{ name }}" aria-label="{{ label }}" data-option-input
            class="field__control font-mono">
        <option value="">{{ label }}</option>
        {% for n in range(from, to) %}
            <option value="{{ n }}"{% if selected is not null and selected == n %} selected{% endif %}>{{ pad and n < 10 ? '0' ~ n : n }}</option>
        {% endfor %}
    </select>
{% endmacro %}
{% import _self as dateparts %}
{% set preselected = preselected|default({}) %}
<div class="pdp__options mt-8 flex flex-col gap-6" data-product-options
     data-err-required="{{ __('This is a required field.')|escape_html_attr }}">
    <script type="application/json" data-options-config>{{ config|raw }}</script>

    {% for option in options %}
        {% set id = option.getId() %}
        {% set type = option.getType() %}
        {% set required = option.getIsRequire() %}
        {% set saved = preselected[id]|default(null) %}
        {# For `file`, the saved value is Magento's uploaded-file info, not a plain value. #}
        {% set uploaded = type == 'file' and saved.title|default('') is not empty ? saved : null %}
        <fieldset class="pdp__option border-0 p-0" data-option data-option-id="{{ id }}"
                  data-option-type="{{ type }}"{% if required %} data-required{% endif %}{% if uploaded %} data-option-uploaded{% endif %}>
            <legend id="opt-legend-{{ id }}" class="pdp__option-label field__label">
                {{ option.getTitle() }}{% if required %}<span class="field__required" aria-hidden="true">*</span>{% endif %}
            </legend>
            <div class="pdp__option-control mt-3">
                {% if type == 'field' %}
                    <input type="text" name="options[{{ id }}]" id="option-{{ id }}" data-option-input
                           aria-labelledby="opt-legend-{{ id }}"
                           {% if saved is not null %}value="{{ saved }}"{% endif %}
                           {% if option.getMaxCharacters() %}maxlength="{{ option.getMaxCharacters() }}"{% endif %}
                           {% if required %}required aria-required="true"{% endif %}
                           class="field__control w-full font-mono">

                {% elseif type == 'area' %}
                    <textarea name="options[{{ id }}]" id="option-{{ id }}" rows="4" data-option-input
                              aria-labelledby="opt-legend-{{ id }}"
                              {% if option.getMaxCharacters() %}maxlength="{{ option.getMaxCharacters() }}"{% endif %}
                              {% if required %}required aria-required="true"{% endif %}
                              class="field__control w-full font-mono">{% if saved is not null %}{{ saved }}{% endif %}</textarea>

                {% elseif type == 'drop_down' %}
                    <select name="options[{{ id }}]" id="option-{{ id }}" data-option-input
                            aria-labelledby="opt-legend-{{ id }}"
                            {% if required %}required aria-required="true"{% endif %}
                            class="field__control w-full font-mono">
                        <option value="">{{ __('-- Please Select --') }}</option>
                        {% for value in option.getValues() %}
                            {% set amount = value.getPrice(true) %}
                            <option value="{{ value.getId() }}"{% if saved is not null and saved == value.getId() %} selected{% endif %}>{{ value.getTitle() }}{% if amount > 0 %} (+{{ view.formatPrice(amount) }}){% endif %}</option>
                        {% endfor %}
                    </select>

                {% elseif type == 'radio' %}
                    <div role="radiogroup" aria-label="{{ option.getTitle() }}" class="flex flex-col gap-2">
                        {% if not required %}
                            <label class="flex items-center gap-2 text-sm text-ink">
                                <input type="radio" name="options[{{ id }}]" value="" data-option-input{% if saved is null %} checked{% endif %}> {{ __('None') }}
                            </label>
                        {% endif %}
                        {% for value in option.getValues() %}
                            {% set amount = value.getPrice(true) %}
                            <label class="flex items-center gap-2 text-sm text-ink">
                                <input type="radio" name="options[{{ id }}]" value="{{ value.getId() }}" data-option-input
                                       {% if saved is not null and saved == value.getId() %}checked{% endif %}
                                       {% if required %}required{% endif %}>
                                {{ value.getTitle() }}{% if amount > 0 %} <span class="text-ink-soft">+{{ view.formatPrice(amount) }}</span>{% endif %}
                            </label>
                        {% endfor %}
                    </div>

                {% elseif type == 'checkbox' %}
                    <div role="group" aria-label="{{ option.getTitle() }}" class="flex flex-col gap-2">
                        {% for value in option.getValues() %}
                            {% set amount = value.getPrice(true) %}
                            <label class="field-check text-sm text-ink">
                                <input type="checkbox" name="options[{{ id }}][]" value="{{ value.getId() }}" data-option-input
                                       class="field-check__input"
                                       {% if saved is iterable and value.getId() in saved %}checked{% endif %}>
                                {{ value.getTitle() }}{% if amount > 0 %} <span class="text-ink-soft">+{{ view.formatPrice(amount) }}</span>{% endif %}
                            </label>
                        {% endfor %}
                    </div>

                {% elseif type == 'multiple' %}
                    <select name="options[{{ id }}][]" id="option-{{ id }}" multiple data-option-input
                            aria-labelledby="opt-legend-{{ id }}"
                            {% if required %}required aria-required="true"{% endif %}
                            class="field__control w-full font-mono">
                        {% for value in option.getValues() %}
                            {% set amount = value.getPrice(true) %}
                            <option value="{{ value.getId() }}"{% if saved is iterable and value.getId() in saved %} selected{% endif %}>{{ value.getTitle() }}{% if amount > 0 %} (+{{ view.formatPrice(amount) }}){% endif %}</option>
                        {% endfor %}
                    </select>

                {% elseif type in ['date', 'date_time', 'time'] %}
                    {% set d = saved is iterable ? saved : {} %}
                    <div class="flex flex-wrap gap-2">
                        {% if type in ['date', 'date_time'] %}
                            {{ dateparts.select_range('options[' ~ id ~ '][month]', 1, 12, __('Month'), true, d.month|default(null)) }}
                            {{ dateparts.select_range('options[' ~ id ~ '][day]', 1, 31, __('Day'), true, d.day|default(null)) }}
                            <select name="options[{{ id }}][year]" aria-label="{{ __('Year') }}" data-option-input
                                    class="field__control font-mono">
                                <option value="">{{ __('Year') }}</option>
                                {% for year in years %}<option value="{{ year }}"{% if d.year is defined and d.year == year %} selected{% endif %}>{{ year }}</option>{% endfor %}
                            </select>
                        {% endif %}
                        {% if type in ['time', 'date_time'] %}
                            {{ dateparts.select_range('options[' ~ id ~ '][hour]', 1, 12, __('Hour'), true, d.hour|default(null)) }}
                            {{ dateparts.select_range('options[' ~ id ~ '][minute]', 0, 59, __('Minute'), true, d.minute|default(null)) }}
                            <select name="options[{{ id }}][day_part]" aria-label="{{ __('AM/PM') }}" data-option-input
                                    class="field__control font-mono">
                                <option value="am"{% if d.day_part|default('') == 'am' %} selected{% endif %}>{{ __('AM') }}</option>
                                <option value="pm"{% if d.day_part|default('') == 'pm' %} selected{% endif %}>{{ __('PM') }}</option>
                            </select>
                        {% endif %}
                    </div>

                {% elseif type == 'file' %}
                    {% set amount = option.getPrice(true) %}
                    {% set extensions = option.getFileExtension() %}
                    {% if uploaded %}
                        <p class="mb-2 font-mono text-[0.7rem] text-ink">
                            {{ __('Current file') }}: <span class="text-ink-soft">{{ uploaded.title }}</span>
                        </p>
                    {% endif %}
                    <input type="file" name="options_{{ id }}_file" id="option-{{ id }}" data-option-input
                           aria-labelledby="opt-legend-{{ id }}"
                           {% if extensions %}accept=".{{ extensions|replace({' ': ''})|replace({',': ',.'}) }}"{% endif %}
                           {# An already-uploaded file satisfies the requirement, so the browser must not block the no-JS submit. #}
                           {% if required and not uploaded %}required aria-required="true"{% endif %}
                           class="block w-full font-mono text-sm text-ink-soft file:mr-4 file:rounded-edge file:border file:border-ink file:bg-transparent file:px-4 file:py-2 file:font-mono file:text-[0.68rem] file:uppercase file:tracking-[0.14em] file:text-ink">
                    {# save_old keeps the file already on the line; product-options.ts flips it to save_new on replacement. #}
                    <input type="hidden" name="options_{{ id }}_file_action" value="{{ uploaded ? 'save_old' : 'save_new' }}">
                    {% if uploaded %}
                        <p class="mt-1 font-mono text-[0.66rem] text-ash-500">{{ __('Choose a file to replace it.') }}</p>
                    {% endif %}
                    {% if extensions %}
                        <p class="field__hint mt-1">{{ __('Allowed file types') }}: {{ extensions }}</p>
                    {% endif %}
                    {% if amount > 0 %}<p class="mt-1 font-mono text-[0.66rem] text-ink-soft">+{{ view.formatPrice(amount) }}</p>{% endif %}
                {% endif %}
            </div>
            <p class="pdp__option-error field__error mt-2" data-option-error role="alert"></p>
        </fieldset>
    {% endfor %}
</div>
