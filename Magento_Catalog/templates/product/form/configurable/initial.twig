{%- import 'Magento_Theme::macros/form.twig' as form -%}
<form class="pdp__configurable" novalidate>
    <div class="pdp__price mb-6 flex items-baseline gap-3" aria-live="polite">
        <span class="pdp__price-final font-mono text-2xl{{ oldPrice ? ' text-sale' : ' text-ink' }}">{{ price }}</span>
        {% apply island_if(oldPrice) %}<span class="pdp__price-regular font-mono text-base text-ink-soft line-through">{{ oldPrice }}</span>{% endapply %}
    </div>

    {% apply island_list %}
        {% for group in groups %}
            <fieldset class="pdp__swatch-group mb-6 border-0 p-0">
                <legend class="field__label">{{ group.label }}</legend>
                <div class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-label="{{ __('Choose %1', group.label) }}">
                    {% apply island_list %}
                        {% for option in group.options %}
                            <button type="button" role="radio"
                                    data-option-id="{{ option.id }}"
                                    aria-checked="false"
                                    aria-label="{{ option.label }}"
                                    {%- if not option.available %} disabled{% endif %}
                                    tabindex="{{ loop.first ? '0' : '-1' }}"
                                    class="pdp__swatch{% if not option.available %} pdp__swatch--unavailable{% endif %}{% if option.kind == 'text' %} pdp__swatch--text{% endif %}">
                                {%- if option.kind == 'color' and option.value matches '/^#[0-9a-fA-F]{3,8}$/' -%}
                                    <span class="pdp__swatch-chip pdp__swatch-chip--{{ option.id }}" aria-hidden="true"></span>
                                {%- elseif option.kind == 'image' -%}
                                    <span class="pdp__swatch-chip pdp__swatch-chip--{{ option.id }}" aria-hidden="true"></span>
                                {%- else -%}
                                    <span>{{ option.label }}</span>
                                {%- endif -%}
                            </button>
                        {% endfor %}
                    {% endapply %}
                </div>
            </fieldset>
        {% endfor %}
    {% endapply %}

    <div class="pdp__buy-row flex flex-wrap items-end gap-4">
        {{ form.qty({ id: 'pdp-cfg-qty', label: labels.qty, value: qty }) }}
        <button type="submit" aria-disabled="true" aria-busy="false"
                class="btn btn--solid btn--lg flex-1"><span class="btn__label">{{ labels.selectOptions }}</span>{% apply island_if(false) %}{% endapply %}</button>
    </div>
</form>
