{% import 'Magento_Theme::macros/state.twig' as state %}
{% set items = block.getItems() %}
{% set itemCount = items.getSize ? items.getSize() : items|length %}

<div class="mx-auto w-full max-w-shell px-4 py-12 md:px-8">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="font-display text-3xl text-ink md:text-4xl">{{ __('Compare Products') }}</h1>
        {% if itemCount > 0 %}
            <form action="{{ block.getUrl('catalog/product_compare/clear') }}" method="post" data-busy-submit>
                {{ block.getBlockHtml('formkey')|raw }}
                <button type="submit" class="font-mono text-micro uppercase tracking-eyebrow text-sale underline">{{ __('Clear All') }}</button>
            </form>
        {% endif %}
    </div>

    {% if itemCount > 0 %}
        <div class="mt-8 overflow-x-auto">
            <table class="border-collapse text-left align-top md:w-full">
                <thead>
                    <tr>
                        <th scope="col" class="w-24 border-b border-ash-200 p-3 md:w-40 md:p-4"><span class="sr-only">{{ __('Product') }}</span></th>
                        {% for item in items %}
                            {% set media = block.getCard().getImage(item, 'category_page_grid') %}
                            <th scope="col" class="w-64 min-w-60 border-b border-ash-200 p-4 align-top font-normal">
                                <div class="flex max-w-64 flex-col">
                                    <div class="relative">
                                        <a href="{{ item.getProductUrl()|escape_url }}" class="block aspect-[4/5] overflow-hidden rounded-edge bg-alabaster-deep" tabindex="-1">
                                            {{ image(media.src, {
                                                class: 'h-full w-full object-cover',
                                                alt: media.label,
                                                width: media.width,
                                                height: media.height,
                                                srcset: media.srcset,
                                                sizes: '16rem',
                                                loading: 'lazy'
                                            }) }}
                                        </a>
                                        <form action="{{ block.getUrl('catalog/product_compare/remove') }}" method="post" data-busy-submit class="absolute right-2 top-2">
                                            <input type="hidden" name="product" value="{{ item.getId() }}">
                                            {{ block.getBlockHtml('formkey')|raw }}
                                            <button type="submit" aria-label="{{ __('Remove %1', item.getName())|escape_html_attr }}" title="{{ __('Remove')|escape_html_attr }}"
                                                    class="btn btn--outline btn--icon rounded-full bg-alabaster/90 backdrop-blur">
                                                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                    <a href="{{ item.getProductUrl()|escape_url }}" class="mt-4 block font-display text-base leading-snug text-ink hover:text-accent">{{ item.getName() }}</a>
                                    <div class="mt-1 font-mono text-sm text-ink">{{ block.getProductPrice(item)|raw }}</div>
                                    <div class="mt-4 flex items-center gap-2">
                                        {% set post = block.getCard().isQuickAdd(item) ? block.getCard().getAddToCartPostParams(item) : {} %}
                                        {% if post.action is defined %}
                                            <form action="{{ post.action|escape_url }}" method="post" data-add-to-cart class="flex-1">
                                                <input type="hidden" name="product" value="{{ post.data.product }}">
                                                <input type="hidden" name="uenc" value="{{ post.data.uenc }}">
                                                {{ block.getBlockHtml('formkey')|raw }}
                                                <button type="submit" class="btn btn--solid btn--block whitespace-nowrap px-4">{{ __('Add to Cart') }}</button>
                                            </form>
                                        {% elseif item.isSaleable() %}
                                            <a href="{{ item.getProductUrl()|escape_url }}" class="btn btn--solid flex-1 whitespace-nowrap px-4">{{ __('Choose options') }}</a>
                                        {% else %}
                                            <span class="inline-flex h-11 flex-1 items-center justify-center rounded-edge border border-ash-200 font-mono text-eyebrow uppercase tracking-label text-ash-500">{{ __('Out of stock') }}</span>
                                        {% endif %}
                                        {% if block.getWishlist() and block.getWishlist().isEnabled() %}
                                            <form data-add-to-wishlist data-product-id="{{ item.getId() }}" action="{{ block.getUrl('wishlist/index/add') }}" method="post">
                                                <input type="hidden" name="product" value="{{ item.getId() }}">
                                                {{ block.getBlockHtml('formkey')|raw }}
                                                <button type="submit" aria-pressed="false" aria-label="{{ __('Add to Wish List')|escape_html_attr }}" title="{{ __('Add to Wish List')|escape_html_attr }}"
                                                        class="btn btn--outline btn--icon h-11 w-11">
                                                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                                                    </svg>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for attribute in block.getAttributes() %}
                        <tr>
                            <th scope="row" class="border-b border-ash-200 p-3 font-mono md:p-4 text-eyebrow uppercase tracking-eyebrow text-ink-soft">{{ attribute.getStoreLabel() }}</th>
                            {% for item in items %}
                                <td class="border-b border-ash-200 p-4 text-sm text-ink-soft">{{ block.getAttributeOutput().filter(item, block.getProductAttributeValue(item, attribute), attribute.getAttributeCode())|raw }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="mt-6">
            {# No icon: the core ListCompare block cannot render one. #}
            {{ state.empty(block, {
                title: __('Nothing to compare yet'),
                body: __('Add a few products side by side and their differences show up here.'),
                cta: __('Continue Shopping'),
                cta_url: block.getUrl('')
            }) }}
        </div>
    {% endif %}
</div>
{{ script('MageObsidian_Storefront::js/form-busy') }}
