{% set items = block.getItems() %}
{% set itemCount = items.getSize ? items.getSize() : items|length %}

<div class="mx-auto w-full max-w-shell px-4 py-12 md:px-8">
    <h1 class="font-display text-3xl text-ink md:text-4xl">{{ __('Compare Products') }}</h1>

    {% if itemCount > 0 %}
        <div class="mt-8 overflow-x-auto">
            <table class="w-full border-collapse text-left align-top">
                <thead>
                    <tr>
                        <th scope="col" class="sr-only">{{ __('Product') }}</th>
                        {% for item in items %}
                            <th scope="col" class="border-b border-ash-200 p-4 align-top">
                                <a href="{{ item.getProductUrl()|escape_url }}" class="block font-display text-base leading-snug text-ink hover:text-accent">{{ item.getName() }}</a>
                                <div class="mt-2 font-mono text-sm text-ink">{{ item.getFinalPrice()|price }}</div>
                                <div class="mt-3 flex flex-col gap-2">
                                    <form action="{{ block.getUrl('checkout/cart/add') }}" method="post" data-add-to-cart>
                                        <input type="hidden" name="product" value="{{ item.getId() }}">
                                        {{ block.getBlockHtml('formkey')|raw }}
                                        <button type="submit" class="btn btn--solid btn--sm btn--block">{{ __('Add to Cart') }}</button>
                                    </form>
                                    <form action="{{ block.getUrl('catalog/product_compare/remove') }}" method="post" data-busy-submit>
                                        <input type="hidden" name="product" value="{{ item.getId() }}">
                                        {{ block.getBlockHtml('formkey')|raw }}
                                        <button type="submit" class="font-mono text-micro uppercase tracking-eyebrow text-sale underline">{{ __('Remove') }}</button>
                                    </form>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for attribute in block.getAttributes() %}
                        <tr>
                            <th scope="row" class="border-b border-ash-200 p-4 font-mono text-eyebrow uppercase tracking-eyebrow text-ink-soft">{{ attribute.getStoreLabel() }}</th>
                            {% for item in items %}
                                <td class="border-b border-ash-200 p-4 text-sm text-ink-soft">{{ block.getProductAttributeValue(item, attribute)|raw }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="mt-6 font-mono text-sm text-ink-soft">{{ __('You have no items to compare.') }}</p>
    {% endif %}
</div>
{{ script('MageObsidian_Storefront::js/form-busy') }}
