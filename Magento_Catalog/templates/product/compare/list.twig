{% import 'Magento_Theme::macros/state.twig' as state %}
{% set items = block.getItems() %}
{% set itemCount = items.getSize ? items.getSize() : items|length %}

<div class="mx-auto w-full max-w-shell px-4 py-12 md:px-8">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="font-display text-3xl text-ink md:text-4xl">{{ __('Compare Products') }}</h1>
        {% if itemCount > 0 %}
            <form action="{{ block.getUrl('catalog/product_compare/clear') }}" method="post" data-busy-submit>
                {{ block.getBlockHtml('formkey')|raw }}
                <button type="submit" class="font-mono text-micro uppercase tracking-eyebrow text-sale underline">{{ __('Clear All') }}</button>
            </form>
        {% endif %}
    </div>

    {% if itemCount > 0 %}
        <div class="mt-8 overflow-x-auto">
            <table class="w-full border-collapse text-left align-top">
                <thead>
                    <tr>
                        <th scope="col" class="sr-only">{{ __('Product') }}</th>
                        {% for item in items %}
                            <th scope="col" class="border-b border-ash-200 p-4 align-top">
                                <a href="{{ item.getProductUrl()|escape_url }}" class="block font-display text-base leading-snug text-ink hover:text-accent">{{ item.getName() }}</a>
                                <div class="mt-2 font-mono text-sm text-ink">{{ block.getProductPrice(item)|raw }}</div>
                                <div class="mt-3 flex flex-col gap-2">
                                    {% set post = block.getCard().isQuickAdd(item) ? block.getCard().getAddToCartPostParams(item) : {} %}
                                    {% if post.action is defined %}
                                        <form action="{{ post.action|escape_url }}" method="post" data-add-to-cart>
                                            <input type="hidden" name="product" value="{{ post.data.product }}">
                                            <input type="hidden" name="uenc" value="{{ post.data.uenc }}">
                                            {{ block.getBlockHtml('formkey')|raw }}
                                            <button type="submit" class="btn btn--solid btn--sm btn--block">{{ __('Add to Cart') }}</button>
                                        </form>
                                    {% elseif item.isSaleable() %}
                                        <a href="{{ item.getProductUrl()|escape_url }}" class="btn btn--outline btn--sm btn--block">{{ __('Choose options') }}</a>
                                    {% else %}
                                        <span class="font-mono text-eyebrow uppercase tracking-label text-ash-500">{{ __('Out of stock') }}</span>
                                    {% endif %}
                                    {% if block.getWishlist() and block.getWishlist().isEnabled() %}
                                        <form data-add-to-wishlist data-product-id="{{ item.getId() }}" action="{{ block.getUrl('wishlist/index/add') }}" method="post">
                                            <input type="hidden" name="product" value="{{ item.getId() }}">
                                            {{ block.getBlockHtml('formkey')|raw }}
                                            <button type="submit" aria-pressed="false" class="btn btn--outline btn--sm btn--block">{{ __('Add to Wish List') }}</button>
                                        </form>
                                    {% endif %}
                                    <form action="{{ block.getUrl('catalog/product_compare/remove') }}" method="post" data-busy-submit>
                                        <input type="hidden" name="product" value="{{ item.getId() }}">
                                        {{ block.getBlockHtml('formkey')|raw }}
                                        <button type="submit" class="font-mono text-micro uppercase tracking-eyebrow text-sale underline">{{ __('Remove') }}</button>
                                    </form>
                                </div>
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for attribute in block.getAttributes() %}
                        <tr>
                            <th scope="row" class="border-b border-ash-200 p-4 font-mono text-eyebrow uppercase tracking-eyebrow text-ink-soft">{{ attribute.getStoreLabel() }}</th>
                            {% for item in items %}
                                <td class="border-b border-ash-200 p-4 text-sm text-ink-soft">{{ block.getAttributeOutput().filter(item, block.getProductAttributeValue(item, attribute), attribute.getAttributeCode())|raw }}</td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="mt-6">
            {# No icon: the core ListCompare block cannot render one. #}
            {{ state.empty(block, {
                title: __('Nothing to compare yet'),
                body: __('Add a few products side by side and their differences show up here.'),
                cta: __('Continue Shopping'),
                cta_url: block.getUrl('')
            }) }}
        </div>
    {% endif %}
</div>
{{ script('MageObsidian_Storefront::js/form-busy') }}
