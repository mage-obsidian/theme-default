<ol class="products-grid grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-5">
    {% for product in block.getProducts() %}
        <li class="product-item">
            {% include 'Magento_Catalog::product/card.twig' with { product: product, index: loop.index0, eager_count: 0, priority_count: 0 } %}
        </li>
    {% endfor %}
</ol>
