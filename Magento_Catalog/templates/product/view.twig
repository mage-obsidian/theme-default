{#
  Product detail page. Configurable products mount the swatch island; every other
  type uses the progressive add-to-cart form. Product/Offer + BreadcrumbList
  JSON-LD are emitted by the engine.
#}
{% set view = block.getView() %}
{% set gallery = block.getGallery() %}
{% set product = view.getProduct() %}
{% set configurable = view.isConfigurable() %}

{% if product %}
<article class="pdp mx-auto max-w-shell px-4 pb-24 pt-2 md:px-8"
         data-pdp data-product-id="{{ view.getProductId() }}">
    <div class="pdp__grid grid grid-cols-1 gap-x-12 gap-y-10 lg:grid-cols-2">

        {# ---- Gallery (server-rendered, LCP-eager) ---- #}
        {% include 'Magento_Catalog::product/gallery.twig' with { images: gallery.getImages() } %}

        {# ---- Buy box ---- #}
        <div class="pdp__info lg:sticky lg:top-24 lg:self-start">
            <h1 class="pdp__name font-display text-3xl leading-tight text-ink md:text-4xl">{{ view.getName() }}</h1>
            <p class="pdp__sku mt-2 eyebrow">
                {{ __('SKU') }}: {{ view.getSku() }}
            </p>

            {# Optional reviews hook: a domain Review module fills this with a
               compact rating summary; empty when no such module is installed. #}
            {{ child_html('review_summary') }}

            {# Configurable price is dynamic (owned by the island); grouped has no
               own price (its rows carry them). Every other type uses the native
               render (special/tier/range). #}
            {% if not configurable and not view.isGrouped() %}
                <div class="pdp__price mt-6">{{ view.getPriceHtml()|raw }}</div>
            {% endif %}

            {# Generic buy-box hook: a domain module (stock, delivery estimate…)
               fills it; empty when no such module is installed. #}
            {{ child_html('product_info_extra') }}

            {% set shortDescription = view.getShortDescriptionHtml() %}
            {% if shortDescription %}
                <div class="pdp__short prose mt-6 max-w-prose text-ink-soft">{{ shortDescription|raw }}</div>
            {% endif %}

            <div class="pdp__buy mt-8">
                {% if configurable %}
                    {% include 'Magento_Catalog::product/form/configurable.twig' %}
                {% elseif view.isSaleable() %}
                    {% if view.isDownloadable() %}
                        {% include 'Magento_Catalog::product/form/downloadable.twig' %}
                    {% elseif view.isGrouped() %}
                        {% include 'Magento_Catalog::product/form/grouped.twig' %}
                    {% elseif view.isBundle() %}
                        {% include 'Magento_Catalog::product/form/bundle.twig' %}
                    {% else %}
                        {% include 'Magento_Catalog::product/form/simple.twig' %}
                    {% endif %}
                {% else %}
                    <p class="pdp__unavailable inline-flex items-center rounded-edge border border-ash-200 px-5 py-3 font-mono text-eyebrow uppercase tracking-label text-ash-500">
                        {{ __('Out of stock') }}
                    </p>
                {% endif %}
            </div>

            {# Instant Purchase one-click button (Magento_InstantPurchase). The VM
               self-gates on the module flag; the island self-gates on the native
               instant-purchase customer-data section (a stored token + default
               addresses), so it stays inert without a configured gateway. #}
            {% set instantPurchase = block.getInstantPurchase() %}
            {% if instantPurchase and instantPurchase.isEnabled() and view.isSaleable() %}
                {{ render_vue('MageObsidian_InstantPurchase::InstantPurchaseButton', {
                    purchaseUrl: instantPurchase.getPurchaseUrl(),
                    buttonText: instantPurchase.getButtonText(),
                    labels: {
                        confirm: __('Place order now'),
                        cancel: __('Cancel'),
                        paying: __('Paying with'),
                        shipping: __('Shipping to'),
                        method: __('Via')
                    }
                }, true) }}
            {% endif %}

            <form data-add-to-wishlist data-product-id="{{ view.getProductId() }}"
                  action="{{ block.getUrl('wishlist/index/add') }}" method="post" class="pdp__wishlist mt-4">
                <input type="hidden" name="product" value="{{ view.getProductId() }}">
                {{ block.getBlockHtml('formkey')|raw }}
                {# Inline, not hero_icon: the saved/compared state fills the glyph
                   (.is-saved svg { fill }), and hero_icon renders a <use> clone of an
                   <svg fill="none">, whose own attribute beats the inherited fill —
                   the heart would stay an outline. #}
                <button type="submit" aria-pressed="false"
                        class="inline-flex min-h-6 items-center gap-2 eyebrow transition-colors hover:text-ink">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
                    </svg>
                    {{ __('Add to Wish List') }}
                </button>
            </form>

            <form data-add-to-compare data-product-id="{{ view.getProductId() }}"
                  action="{{ block.getUrl('catalog/product_compare/add') }}" method="post" class="pdp__compare mt-3">
                <input type="hidden" name="product" value="{{ view.getProductId() }}">
                {{ block.getBlockHtml('formkey')|raw }}
                <button type="submit" aria-pressed="false"
                        class="inline-flex min-h-6 items-center gap-2 eyebrow transition-colors hover:text-ink">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125Z" />
                    </svg>
                    {{ __('Add to Compare') }}
                </button>
            </form>

            {# Price-drop / back-in-stock notify links (Magento_ProductAlert VM
               self-gates each on the enable flag and product applicability). #}
            {% set productAlert = block.getProductAlert() %}
            {% if productAlert and productAlert.isPriceAllowed() %}
                <a href="{{ productAlert.getPriceUrl()|escape_url }}" class="pdp__alert mt-3 inline-flex items-center gap-2 eyebrow underline-offset-4 transition-colors hover:text-ink hover:underline">
                    <span class="inline-flex [&>svg]:h-4 [&>svg]:w-4">{{ hero_icon('bell', 'outline', '24')|raw }}</span>
                    {{ __('Notify me when the price drops') }}
                </a>
            {% endif %}
            {% if productAlert and productAlert.isStockAllowed() %}
                <a href="{{ productAlert.getStockUrl()|escape_url }}" class="pdp__alert mt-3 inline-flex items-center gap-2 eyebrow underline-offset-4 transition-colors hover:text-ink hover:underline">
                    <span class="inline-flex [&>svg]:h-4 [&>svg]:w-4">{{ hero_icon('bell-alert', 'outline', '24')|raw }}</span>
                    {{ __('Notify me when this product is in stock') }}
                </a>
            {% endif %}

            {# Email to a Friend (Magento_SendFriend; VM self-gates on the enable flag). #}
            {% set sendfriend = block.getSendfriend() %}
            {% if sendfriend and sendfriend.isAllowed() and sendfriend.getSendUrl() %}
                <a href="{{ sendfriend.getSendUrl()|escape_url }}" class="pdp__sendfriend mt-3 inline-flex items-center gap-2 eyebrow underline-offset-4 transition-colors hover:text-ink hover:underline">
                    <span class="inline-flex [&>svg]:h-4 [&>svg]:w-4">{{ hero_icon('envelope', 'outline', '24')|raw }}</span>
                    {{ __('Email to a Friend') }}
                </a>
            {% endif %}

            {% set attributes = block.getChildBlock('product_attributes') ? block.getChildBlock('product_attributes').getAdditionalData() : [] %}
            {% if attributes is not empty %}
                <section class="pdp__specs mt-12 border-t border-ash-200 pt-8" aria-labelledby="pdp-specs-title">
                    <h2 id="pdp-specs-title" class="eyebrow">{{ __('Details') }}</h2>
                    <dl class="mt-4 grid grid-cols-1 gap-y-3 sm:grid-cols-[auto_1fr] sm:gap-x-8">
                        {% for attribute in attributes %}
                            <dt class="font-mono text-eyebrow uppercase tracking-mono text-ink-soft">{{ attribute.label }}</dt>
                            <dd class="text-sm text-ink">{{ attribute.value|raw }}</dd>
                        {% endfor %}
                    </dl>
                </section>
            {% endif %}
        </div>
    </div>

    {% set description = view.getDescriptionHtml() %}
    {% if description %}
        <section class="pdp__description mt-16 border-t border-ash-200 pt-12" aria-labelledby="pdp-description-title">
            <h2 id="pdp-description-title" class="font-display text-xl text-ink">{{ __('About this product') }}</h2>
            <div class="prose mt-6 max-w-prose text-ink-soft">{{ description|raw }}</div>
        </section>
    {% endif %}

    {# Related + upsell product lists (empty when the product has none). #}
    {{ child_html('related') }}
    {{ child_html('upsell') }}

    {# Optional reviews hook: the Review domain module fills this with the
       approved-review list + submit form; empty when not installed. #}
    {{ child_html('reviews') }}

    {{ script('MageObsidian_Catalog::js/gallery') }}
</article>
{% endif %}
