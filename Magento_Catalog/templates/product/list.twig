{#
  Category product listing. Reuses the core ListProduct block (collection loading,
  toolbar, pagination) — we only swap the template to Twig. Grid-only (the legacy
  grid/list switch is dropped for a cleaner, faster premium grid). The toolbar is
  rendered top (sort/limit/amount) and bottom (pager); each card comes from the
  shared card partial. `block` is Magento\Catalog\Block\Product\ListProduct.

  The single `data-obsidian-section` root is the anchor MageObsidian_Search swaps
  when a filter, a sort or a page is picked. It has to sit outside the empty-state
  branch, or a filter combination with no results would leave nothing to swap back.
  Without that module installed it is an inert attribute.
#}
{% set products = block.getLoadedProductCollection() %}
<div data-obsidian-section="listing">
    {% if not products.count() %}
        <div class="message info empty py-16 text-center font-mono text-sm uppercase tracking-label text-ink-soft">
            {{ __('We can’t find products matching the selection.') }}
        </div>
    {% else %}
        {{ block.getToolbarHtml()|raw }}
        {{ block.getAdditionalHtml()|raw }}

        {# One stylesheet instead of a style attribute per card: a nonce cannot
           cover an attribute, so an enforcing policy drops every transition name
           and the cross-document transition dies with it. #}
        {{ style_rules(products|reduce((rules, product) => rules|merge({
            ('.product-item--' ~ product.getId()): 'view-transition-name: product-' ~ product.getId() ~ '; view-transition-class: obsidian-card'
        }), {})) }}

        <ol class="products-grid grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4"
            aria-label="{{ __('Products')|escape_html_attr }}">
            {% for product in products %}
                <li class="product-item product-item--{{ product.getId() }}">
                    {% include 'Magento_Catalog::product/card.twig' with { product: product, index: loop.index0, eager_count: 2, priority_count: 1 } %}
                </li>
            {% endfor %}
        </ol>

        {{ block.getChildBlock('toolbar').setIsBottom(true).toHtml()|raw }}

        {# ItemList structured data (reuses the already-loaded collection via the
           MageObsidian child block — no extra query, engine untouched). #}
        {{ child_html('item_list') }}
    {% endif %}
</div>
