{#
  Related products on the PDP. Native link-based list (Magento\...\Related); the
  block extends AbstractProduct, so the shared listing card renders unchanged. The
  delegated cart/compare enhancers already on the PDP pick up the card forms.
#}
{% set items = block.getItems() %}
{% if items|length > 0 %}
    <section class="pdp__related mt-16 border-t border-ash-200 pt-12" aria-labelledby="pdp-related-title">
        <h2 id="pdp-related-title" class="font-display text-xl text-ink">{{ __('Related Products') }}</h2>
        <div class="mt-8 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
            {% for item in items %}
                {% include 'Magento_Catalog::product/card.twig' with { product: item, index: loop.index0 } %}
            {% endfor %}
        </div>
    </section>
{% endif %}
