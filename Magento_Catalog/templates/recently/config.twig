{% set config = block.getRecently().config() %}
<div hidden data-recently-config data-scope="{{ config.scope|escape_html_attr }}" data-sync="{{ config.sync ? '1' : '0' }}" data-sync-url="{{ config.syncUrl|escape_url }}" data-viewed-lifetime="{{ config.viewedLifetime }}" data-compared-lifetime="{{ config.comparedLifetime }}"></div>
