{% set image = block.getLanding().getImage() %}
{% if image %}
    <div class="category-image mb-8 overflow-hidden rounded-edge bg-alabaster-raised">
        <img class="image h-auto w-full object-cover" src="{{ image.url|escape_url }}" alt="{{ image.alt|escape_html_attr }}"
             decoding="async">
    </div>
{% endif %}
