{% if block.isRssAllowed() and block.getLink() and block.isTopCategory() %}
    <p class="mb-8 print:hidden"><a href="{{ block.getLink()|escape_url }}" class="link link--meta">{{ block.getLabel() }}</a></p>
{% endif %}
