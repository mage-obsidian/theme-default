<?php
/**
 * Newsletter subscribe — OBSIDIAN dark-footer styling. Overrides the theme-base
 * placeholder (which shipped generic Tailwind indigo) for the active theme.
 *
 * @var \Magento\Newsletter\Block\Subscribe $block
 * @var \Magento\Framework\Escaper $escaper
 */
$locked = $block->getButtonLockManager()->isDisabled('newsletter_form_submit');
?>
<div class="block newsletter mt-6">
    <form class="form subscribe"
          action="<?= $escaper->escapeUrl($block->getFormActionUrl()) ?>"
          method="post"
          id="newsletter-validate-detail">
        <label class="sr-only" for="newsletter"><?= $escaper->escapeHtml(__('Sign Up for Our Newsletter:')) ?></label>
        <input name="email"
               type="email"
               id="newsletter"
               required
               placeholder="<?= $escaper->escapeHtmlAttr(__('Enter your email address')) ?>"
               class="w-full rounded-edge border border-obsidian-700 bg-transparent px-3 py-2.5 text-sm text-on-obsidian placeholder:text-on-obsidian-soft focus:border-on-obsidian focus:outline-none">
        <button type="submit"
                class="btn btn--sm btn--invert mt-3 disabled:cursor-not-allowed"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Subscribe')) ?>"
                <?= $locked ? 'disabled="disabled"' : '' ?>>
            <?= $escaper->escapeHtml(__('Subscribe')) ?>
        </button>
    </form>
</div>
