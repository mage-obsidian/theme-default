{# `block` is the native Onepage\Success block, read for the order id + URLs. #}
<div class="mx-auto w-full max-w-readable px-4 py-20 text-center md:px-8">
    {% if block.getOrderId() %}
        <p class="font-mono text-eyebrow uppercase tracking-spaced text-ink-soft">{{ __('Order confirmed') }}</p>
        <h1 class="mt-4 font-display text-4xl text-ink md:text-5xl">{{ __('Thank you for your purchase') }}</h1>
        <p class="mt-6 text-ink-soft">
            {% if block.getCanViewOrder() %}
                {{ __('Your order number is') }}
                <a href="{{ block.getViewOrderUrl()|escape_url }}" class="font-mono text-ink underline">{{ block.getOrderId() }}</a>.
            {% else %}
                {{ __('Your order number is') }} <span class="font-mono text-ink">{{ block.getOrderId() }}</span>.
            {% endif %}
        </p>
        <p class="mt-2 text-ink-soft">{{ __('We will email you an order confirmation with the details.') }}</p>

        <a href="{{ block.getContinueUrl()|escape_url }}"
           class="btn btn--solid btn--lg mt-10">
            {{ __('Continue Shopping') }}
        </a>
    {% else %}
        <h1 class="font-display text-3xl text-ink">{{ __('No order to show') }}</h1>
        <a href="{{ block.getContinueUrl()|escape_url }}" class="mt-8 inline-block font-mono text-xs uppercase tracking-label text-ink underline">{{ __('Continue Shopping') }}</a>
    {% endif %}
</div>
