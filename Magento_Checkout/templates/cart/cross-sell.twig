{# Cross-sell row. `block` is core Magento\Checkout\Block\Cart\Crosssell (an
   AbstractProduct, so the listing card renders unchanged). Same card as the
   listing: quick add for simple products, "Choose options" into the PDP for the
   rest, plus wish list and compare. The wish list heart follows the setting. #}
{% set products = block.getItems() %}
{% set wishlist = block.getParentBlock().getWishlist() %}
{% if products is not empty %}
    <section data-cart-crosssell class="mt-16 border-t border-ash-200 pt-10" aria-labelledby="cart-crosssell-heading">
        <h2 id="cart-crosssell-heading" class="mb-6 font-display text-2xl tracking-display text-ink">{{ __('You may also like') }}</h2>
        <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
            {% for product in products %}
                {% include 'Magento_Catalog::product/card.twig' with { product: product, index: loop.index0, wishlistAllowed: wishlist is not empty and wishlist.isEnabled() } %}
            {% endfor %}
        </div>
    </section>
{% endif %}
