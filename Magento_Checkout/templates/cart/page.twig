{#
  Shopping bag page. `block` is the MageObsidian Template (obsidian.cart); lines
  come from the CartItems ViewModel, summary/coupon/cross-sell from core blocks
  re-rendered by our Twig. Mutations are progressive: the native forms POST to the
  core controllers (work without JS); cart-page.js intercepts them for AJAX + a
  morph-refresh. The data-* URLs feed the enhancer the sidebar endpoints. The
  "Estimate Shipping and Tax" panel is a Vue island rendered outside the morphed
  region so a qty refresh never destroys it (same as gift options).
#}
{% import 'Magento_Theme::macros/state.twig' as state %}
{% set cartItems = block.getCartItems() %}
{% set items = cartItems.getItems() %}
{% set wishlist = block.getWishlist() %}
{% set giftOptions = block.getGiftOptions() %}
{% set checkoutConfig = block.getCheckoutConfig().getConfig() %}
{% set directory = block.getDirectoryData().getData() %}
{% set multishippingLink = block.getMultishippingLink() %}
<div
    data-cart-root
    data-update-url="{{ block.getUrl('checkout/sidebar/updateItemQty')|escape_url }}"
    data-remove-url="{{ block.getUrl('checkout/sidebar/removeItem')|escape_url }}"
    class="mx-auto w-full max-w-shell px-4 py-10 md:px-8"
>
    <div class="mb-8">{{ child_html('cart_title') }}</div>

    {% if items is empty %}
        {{ state.empty(block, {
            icon: 'shopping-bag',
            title: __('Your bag is empty'),
            body: __('Browse the collection to add something you love.'),
            cta: __('Continue shopping'),
            cta_url: block.getUrl('')
        }) }}
    {% else %}
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_360px]">
            <form action="{{ block.getUrl('checkout/cart/updatePost')|escape_url }}" method="post" data-cart-form>
                {{ block.getBlockHtml('formkey')|raw }}
                {# A transition name per line, collected into one stylesheet: an
                   enforcing policy drops a style attribute whatever the nonce,
                   and with it the animation that tells the shopper which line
                   moved. #}
                {{ style_rules(items|reduce((rules, line) => rules|merge({
                    ('[data-cart-line="' ~ line.id ~ '"]'): 'view-transition-name: cart-line-' ~ line.id
                }), {})) }}
                <ul class="divide-y divide-ash-200 border-y border-ash-200">
                    {% for item in items %}
                        <li class="flex gap-4 py-6" data-cart-line="{{ item.id }}">
                            <a href="{{ item.url|escape_url }}" class="block h-28 w-24 shrink-0 overflow-hidden rounded-edge bg-ash-100">
                                {% if item.image %}
                                    <img src="{{ item.image|escape_url }}" alt="{{ item.name|escape_html_attr }}" class="h-full w-full object-cover" loading="lazy" width="96" height="112">
                                {% endif %}
                            </a>

                            <div class="flex min-w-0 flex-1 flex-col gap-1">
                                <a href="{{ item.url|escape_url }}" class="text-base font-medium text-ink transition-colors hover:text-accent">{{ item.name }}</a>
                                {% if item.options is not empty %}
                                    <ul class="text-sm text-ink-soft">
                                        {% for option in item.options %}
                                            <li><span class="text-ash-500">{{ option.label }}:</span> {{ option.value }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                                <p class="mt-1 font-mono text-sm text-ink-soft">{{ item.price }}</p>
                                {% if item.fpt %}
                                    <p class="font-mono text-xs text-ash-500">{{ __('Fixed Product Tax') }}: {{ item.fpt }}</p>
                                {% endif %}

                                <div class="mt-auto flex items-center gap-4 pt-3">
                                    <div class="field-stepper">
                                        <button type="button" class="field-stepper__button [&_svg]:size-4" data-cart-step="-1" aria-label="{{ __('Decrease quantity')|escape_html_attr }}">
                                            {{ hero_icon('minus', 'outline', '24') }}
                                        </button>
                                        <input
                                            type="number" min="1" inputmode="numeric"
                                            name="cart[{{ item.id }}][qty]"
                                            value="{{ item.qty }}"
                                            data-cart-qty data-item-id="{{ item.id }}"
                                            class="field-stepper__input"
                                            aria-label="{{ __('Quantity')|escape_html_attr }} — {{ item.name|escape_html_attr }}"
                                        >
                                        <button type="button" class="field-stepper__button [&_svg]:size-4" data-cart-step="1" aria-label="{{ __('Increase quantity')|escape_html_attr }}">
                                            {{ hero_icon('plus', 'outline', '24') }}
                                        </button>
                                    </div>

                                    {% if item.configureUrl %}
                                        <a href="{{ item.configureUrl|escape_url }}"
                                           class="link text-sm text-ink-soft">{{ __('Edit') }}</a>
                                    {% endif %}

                                    {% if wishlist and wishlist.isAllowed() %}
                                        <button
                                            type="submit"
                                            formaction="{{ wishlist.getMoveUrl()|escape_url }}"
                                            name="item" value="{{ item.id }}"
                                            data-cart-move data-item-id="{{ item.id }}" data-move-url="{{ wishlist.getMoveUrl()|escape_url }}"
                                            class="link text-sm text-ink-soft"
                                        >{{ __('Move to wish list') }}</button>
                                    {% endif %}

                                    <button
                                        type="submit"
                                        formaction="{{ block.getUrl('checkout/cart/delete')|escape_url }}"
                                        name="id" value="{{ item.id }}"
                                        data-cart-remove data-item-id="{{ item.id }}"
                                        class="link text-sm text-ash-500"
                                    >{{ __('Remove') }}</button>
                                </div>
                            </div>

                            <p class="shrink-0 font-mono text-base text-ink">{{ item.rowTotal }}</p>
                        </li>
                    {% endfor %}
                </ul>

                <div class="mt-6 flex items-center justify-between gap-4">
                    <a href="{{ cartItems.getContinueShoppingUrl()|escape_url }}" class="font-mono text-xs uppercase tracking-label text-ink-soft transition-colors hover:text-ink">{{ __('Continue shopping') }}</a>
                    {# No-JS quantity update; cart-page.js makes the steppers live and hides this. #}
                    <button type="submit" class="btn btn--outline btn--sm" data-cart-update>{{ __('Update bag') }}</button>
                </div>
            </form>

            <aside class="flex flex-col gap-6">
                <div class="cart-summary rounded-edge border border-ash-200 bg-alabaster-raised p-6">
                    {{ child_html('totals') }}
                    <a href="{{ block.getUrl('checkout')|escape_url }}" class="btn btn--solid btn--block mt-6">
                        {{ __('Proceed to checkout') }}
                    </a>
                    {% if multishippingLink and multishippingLink.isAvailable() %}
                        <a href="{{ multishippingLink.getCheckoutUrl()|escape_url }}" class="mt-3 inline-flex w-full items-center justify-center font-mono text-xs uppercase tracking-eyebrow text-ink-soft underline-offset-4 transition-colors hover:text-ink hover:underline">
                            {{ __('Check Out with Multiple Addresses') }}
                        </a>
                    {% endif %}
                </div>
                {{ child_html('coupon') }}
            </aside>
        </div>

        {{ child_html('crosssell') }}
    {% endif %}
</div>

{# "Estimate Shipping and Tax" — island outside the morphed region (a qty refresh
   replaces [data-cart-root] wholesale, which would otherwise unmount it). Aligned
   to the summary column. Previews rates + totals via REST without touching the
   persisted quote — the binding selection happens at checkout. #}
{% if items is not empty %}
    <div class="shell">
        <div class="lg:ml-auto lg:w-[360px]">
            {{ render_vue('MageObsidian_Checkout::components/cart/ShippingEstimator', {
                config: {
                    restBaseUrl: checkoutConfig.restBaseUrl,
                    isLoggedIn: checkoutConfig.isLoggedIn,
                    maskedCartId: checkoutConfig.maskedCartId
                },
                directory: directory,
                currencyFormat: checkoutConfig.currencyFormat,
                labels: {
                    panel: __('Estimate Shipping and Tax'),
                    country: __('Country'),
                    region: __('State / Province'),
                    regionPlaceholder: __('Please select a region'),
                    postcode: __('ZIP / Postal code'),
                    estimate: __('Estimate'),
                    loading: __('Loading…'),
                    methodsHeading: __('Shipping method'),
                    noRates: __('No quotes are available for this address.'),
                    free: __('Free')
                }
            }, true) }}
        </div>
    </div>
{% endif %}

{# Gift options live OUTSIDE the morphed cart region: the island mounts once and
   posts straight to the gift-message REST endpoints, so a qty refresh never
   destroys it. Gift messages have no no-JS path (neither does Luma — the API is
   REST-only), hence the <noscript> note. #}
{% if items is not empty and giftOptions and giftOptions.isAvailable() %}
    {% set giftItems = [] %}
    {% for item in items %}
        {% set giftItems = giftItems|merge([{ id: item.id, name: item.name, message: giftOptions.getItemMessage(item.id) }]) %}
    {% endfor %}
    <div class="shell">
        {{ render_vue('MageObsidian_GiftMessage::components/gift/GiftOptions', {
            orderAllowed: giftOptions.isOrderAllowed(),
            itemsAllowed: giftOptions.isItemsAllowed(),
            endpoint: giftOptions.getEndpointConfig(),
            orderMessage: giftOptions.getOrderMessage(),
            items: giftItems,
            panelLabel: __('Gift options'),
            orderTitle: __('Gift message for the whole order'),
            itemsTitle: __('Gift message per item'),
            fromLabel: __('From'),
            toLabel: __('To'),
            messageLabel: __('Message'),
            saveLabel: __('Save gift message'),
            savedLabel: __('Saved'),
            failLabel: __('Could not save gift message')
        }, true) }}
        <noscript>
            <p class="mt-4 text-sm text-ink-soft">{{ __('Enable JavaScript to add a gift message.') }}</p>
        </noscript>
    </div>
{% endif %}

{# Progressive enhancer (outside the morphed region so a refresh never re-runs it).
   Without JS the native forms POST to the core cart controllers. #}
{{ script('MageObsidian_Checkout::js/cart-page') }}
