{# Discount code. `block` is core Magento\Checkout\Block\Cart\Coupon. Native form
   POST to checkout/cart/couponPost (apply with a code, or remove=1); cart-page.js
   intercepts it for an AJAX morph-refresh. #}
{% set code = block.getCouponCode() %}
<form action="{{ block.getUrl('checkout/cart/couponPost')|escape_url }}" method="post" data-cart-coupon class="rounded-edge border border-ash-200 bg-alabaster-raised p-6">
    {{ block.getBlockHtml('formkey')|raw }}
    {% if code %}
        <input type="hidden" name="remove" value="1">
        <p class="mb-3 font-mono text-xs uppercase tracking-mono text-ink-soft">
            {{ __('Code applied') }}: <span class="text-ink">{{ code }}</span>
        </p>
        <button type="submit" class="link link--meta tracking-label text-ash-500">{{ __('Remove discount') }}</button>
    {% else %}
        <input type="hidden" name="remove" value="0">
        <label for="coupon_code" class="mb-2 block font-mono text-xs uppercase tracking-mono text-ink-soft">{{ __('Discount code') }}</label>
        <div class="flex items-stretch gap-2">
            <input type="text" id="coupon_code" name="coupon_code" value="" autocomplete="off" class="field__control min-w-0 flex-1">
            <button type="submit" class="btn btn--outline btn--sm shrink-0">{{ __('Apply') }}</button>
        </div>
    {% endif %}
</form>
