{# `block` is the native Onepage\Failure block, read for the real order id, the
   gateway error message, and the continue-shopping URL. #}
<div class="mx-auto w-full max-w-readable px-4 py-20 text-center md:px-8">
    <p class="font-mono text-eyebrow uppercase tracking-spaced text-danger">{{ __('Payment failed') }}</p>
    <h1 class="mt-4 font-display text-4xl text-ink md:text-5xl">{{ __('The order was not successful') }}</h1>

    {% if block.getRealOrderId() %}
        <p class="mt-6 text-ink-soft">{{ __('Order #') }} <span class="font-mono text-ink">{{ block.getRealOrderId() }}</span></p>
    {% endif %}

    {% if block.getErrorMessage() %}
        <p class="form-banner mt-4">{{ block.getErrorMessage() }}</p>
    {% endif %}

    <p class="mt-6 text-ink-soft">{{ __('Your order could not be placed. No charge was completed; please try again or use a different payment method.') }}</p>

    <a href="{{ block.getContinueShoppingUrl()|escape_url }}"
       class="btn btn--solid btn--lg mt-10">
        {{ __('Continue Shopping') }}
    </a>
</div>
