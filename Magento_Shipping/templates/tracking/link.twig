{% set order = block.getOrder() %}
{% if order and order.getTracksCollection().getSize() > 0 %}
    <a href="{{ block.getWindowUrl(order)|escape_url }}" target="_blank" rel="noopener" class="link link--meta print:hidden">{{ block.getLabel() }}</a>
{% endif %}
