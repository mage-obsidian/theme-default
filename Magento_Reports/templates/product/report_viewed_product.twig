{% set view = block.getBeacons().productView() %}
{% if view %}
    <div hidden data-report-beacon="product-view" data-url="{{ view.url|escape_url }}" data-product-id="{{ view.productId|escape_html_attr }}"></div>
    {{ script('MageObsidian_Catalog::js/report-beacons') }}
{% endif %}
