{# "My Downloadable Products" account page. `block` is the MageObsidian Template
   (account_content); `list` is our subclass of the core Customer\Products\ListProducts
   (purchased links, statuses, download URLs) — it also owns the pager that
   page-sizes the collection, hence the child html at the foot. One row per
   purchased link; the download action shows only while the link is available. No JS. #}
{% import 'Magento_Theme::macros/account.twig' as account %}

{% set list = block.getChildBlock('list') %}
{% set items = list.getItems() %}

{# Rendered before the table, printed after it: a pager built once the collection
   is loaded can read back the rows in hand as the total and conclude there is
   nothing to page to. #}
{% set pager = list.getChildHtml('pager') %}

{{ account.page_header({
    eyebrow: __('Account'),
    title: __('My Downloadable Products')
}) }}

{% if items is empty %}
    <div class="mt-8">
        {{ account.empty_state(block, {
            icon: 'arrow-down-tray',
            title: __('Nothing to download yet'),
            body: __('Digital purchases land here the moment their order is paid.')
        }) }}
    </div>
{% else %}
    {% set table %}
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
                <caption class="sr-only">{{ __('Downloadable Products') }}</caption>
                <thead>
                    <tr class="border-b border-ash-300 text-left table-label">
                        <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('Order #') }}</th>
                        <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('Date') }}</th>
                        <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('Title') }}</th>
                        <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('Status') }}</th>
                        <th scope="col" class="py-3 text-right font-mono font-normal">{{ __('Remaining Downloads') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in items %}
                        {% set purchased = item.getPurchased() %}
                        {% set available = item.getStatus() == 'available' %}
                        <tr class="border-b border-ash-100 align-top">
                            <td class="py-3 pr-4">
                                <a href="{{ list.getOrderViewUrl(purchased.getOrderId())|escape_url }}" class="link text-ink">{{ purchased.getOrderIncrementId() }}</a>
                            </td>
                            <td class="py-3 pr-4 text-ink-soft">{{ list.formatDate(purchased.getCreatedAt()) }}</td>
                            <td class="py-3 pr-4 text-ink">
                                <span>{{ purchased.getProductName() }}</span>
                                {% if available %}
                                    <a href="{{ list.getDownloadUrl(item)|escape_url }}"
                                       class="link mt-1 block text-sm text-accent"
                                       {% if list.getIsOpenInNewWindow() %}target="_blank" rel="noopener"{% endif %}>
                                        {{ item.getLinkTitle() }}
                                    </a>
                                {% endif %}
                            </td>
                            <td class="py-3 pr-4">{{ account.chip(__(item.getStatus()|capitalize), available ? 'good' : 'dead') }}</td>
                            <td class="py-3 text-right font-mono text-ink">{{ list.getRemainingDownloads(item) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endset %}
    <div class="mt-8">{{ account.panel({ title: __('Purchases'), content: table }) }}</div>

    <div class="mt-10">{{ pager|raw }}</div>
{% endif %}
