{% from 'Magento_Review::review/stars.twig' import stars %}
{% set product = block.getProductData() %}
{% set review = block.getReviewData() %}

<div class="account-review-view">
    <a href="{{ block.getBackUrl()|escape_url }}" class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ink-soft underline">{{ __('Back to My Reviews') }}</a>

    <h1 class="mt-4 font-display text-3xl text-ink">{{ product.getName() }}</h1>

    {% set ratings = block.getRating() %}
    {% if ratings and ratings.getSize() %}
        <dl class="mt-6 flex flex-col gap-3">
            {% for rating in ratings %}
                <div class="flex items-center gap-4">
                    <dt class="w-40 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-ink-soft">{{ rating.getRatingCode() }}</dt>
                    <dd>{{ stars(rating.getPercent(), __('%1 out of 5 stars', (rating.getPercent() / 20)|round(1))) }}</dd>
                </div>
            {% endfor %}
        </dl>
    {% endif %}

    <h2 class="mt-8 font-display text-xl text-ink">{{ review.getTitle() }}</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">{{ review.getDetail() }}</p>
    <footer class="mt-4 font-mono text-[0.66rem] uppercase tracking-[0.14em] text-ink-soft">
        {{ review.getNickname() }} · {{ block.dateFormat(review.getCreatedAt()) }}
    </footer>
</div>
