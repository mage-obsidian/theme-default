{#
  Reusable star-rating display. Renders five outline stars with a gold fill
  clipped to `percent` (0–100), so fractional ratings show precisely. Accessible
  as a single image with a textual label; the glyphs are decorative.
  Styling: see module-review's module.extend.css (.obsidian-stars*), which also
  carries one width class per whole percent so the fill needs no style attribute.
#}
{% macro stars(percent, label) %}
    <span class="obsidian-stars" role="img" aria-label="{{ label }}">
        <span class="obsidian-stars__track" aria-hidden="true">★★★★★</span>
        <span class="obsidian-stars__fill obsidian-stars__fill--{{ percent|default(0)|round }}" aria-hidden="true">★★★★★</span>
    </span>
{% endmacro %}
