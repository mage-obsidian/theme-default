{#
  PDP reviews section: approved-review list, the submit form (progressive — a
  native POST to review/product/post, enhanced into interactive stars), and the
  aggregateRating/review JSON-LD the engine intentionally leaves out.

  `block` is a MageObsidian Template carrying the ProductReviews ViewModel; its
  `form` child is the core Block\Form, read for the rating types and post action.
#}
{% from 'Magento_Review::review/stars.twig' import stars %}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set reviews = block.getReviews() %}
{% set reviewForm = block.getChildBlock('form') %}
{% set count = reviews.getCount() %}

<section id="reviews" class="pdp__reviews mt-16 border-t border-ash-200 pt-12" aria-labelledby="reviews-title">
    <div class="mx-auto max-w-shell">
        <header class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 id="reviews-title" class="font-display text-xl text-ink">{{ __('Reviews') }}</h2>
            {% if count > 0 %}
                <div class="flex items-center gap-2">
                    {{ stars(reviews.getAveragePercent(), __('%1 out of 5 stars', reviews.getAverageStars())) }}
                    <span class="font-mono text-eyebrow text-ink-soft">{{ __('%1 of 5 · %2 review(s)', reviews.getAverageStars(), count) }}</span>
                </div>
            {% endif %}
        </header>

        {% if reviews.hasReviews() %}
            <ol class="reviews-list mt-8 grid gap-8 sm:grid-cols-2" role="list">
                {% for review in reviews.getItems() %}
                    <li class="review rounded-edge border border-ash-200 bg-alabaster-raised p-6">
                        {{ stars(review.percent, __('%1 out of 5 stars', (review.percent / 20)|round(1))) }}
                        <h3 class="mt-3 font-display text-base text-ink">{{ review.title }}</h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-soft">{{ review.detail }}</p>
                        <footer class="mt-4 font-mono text-micro uppercase tracking-eyebrow text-ink-soft">
                            {{ review.nickname }} · {{ review.created_at|slice(0, 10) }}
                        </footer>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <p class="mt-6 font-mono text-sm text-ink-soft">{{ __('No reviews yet. Be the first to share your thoughts.') }}</p>
        {% endif %}

        <div class="review-form mt-12 max-w-2xl">
            <h3 class="font-display text-lg text-ink">{{ __('Write a review') }}</h3>
            <form method="post" action="{{ reviewForm.getAction()|escape_url }}" class="mt-6 flex flex-col gap-5"
                  data-review-form data-err-required="{{ __('This is a required field.')|escape_html_attr }}">
                {{ block.getBlockHtml('formkey')|raw }}

                {% set ratings = reviewForm.getRatings() %}
                {% if ratings and ratings.getSize() %}
                    <div class="flex flex-col gap-4">
                        {% for rating in ratings %}
                            <fieldset class="review-rating border-0 p-0" role="radiogroup" aria-label="{{ rating.getRatingCode() }}">
                                <legend class="eyebrow">{{ rating.getRatingCode() }}</legend>
                                <div class="review-rating__stars mt-2">
                                    {% for option in rating.getOptions()|reverse %}
                                        {% set inputId = 'rating-' ~ rating.getId() ~ '-' ~ option.getValue() %}
                                        <input class="review-rating__input sr-only" type="radio"
                                               id="{{ inputId }}" name="ratings[{{ rating.getId() }}]"
                                               value="{{ option.getId() }}" required>
                                        <label class="review-rating__star" for="{{ inputId }}">
                                            <span class="sr-only">{{ __('%1 stars', option.getValue()) }}</span>
                                            <span aria-hidden="true">★</span>
                                        </label>
                                    {% endfor %}
                                </div>
                            </fieldset>
                        {% endfor %}
                    </div>
                {% endif %}

                {{ form.field({
                    name: 'nickname',
                    id: 'review-nickname',
                    label: __('Nickname'),
                    required: true
                }) }}
                {{ form.field({
                    name: 'title',
                    id: 'review-title',
                    label: __('Summary'),
                    required: true
                }) }}
                {{ form.field({
                    name: 'detail',
                    id: 'review-detail',
                    label: __('Review'),
                    type: 'textarea',
                    required: true,
                    attrs: { rows: 4 }
                }) }}

                {{ form.required_note(__('Required fields')) }}

                <button type="submit" class="action submit btn btn--solid btn--lg w-fit">
                    {{ __('Submit Review') }}
                </button>
            </form>
        </div>
    </div>

    {# No Product node here. The engine emits exactly one per page from
       CurrentPageSchemaProvider, rating and reviews included; a second one makes
       search engines pick between two partial descriptions of the same product. #}

    {{ script('MageObsidian_Review::js/review-form') }}
</section>
