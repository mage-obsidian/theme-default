{# Cookie-restriction (e-Privacy) consent banner. `block` is a MageObsidian
   Template; `notice` is the CookieNotice VM (self-gates on restriction mode).
   Rendered hidden — the cookie-notice enhancer reveals it only when the consent
   cookie is absent, and on "Allow" writes `user_allowed_save_cookie` with the
   accepted website ids (the value Magento's server read-path expects). #}
{% set notice = block.getCookieNotice() %}
{% if notice.isEnabled() %}
    <div
        id="notice-cookie-block"
        role="alertdialog"
        aria-labelledby="cookie-notice-title"
        tabindex="-1"
        hidden
        data-cookie-notice
        data-cookie-name="{{ notice.getCookieName() }}"
        data-cookie-value="{{ notice.getWebsiteIdsJson() }}"
        data-cookie-lifetime="{{ notice.getLifetime() }}"
        data-no-cookies-url="{{ notice.getNoCookiesUrl()|escape_url }}"
        class="fixed inset-x-0 bottom-0 z-50 border-t border-ash-200 bg-alabaster-raised/95 backdrop-blur-sm print:hidden"
    >
        <div class="mx-auto flex w-full max-w-shell flex-col gap-4 px-4 py-5 md:flex-row md:items-center md:justify-between md:px-8">
            <div class="max-w-[80ch] text-sm text-ink-soft">
                <strong id="cookie-notice-title" class="font-mono text-xs uppercase tracking-eyebrow text-ink">{{ __('We use cookies to make your experience better.') }}</strong>
                <span class="ml-1">{{ __('To comply with the e-Privacy directive, we need your consent to set cookies.') }}</span>
                <a href="{{ notice.getPrivacyUrl()|escape_url }}" class="link underline">{{ __('Read our Privacy and Cookie Policy') }}</a>
            </div>
            <button
                type="button"
                data-cookie-allow
                class="btn btn--solid btn--sm w-fit shrink-0"
            >
                {{ __('Allow Cookies') }}
            </button>
        </div>
    </div>

    {{ script('MageObsidian_Storefront::js/cookie-notice') }}
{% endif %}
