{
  "name": "@mage-obsidian/theme-default-e2e",
  "version": "0.1.0",
  "description": "End-to-end suite for the OBSIDIAN account area, authentication and header navigation.",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "zento compose exec -T php-noxdebug php app/design/frontend/MageObsidian/default/tests/e2e/tools/seed.php",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test '{tools,src}/**/*.test.ts'",
    "parity:handles": "node tools/parity/extract.ts",
    "map": "node tools/report/map.ts",
    "verify": "node tools/ci/verify.ts",
    "verify:gate": "node tools/ci/verify.ts --gate",
    "competitive:compare": "node tools/competitive/compare.ts",
    "competitive:verify": "node tools/competitive/verify.ts",
    "security:unescaped": "node tools/security/audit-unescaped.ts",
    "security:classify": "node tools/security/classify.ts",
    "security:environment": "zento compose exec -T php-noxdebug php app/design/frontend/MageObsidian/default/tests/e2e/tools/security/environment.php > .artifacts/environment.json && node -e \"console.log(require('fs').readFileSync('.artifacts/environment.json','utf8'))\"",
    "perf:measure": "PERF=1 PERF_RUN=baseline playwright test --project=perf",
    "perf:queries": "node tools/perf/measure-queries.ts",
    "perf:record": "node tools/perf/record-budgets.ts",
    "perf:verify": "node tools/perf/verify-budgets.ts",
    "registry:generate": "node tools/registry/generate.ts",
    "registry:verify": "node tools/registry/verify.ts",
    "emails:send": "zento compose exec -T php-noxdebug php app/design/frontend/MageObsidian/default/tests/e2e/tools/emails/send.php",
    "emails:verify": "zento compose exec -T php-noxdebug php app/design/frontend/MageObsidian/default/tests/e2e/tools/emails/verify.php"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
