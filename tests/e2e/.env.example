# Storefront under test.
E2E_BASE_URL=https://zento-obsidian.test

# The account tools/seed.php creates.
E2E_EMAIL=e2e@obsidian.test

# Leave this empty. The seed mints a fresh password on every run and hands it to
# the suite through .artifacts/fixture.json, which git ignores — nothing about the
# fixture account belongs in the repository. Set it only to pin your own account,
# and pass it through to the container:
#   zento compose exec -e E2E_PASSWORD=... php-noxdebug php .../tools/seed.php
E2E_PASSWORD=
