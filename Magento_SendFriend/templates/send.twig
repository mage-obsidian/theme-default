{# "Email to a Friend" form. `block` is the core Block\Send: post URL, prefilled
   sender, max recipients. The first recipient is required; the rest sit in a
   native disclosure and are ignored when blank. Native POST — works with no JS. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set maxRecipients = block.getMaxRecipients() ?: 1 %}

<div class="mx-auto w-full max-w-readable px-4 py-12 md:px-8">
    <h1 class="page-heading">{{ __('Email to a Friend') }}</h1>

    <form action="{{ block.getSendUrl()|escape_url }}" method="post" class="mt-8 flex flex-col gap-8" data-busy-submit>
        {{ block.getBlockHtml('formkey')|raw }}

        <fieldset class="flex flex-col gap-5">
            <legend class="field__label mb-2">{{ __('Sender') }}</legend>
            {{ form.field({
                name: 'sender[name]',
                label: __('Name'),
                value: block.getUserName(),
                required: true,
                autocomplete: 'name'
            }) }}
            {{ form.field({
                name: 'sender[email]',
                label: __('Email'),
                type: 'email',
                value: block.getEmail(),
                required: true,
                autocomplete: 'email'
            }) }}
            {{ form.field({
                name: 'sender[message]',
                label: __('Message'),
                type: 'textarea',
                value: block.getMessage(),
                required: true,
                attrs: { rows: 3 }
            }) }}
        </fieldset>

        <fieldset class="flex flex-col gap-4">
            <legend class="field__label mb-2">{{ __('Invitee') }}</legend>
            <div class="grid gap-5 sm:grid-cols-2">
                {{ form.field({
                    name: 'recipients[name][0]',
                    label: __('Name'),
                    required: true
                }) }}
                {{ form.field({
                    name: 'recipients[email][0]',
                    label: __('Email'),
                    type: 'email',
                    required: true
                }) }}
            </div>
            {% if maxRecipients > 1 %}
                <details class="flex flex-col gap-4">
                    <summary class="link link--meta cursor-pointer">{{ __('Add more recipients (up to %1)', maxRecipients) }}</summary>
                    {% for index in 1..(maxRecipients - 1) %}
                        <div class="mt-4 grid gap-5 sm:grid-cols-2">
                            {{ form.field({
                                name: 'recipients[name][' ~ index ~ ']',
                                label: __('Name')
                            }) }}
                            {{ form.field({
                                name: 'recipients[email][' ~ index ~ ']',
                                label: __('Email'),
                                type: 'email'
                            }) }}
                        </div>
                    {% endfor %}
                </details>
            {% endif %}
        </fieldset>

        {# The reCAPTCHA slot, when the store configured one for this form. #}
        {{ child_html('recaptcha') }}

        {{ form.required_note(__('Required fields')) }}

        <div>
            <button type="submit" {% if not block.canSend() %}disabled{% endif %} class="btn btn--solid px-8">{{ __('Send Email') }}</button>
        </div>
    </form>
</div>
{{ script('MageObsidian_Storefront::js/form-busy') }}
