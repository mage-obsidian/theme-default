{# Cross-navigation between an order and its sub-documents, mirroring Magento's
   sales.order.info.links. `order_id` and `current` come from the including
   template. All four links always render: core shows them and the controllers
   redirect back to the order when a document type is empty. #}
{% set order_id = order_id|default(null) %}
{% set current = current|default('view') %}
{% set route_prefix = route_prefix|default('sales/order') %}
{% set tabs = [
    { 'key': 'view',       'path': route_prefix ~ '/view',       'label': __('Items Ordered') },
    { 'key': 'invoice',    'path': route_prefix ~ '/invoice',    'label': __('Invoices') },
    { 'key': 'shipment',   'path': route_prefix ~ '/shipment',   'label': __('Order Shipments') },
    { 'key': 'creditmemo', 'path': route_prefix ~ '/creditmemo', 'label': __('Refunds') }
] %}
<nav class="order-links mt-8 border-b border-ash-200 print:hidden" aria-label="{{ __('Order navigation')|escape_html_attr }}">
    <ul class="-mb-px flex flex-wrap gap-6">
        {% for tab in tabs %}
            <li>
                {% if tab.key == current %}
                    <span aria-current="page" class="inline-block border-b-2 border-ink pb-3 font-mono text-xs uppercase tracking-eyebrow text-ink">{{ tab.label }}</span>
                {% else %}
                    <a href="{{ block.getUrl(tab.path, { 'order_id': order_id })|escape_url }}"
                       class="inline-block border-b-2 border-transparent pb-3 font-mono text-xs uppercase tracking-eyebrow text-ink-soft transition-colors hover:border-ash-300 hover:text-ink">{{ tab.label }}</a>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>
