{# Per-item option lines (custom options, configurable attributes, additional
   options) and bundle selection children, shown under the product name in the
   order/invoice/credit-memo/shipment tables. `item_options` is the ItemOptions
   ViewModel; `order` formats child prices in the store currency.
   `downloadable_links` is an OPTIONAL ViewModel contributed by MageObsidian_
   Downloadable on the order/invoice host blocks — absent (null) elsewhere. #}
{% set options = item_options.getOptions(item) %}
{% set children = item_options.getChildren(item) %}
{% set downloadable = block.getDownloadableLinks() %}
{% set links = downloadable ? downloadable.getLinks(item) : [] %}
{# Fixed Product Tax (WEEE) applied to the line; hidden on shipments (no price). #}
{% set fpt = show_price|default(true) ? item.getWeeeTaxAppliedRowAmount() : 0 %}
{% if options is not empty or children is not empty or links is not empty or fpt > 0 %}
    <dl class="mt-1.5 space-y-0.5 text-xs text-ink-soft">
        {% for option in options %}
            <div class="flex gap-1.5">
                <dt class="text-ash-500">{{ option.label }}:</dt>
                <dd>{{ option.value }}</dd>
            </div>
        {% endfor %}
        {% for child in children %}
            <div class="flex gap-1.5">
                <dt class="text-ash-500">{{ child.qty|round }} ×</dt>
                <dd>{{ child.name }}{% if child.price and show_price|default(true) %} — {{ order.formatPrice(child.price)|raw }}{% endif %}</dd>
            </div>
        {% endfor %}
        {% if links is not empty %}
            <div class="flex gap-1.5">
                <dt class="text-ash-500">{{ downloadable.getTitle() }}:</dt>
                <dd>{{ links|join(', ') }}</dd>
            </div>
        {% endif %}
        {% if fpt > 0 %}
            <div class="flex gap-1.5">
                <dt class="text-ash-500">{{ __('Fixed Product Tax') }}:</dt>
                <dd>{{ order.formatPrice(fpt)|raw }}</dd>
            </div>
        {% endif %}
    </dl>
{% endif %}
