{% if block.hasComments() %}
    <div class="mt-4 document-comments">
        <h3 class="table-label">{{ block.getTitle() }}</h3>
        <dl class="mt-2 space-y-3 text-sm">
            {% for entry in block.getComments() %}
                <div>
                    <dt class="text-ink-soft">{{ entry.getCreatedAt()|date_format('long') }}</dt>
                    <dd class="text-ink">{{ entry.getComment() }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>
{% endif %}
