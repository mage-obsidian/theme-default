{# Order detail. Data sources: `view` (Order\View, payment HTML), `items`
   (Order\Items), `totals` (Order\Totals), `info` (Order\Info, formatted
   addresses), `order_presentation` (chip tone + fulfilment track). No JS. #}
{% import 'Magento_Theme::macros/account.twig' as account %}

{% set view = block.getChildBlock('view') %}
{% set items = block.getChildBlock('items') %}
{% set info = block.getChildBlock('info') %}
{% set order = view.getOrder() %}
{% set billing = order.getBillingAddress() %}
{% set shipping = order.getShippingAddress() %}
{% set presentation = block.getOrderPresentation() %}
{# route_prefix/is_guest let the same template serve the guest order area
   (sales/guest/*, standalone, no account shell). They default to the customer
   routes when the handle does not set them. #}
{% set route_prefix = block.getData('route_prefix')|default('sales/order') %}
{% set is_guest = block.getData('is_guest')|default(false) %}
{# Order cancellation (2.4.8) is customer-only and config-gated; the handle only
   sets `cancellation` on the customer view, not guest/print. #}
{% set cancellation = block.getCancellation() %}
{% set itemOptions = block.getItemOptions() %}
{# Gift message display is a MageObsidian enhancement (Luma shows it only in admin
   and the cart); the VM is injected by Magento_GiftMessage's layout when present. #}
{% set giftMessage = block.getGiftMessage() %}
{% set orderGift = giftMessage ? giftMessage.getOrderMessage(order) : null %}

{# Three handles render this template (customer, guest, print); `presentation` is
   guarded so a handle that does not inject it degrades to no chip and no track
   instead of a fatal. #}
{% set statusChip %}
    {%- if presentation -%}
        {{ account.chip(order.getStatusLabel(), presentation.getStateTone(order)) }}
    {%- endif -%}
{% endset %}
{{ account.page_header({
    eyebrow: order.getCreatedAt()|date_format('long'),
    title: __('Order') ~ ' #' ~ order.getRealOrderId(),
    action: statusChip
}) }}

{% if presentation and presentation.isTrackable(order) %}
    {% set trackLabels = {
        received: __('Received'),
        processing: __('Preparing'),
        shipped: __('Shipped'),
        delivered: __('Delivered')
    } %}
    {% set steps = [] %}
    {% for step in presentation.getTrack(order) %}
        {% set steps = steps|merge([{ label: trackLabels[step.key], state: step.state }]) %}
    {% endfor %}
    <div class="mt-8 print:hidden">{{ account.order_track(steps) }}</div>
{% endif %}

{% include 'Magento_Sales::order/info/links.twig' with { 'order_id': order.getId(), 'current': 'view', 'route_prefix': route_prefix } %}

{% if orderGift and orderGift.message %}
    {% set giftBody %}
        <dl class="grid gap-1 text-sm sm:grid-cols-[auto_1fr] sm:gap-x-4">
            <dt class="text-ink-soft">{{ __('From') }}</dt><dd class="text-ink">{{ orderGift.sender }}</dd>
            <dt class="text-ink-soft">{{ __('To') }}</dt><dd class="text-ink">{{ orderGift.recipient }}</dd>
            <dt class="text-ink-soft">{{ __('Message') }}</dt><dd class="text-ink">{{ orderGift.message }}</dd>
        </dl>
    {% endset %}
    <div class="mt-8">{{ account.panel({ title: __('Gift Message'), content: giftBody }) }}</div>
{% endif %}

{% set itemsBody %}
    <div class="overflow-x-auto">
        <table class="w-full border-collapse text-sm">
            <caption class="sr-only">{{ __('Items Ordered') }}</caption>
            <thead>
                <tr class="border-b border-ash-300 text-left">
                    <th scope="col" class="account-stat__label py-3 pr-4 font-normal">{{ __('Product') }}</th>
                    <th scope="col" class="account-stat__label py-3 pr-4 font-normal">{{ __('SKU') }}</th>
                    <th scope="col" class="account-stat__label py-3 pr-4 text-right font-normal">{{ __('Price') }}</th>
                    <th scope="col" class="account-stat__label py-3 pr-4 text-right font-normal">{{ __('Qty') }}</th>
                    <th scope="col" class="account-stat__label py-3 text-right font-normal">{{ __('Subtotal') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items.getItems() %}
                    {% if not item.getParentItem() %}
                        <tr class="border-b border-ash-100 align-top">
                            <td class="py-3 pr-4 text-ink">
                                {{ item.getName() }}
                                {% include 'Magento_Sales::order/items/item-options.twig' with { item: item, item_options: itemOptions, order: order } %}
                            </td>
                            <td class="py-3 pr-4 text-ink-soft">{{ item.getSku() }}</td>
                            <td class="py-3 pr-4 text-right text-ink">{{ order.formatPrice(item.getPrice())|raw }}</td>
                            <td class="py-3 pr-4 text-right text-ink">{{ item.getQtyOrdered()|round }}</td>
                            <td class="py-3 text-right text-ink">{{ order.formatPrice(item.getRowTotal())|raw }}</td>
                        </tr>
                    {% endif %}
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="mt-6 flex justify-end">{{ child_html('totals')|raw }}</div>
{% endset %}
<div class="mt-8">{{ account.panel({ title: __('Items Ordered'), content: itemsBody }) }}</div>

<div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {% if billing %}
        {% set billingBody %}<address class="text-sm not-italic leading-relaxed text-ink-soft">{{ info.getFormattedAddress(billing)|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Billing Address'), content: billingBody }) }}
    {% endif %}
    {% if shipping %}
        {% set shippingBody %}<address class="text-sm not-italic leading-relaxed text-ink-soft">{{ info.getFormattedAddress(shipping)|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Shipping Address'), content: shippingBody }) }}
    {% endif %}
    {% set paymentBody %}<p class="text-sm text-ink-soft">{{ order.getPayment().getMethodInstance().getTitle() }}</p>{% endset %}
    {{ account.panel({ title: __('Payment Method'), content: paymentBody }) }}
    {% if shipping and order.getShippingDescription() %}
        {% set methodBody %}<p class="text-sm text-ink-soft">{{ order.getShippingDescription() }}</p>{% endset %}
        {{ account.panel({ title: __('Shipping Method'), content: methodBody }) }}
    {% endif %}
</div>

<div class="mt-10 flex flex-wrap items-center gap-5 print:hidden">
    <form action="{{ block.getUrl(route_prefix ~ '/reorder', {'order_id': order.getId()})|escape_url }}" method="post" class="inline" data-busy-submit>
        {{ block.getBlockHtml('formkey')|raw }}
        <button type="submit" class="btn btn--solid">{{ __('Reorder') }}</button>
    </form>
    <a href="{{ block.getUrl(route_prefix ~ '/print', {'order_id': order.getId()})|escape_url }}" class="link link--meta">{{ __('Print Order') }}</a>
    {% if not is_guest %}
        {% include 'Magento_Sales::account/cancel-order.twig' %}
    {% endif %}
    {% if is_guest %}
        <a href="{{ block.getUrl('sales/guest/form')|escape_url }}" class="link link--meta">{{ __('Back to Order Lookup') }}</a>
    {% else %}
        <a href="{{ block.getUrl('sales/order/history')|escape_url }}" class="link link--meta">{{ __('Back to My Orders') }}</a>
    {% endif %}
</div>
{{ script('MageObsidian_Storefront::js/form-busy') }}
