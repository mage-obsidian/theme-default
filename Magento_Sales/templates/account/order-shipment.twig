{# Customer shipment view. Data source: `shipment` (Shipping\Block\Order\Shipment)
   giving the order and its shipment collection (with tracking); `info` for
   addresses. One table per shipment with shipped quantities and tracking
   numbers, mirroring Magento_Shipping::items.phtml. No prices on a shipment. #}
{% import 'Magento_Theme::macros/account.twig' as account %}
{% set shipmentBlock = block.getChildBlock('shipment') %}
{% set info = block.getChildBlock('info') %}
{% set order = shipmentBlock.getOrder() %}
{% set itemOptions = block.getItemOptions() %}
{% set billing = order.getBillingAddress() %}
{% set shipping = order.getShippingAddress() %}
{% set route_prefix = block.getData('route_prefix')|default('sales/order') %}
{% set is_guest = block.getData('is_guest')|default(false) %}
{% set presentation = block.getOrderPresentation() %}

{% set statusChip %}
    {%- if presentation -%}
        {{ account.chip(order.getStatusLabel(), presentation.getStateTone(order)) }}
    {%- endif -%}
{% endset %}
{{ account.page_header({
    eyebrow: order.getCreatedAt()|date_format('long'),
    title: __('Order #%1', order.getRealOrderId()),
    action: statusChip
}) }}

{% include 'Magento_Sales::order/info/links.twig' with { 'order_id': order.getId(), 'current': 'shipment', 'route_prefix': route_prefix } %}

{% for shipment in order.getShipmentsCollection() %}
    <section class="account-panel mt-6">
        <div class="account-panel__head">
            <h2 class="account-panel__title">{{ __('Shipment #%1', shipment.getIncrementId()) }}</h2>
            <a href="{{ shipmentBlock.getPrintShipmentUrl(shipment)|escape_url }}" target="_blank" rel="noopener"
               class="link link--meta print:hidden">{{ __('Print Shipment') }}</a>
        </div>
        <div class="account-panel__body">
            {% set tracks = shipment.getTracksCollection() %}
                {% if tracks.getSize() > 0 %}
                    <dl class="mt-3 flex flex-wrap items-baseline gap-2 text-sm">
                    <dt class="table-label">{{ __('Tracking Number(s):') }}</dt>
                    <dd class="text-ink">
                    {% for track in tracks %}{{ track.getNumber() }}{% if not loop.last %}, {% endif %}{% endfor %}
                    </dd>
                    </dl>
                {% endif %}
                <div class="overflow-x-auto">
                    {% include 'Magento_Sales::order/items/shipment-table.twig' with { items: shipment.getAllItems(), order: order, itemOptions: itemOptions } %}
                </div>
        </div>
    </section>
{% endfor %}

<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {% if billing %}
        {% set billingBody %}<address class="address-lines">{{ info.getFormattedAddress(billing)|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Billing Address'), content: billingBody }) }}
    {% endif %}
    {% if shipping %}
        {% set shippingBody %}<address class="address-lines">{{ info.getFormattedAddress(shipping)|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Shipping Address'), content: shippingBody }) }}
    {% endif %}
</div>

<div class="mt-10 print:hidden">
    {% if is_guest %}
        <a href="{{ block.getUrl('sales/guest/form')|escape_url }}" class="link link--meta">{{ __('Back to Order Lookup') }}</a>
    {% else %}
        <a href="{{ block.getUrl('sales/order/history')|escape_url }}" class="link link--meta">{{ __('Back to My Orders') }}</a>
    {% endif %}
</div>
