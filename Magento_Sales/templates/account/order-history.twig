{# Order history. `history` is MageObsidian's Order\History (the core block plus a
   pager the theme can render); `order_presentation` supplies the thumbnails and
   the chip tone. Reorder is a native POST form; the page needs no JS.

   The pager matters here beyond navigation: it is what page-sizes the collection,
   so without rendering it the list is silently truncated at ten. #}
{% import 'Magento_Theme::macros/account.twig' as account %}

{% set history = block.getChildBlock('history') %}
{% set cancellation = block.getCancellation() %}
{% set presentation = block.getOrderPresentation() %}

{% set list = [] %}
{% for order in history.getOrders() %}{% set list = list|merge([order]) %}{% endfor %}

{{ account.page_header({ eyebrow: __('Account'), title: __('My Orders') }) }}

{% if list|length > 0 %}
    {% set thumbs = presentation.getThumbnails(list) %}
    <ul class="mt-8 flex flex-col gap-4">
        {% for order in list %}
            <li class="account-panel">
                <div class="account-panel__body">
                    <div class="flex flex-wrap items-start justify-between gap-4">
                        <div class="flex flex-wrap items-center gap-4">
                            {% set shot = thumbs[order.getEntityId()]|default(null) %}
                            {% if shot %}{{ account.order_thumbs(shot.thumbs, shot.total) }}{% endif %}
                            <div class="flex flex-col gap-1">
                                <span class="account-stat__label">{{ __('Order') }} #{{ order.getRealOrderId() }}</span>
                                <span class="text-sm text-ink-soft">{{ order.getCreatedAt()|date_format('medium') }}</span>
                            </div>
                        </div>
                        <div class="flex flex-col items-end gap-2">
                            {{ account.chip(order.getStatusLabel(), presentation.getStateTone(order)) }}
                            <span class="font-display text-xl text-ink">{{ order.formatPrice(order.getGrandTotal())|raw }}</span>
                        </div>
                    </div>

                    <div class="mt-6 flex flex-wrap items-center gap-5 border-t border-ash-200 pt-4">
                        <a href="{{ history.getViewUrl(order)|escape_url }}" class="link link--meta text-accent">{{ __('View Order') }}</a>
                        <form action="{{ history.getReorderUrl(order)|escape_url }}" method="post" class="inline" data-busy-submit>
                            {{ block.getBlockHtml('formkey')|raw }}
                            <button type="submit" class="link link--meta">{{ __('Reorder') }}</button>
                        </form>
                        {% include 'Magento_Sales::account/cancel-order.twig' with { 'order': order, 'cancellation': cancellation } %}
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>

    {% if history.getPagerHtml() %}
        <div class="mt-8">{{ history.getPagerHtml()|raw }}</div>
    {% endif %}
{% else %}
    <div class="mt-8">
        {{ account.empty_state(block, {
            icon: 'archive-box',
            title: __('You have placed no orders'),
            body: __('Once you order something it will live here — status, contents and a one-click reorder.'),
            cta: __('Start Shopping'),
            cta_url: block.getUrl('')
        }) }}
    </div>
{% endif %}
{{ script('MageObsidian_Storefront::js/form-busy') }}
