{# Customer invoice view. Data source: `invoice` (Sales\Block\Order\Invoice),
   giving the order and its invoice collection; `info` (Order\Info) for the
   formatted addresses. One styled table per invoice, mirroring
   order/invoice/items.phtml. Item line fidelity matches order-view
   (name/SKU/price/qty/subtotal + per-item options); tax breakdown lives in
   Track C. No JS. #}
{% import 'Magento_Theme::macros/account.twig' as account %}
{% set invoiceBlock = block.getChildBlock('invoice') %}
{% set info = block.getChildBlock('info') %}
{% set order = invoiceBlock.getOrder() %}
{% set itemOptions = block.getItemOptions() %}
{% set billing = order.getBillingAddress() %}
{% set shipping = order.getShippingAddress() %}
{% set labelClass = 'font-mono text-xs uppercase tracking-[0.14em] text-ink-soft' %}
{% set route_prefix = block.getData('route_prefix')|default('sales/order') %}
{% set is_guest = block.getData('is_guest')|default(false) %}
{% set presentation = block.getOrderPresentation() %}

{% set statusChip %}
    {%- if presentation -%}
        {{ account.chip(order.getStatusLabel(), presentation.getStateTone(order)) }}
    {%- endif -%}
{% endset %}
{{ account.page_header({
    eyebrow: order.getCreatedAt()|date_format('long'),
    title: __('Order') ~ ' #' ~ order.getRealOrderId(),
    action: statusChip
}) }}

{% include 'Magento_Sales::order/info/links.twig' with { 'order_id': order.getId(), 'current': 'invoice', 'route_prefix': route_prefix } %}

{% for invoice in order.getInvoiceCollection() %}
    <section class="account-panel mt-6">
        <div class="account-panel__head">
            <h2 class="account-panel__title">{{ __('Invoice #%1', invoice.getIncrementId()) }}</h2>
            <a href="{{ invoiceBlock.getPrintInvoiceUrl(invoice)|escape_url }}" target="_blank" rel="noopener"
               class="link link--meta print:hidden">{{ __('Print Invoice') }}</a>
        </div>
        <div class="account-panel__body">
            <div class="overflow-x-auto">
                <table class="w-full border-collapse text-sm">
                    <caption class="sr-only">{{ __('Items Invoiced') }}</caption>
                    <thead>
                        <tr class="border-b border-ash-300 text-left {{ labelClass }}">
                            <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('Product') }}</th>
                            <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('SKU') }}</th>
                            <th scope="col" class="py-3 pr-4 text-right font-mono font-normal">{{ __('Price') }}</th>
                            <th scope="col" class="py-3 pr-4 text-right font-mono font-normal">{{ __('Qty Invoiced') }}</th>
                            <th scope="col" class="py-3 text-right font-mono font-normal">{{ __('Subtotal') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in invoice.getAllItems() %}
                            {% if not item.getOrderItem().getParentItem() %}
                                <tr class="border-b border-ash-100 align-top">
                                    <td class="py-3 pr-4 text-ink">
                                    {{ item.getName() }}
                                    {% include 'Magento_Sales::order/items/item-options.twig' with { item: item, item_options: itemOptions, order: order } %}
                                    </td>
                                    <td class="py-3 pr-4 text-ink-soft">{{ item.getSku() }}</td>
                                    <td class="py-3 pr-4 text-right text-ink">{{ order.formatPrice(item.getPrice())|raw }}</td>
                                    <td class="py-3 pr-4 text-right text-ink">{{ item.getQty()|round }}</td>
                                    <td class="py-3 text-right text-ink">{{ order.formatPrice(item.getRowTotal())|raw }}</td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="mt-6 flex justify-end">
                {% include 'Magento_Sales::order/document-totals.twig' with { 'document': invoice, 'order': order, 'grand_label': __('Invoice Total') } %}
            </div>
        </div>
    </section>
{% endfor %}

<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {% if billing %}
        {% set billingBody %}<address class="text-sm not-italic leading-relaxed text-ink-soft">{{ info.getFormattedAddress(billing)|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Billing Address'), content: billingBody }) }}
    {% endif %}
    {% if shipping %}
        {% set shippingBody %}<address class="text-sm not-italic leading-relaxed text-ink-soft">{{ info.getFormattedAddress(shipping)|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Shipping Address'), content: shippingBody }) }}
    {% endif %}
</div>

<div class="mt-10 print:hidden">
    {% if is_guest %}
        <a href="{{ block.getUrl('sales/guest/form')|escape_url }}" class="link link--meta">{{ __('Back to Order Lookup') }}</a>
    {% else %}
        <a href="{{ block.getUrl('sales/order/history')|escape_url }}" class="link link--meta">{{ __('Back to My Orders') }}</a>
    {% endif %}
</div>
