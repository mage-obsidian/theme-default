{# Printable credit memo. Data source: `print` (PrintOrder\Creditmemo) — a single
   credit memo or the whole collection ("print all"). Standalone (header/footer
   print:hidden). #}
{% set printBlock = block.getChildBlock('print') %}
{% set order = printBlock.getOrder() %}
{% set single = printBlock.getCreditmemo() %}
{% set creditmemos = single ? [single] : order.getCreditmemosCollection() %}
{% set billing = order.getBillingAddress() %}
{% set shipping = order.getShippingAddress() %}
{% set labelClass = 'font-mono text-xs uppercase tracking-[0.14em] text-ink-soft' %}
{% set cardClass = 'rounded-edge border border-ash-200 p-6' %}

<div class="flex flex-col gap-1">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Order') }} #{{ order.getRealOrderId() }}</h1>
    <span class="text-sm text-ink-soft">{{ order.getCreatedAt()|date_format('long') }}</span>
</div>

{% for creditmemo in creditmemos %}
    <section class="mt-8">
        <h2 class="font-display text-lg text-ink">{{ __('Refund #%1', creditmemo.getIncrementId()) }}</h2>
        <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse text-sm">
                <caption class="sr-only">{{ __('Items Refunded') }}</caption>
                <thead>
                    <tr class="border-b border-ash-300 text-left {{ labelClass }}">
                        <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('Product') }}</th>
                        <th scope="col" class="py-3 pr-4 font-mono font-normal">{{ __('SKU') }}</th>
                        <th scope="col" class="py-3 pr-4 text-right font-mono font-normal">{{ __('Price') }}</th>
                        <th scope="col" class="py-3 pr-4 text-right font-mono font-normal">{{ __('Qty') }}</th>
                        <th scope="col" class="py-3 pr-4 text-right font-mono font-normal">{{ __('Subtotal') }}</th>
                        <th scope="col" class="py-3 pr-4 text-right font-mono font-normal">{{ __('Discount') }}</th>
                        <th scope="col" class="py-3 text-right font-mono font-normal">{{ __('Row Total') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in creditmemo.getAllItems() %}
                        {% if not item.getOrderItem().getParentItem() %}
                            <tr class="border-b border-ash-100 align-top">
                                <td class="py-3 pr-4 text-ink">{{ item.getName() }}</td>
                                <td class="py-3 pr-4 text-ink-soft">{{ item.getSku() }}</td>
                                <td class="py-3 pr-4 text-right text-ink">{{ order.formatPrice(item.getPrice())|raw }}</td>
                                <td class="py-3 pr-4 text-right text-ink">{{ item.getQty()|round }}</td>
                                <td class="py-3 pr-4 text-right text-ink">{{ order.formatPrice(item.getRowTotal())|raw }}</td>
                                <td class="py-3 pr-4 text-right text-ink">{{ order.formatPrice(item.getDiscountAmount())|raw }}</td>
                                <td class="py-3 text-right text-ink">{{ order.formatPrice(item.getRowTotal() - item.getDiscountAmount() + item.getTaxAmount())|raw }}</td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="mt-4 flex justify-end">
            {% include 'Magento_Sales::order/document-totals.twig' with { 'document': creditmemo, 'order': order, 'grand_label': __('Refund Total') } %}
        </div>
    </section>
{% endfor %}

<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {% if billing %}
        <section class="{{ cardClass }}">
            <h2 class="{{ labelClass }}">{{ __('Billing Address') }}</h2>
            <address class="mt-3 text-sm not-italic leading-relaxed text-ink-soft">{{ printBlock.formatAddress(billing, 'html')|raw }}</address>
        </section>
    {% endif %}
    {% if shipping %}
        <section class="{{ cardClass }}">
            <h2 class="{{ labelClass }}">{{ __('Shipping Address') }}</h2>
            <address class="mt-3 text-sm not-italic leading-relaxed text-ink-soft">{{ printBlock.formatAddress(shipping, 'html')|raw }}</address>
        </section>
    {% endif %}
</div>
