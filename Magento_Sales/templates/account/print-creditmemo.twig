{# Printable credit memo. Data source: `print` (PrintOrder\Creditmemo) — a single
   credit memo or the whole collection ("print all"). Standalone (header/footer
   print:hidden). #}
{% import 'Magento_Theme::macros/account.twig' as account %}
{% set printBlock = block.getChildBlock('print') %}
{% set order = printBlock.getOrder() %}
{% set itemOptions = block.getItemOptions() %}
{% set single = printBlock.getCreditmemo() %}
{% set creditmemos = single ? [single] : order.getCreditmemosCollection() %}
{% set billing = order.getBillingAddress() %}
{% set shipping = order.getShippingAddress() %}

{{ account.page_header({
    eyebrow: order.getCreatedAt()|date_format('long'),
    title: __('Order') ~ ' #' ~ order.getRealOrderId()
}) }}

{% for creditmemo in creditmemos %}
    <section class="mt-8">
        <h2 class="font-display text-lg text-ink">{{ __('Refund #%1', creditmemo.getIncrementId()) }}</h2>
        <div class="mt-4 overflow-x-auto">
            {% include 'Magento_Sales::order/items/creditmemo-table.twig' with { items: creditmemo.getAllItems(), order: order, itemOptions: itemOptions } %}
        </div>
        <div class="mt-4 flex justify-end">
            {% include 'Magento_Sales::order/document-totals.twig' with { 'document': creditmemo, 'order': order, 'grand_label': __('Refund Total') } %}
        </div>
    </section>
{% endfor %}

<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
    {% if billing %}
        {% set billingBody %}<address class="address-lines">{{ printBlock.formatAddress(billing, 'html')|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Billing Address'), content: billingBody }) }}
    {% endif %}
    {% if shipping %}
        {% set shippingBody %}<address class="address-lines">{{ printBlock.formatAddress(shipping, 'html')|raw }}</address>{% endset %}
        {{ account.panel({ title: __('Shipping Address'), content: shippingBody }) }}
    {% endif %}
</div>
