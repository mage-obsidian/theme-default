{# Order totals. `block` is the core Order\Totals block itself; rendering it runs
   _beforeToHtml → _initTotals, so getTotals() is populated here (it is not when
   the block is only used as a bare data source). The base block omits a tax
   line, so we inject it from the order right before the grand total — expanded
   into one row per rate when the store enables the full tax summary
   (tax_breakdown ViewModel), otherwise a single Tax line. #}
{% set order = block.getOrder() %}
{% set taxBreakdown = block.getTaxBreakdown() %}
{% set taxRates = taxBreakdown and taxBreakdown.isFullSummary() ? taxBreakdown.getRates(order) : [] %}
{# Fixed Product Tax (WEEE): the order carries no FPT column, so sum the line
   amounts to show it as its own total (otherwise the FPT silently inflates the
   grand total). 0 for stores without WEEE — the row is skipped. #}
{% set fptTotal = 0 %}
{% for lineItem in order.getAllVisibleItems() %}
    {% set fptTotal = fptTotal + lineItem.getWeeeTaxAppliedRowAmount() %}
{% endfor %}
<table class="w-full max-w-sm text-sm">
    <caption class="sr-only">{{ __('Order Totals') }}</caption>
    {% for total in block.getTotals() %}
        {% if total.getCode() == 'grand_total' and order.getTaxAmount() > 0 %}
            {% if taxRates is not empty %}
                {% for rate in taxRates %}
                    <tr class="text-ink-soft">
                        <th scope="row" class="py-2 pr-6 text-left font-normal table-label">{{ rate.title }} ({{ rate.percent }}%)</th>
                        <td class="py-2 text-right">{{ order.formatPrice(rate.amount)|raw }}</td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr class="text-ink-soft">
                    <th scope="row" class="py-2 pr-6 text-left font-normal table-label">{{ __('Tax') }}</th>
                    <td class="py-2 text-right">{{ order.formatPrice(order.getTaxAmount())|raw }}</td>
                </tr>
            {% endif %}
        {% endif %}
        {% if total.getCode() == 'grand_total' and fptTotal > 0 %}
            <tr class="text-ink-soft">
                <th scope="row" class="py-2 pr-6 text-left font-normal table-label">{{ __('Fixed Product Tax') }}</th>
                <td class="py-2 text-right">{{ order.formatPrice(fptTotal)|raw }}</td>
            </tr>
        {% endif %}
        <tr class="{{ total.getCode() == 'grand_total' ? 'border-t border-ash-300 font-display text-base text-ink' : 'text-ink-soft' }}">
            <th scope="row" class="py-2 pr-6 text-left font-normal {{ total.getCode() == 'grand_total' ? '' : 'table-label' }}">{{ total.getLabel() }}</th>
            <td class="py-2 text-right">{{ block.formatValue(total)|raw }}</td>
        </tr>
    {% endfor %}
</table>
