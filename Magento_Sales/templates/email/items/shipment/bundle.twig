{% set parent = block.getItem() %}
{% set rows = [parent.getOrderItem()]|merge(parent.getOrderItem().getChildrenItems()) %}
{% set shipped = block.getChildren(parent) %}
{% set previousOption = '' %}
{% for row in rows %}
    {% if row.getParentItem() %}
        {% set attributes = block.getSelectionAttributes(row) %}
        {% if previousOption != attributes.option_id %}
            <tr class="bundle-option-label">
                <td colspan="2"><strong><em>{{ attributes.option_label }}</em></strong></td>
            </tr>
            {% set previousOption = attributes.option_id %}
        {% endif %}
        <tr class="bundle-item bundle-option-value">
            <td class="item-info"><p>{{ block.getValueHtml(row)|raw }}</p></td>
    {% else %}
        <tr class="bundle-item bundle-parent">
            <td class="item-info">
                <p class="product-name">{{ row.getName() }}</p>
                <p class="sku">{{ __('SKU') }}: {{ block.getSku(row) }}</p>
            </td>
    {% endif %}
            <td class="item-qty">
                {% if (block.isShipmentSeparately() and row.getParentItem()) or (not block.isShipmentSeparately() and not row.getParentItem()) %}
                    {% if shipped[row.getId()] is defined %}{{ shipped[row.getId()].getQty() + 0 }}{% elseif row.getIsVirtual() %}{{ __('N/A') }}{% else %}0{% endif %}
                {% else %}
                    &nbsp;
                {% endif %}
            </td>
        </tr>
{% endfor %}
{% set options = block.getItemOptions() %}
{% if options or parent.getDescription() %}
    <tr>
        <td colspan="2" class="item-extra">
            {% if options %}
                <dl>
                    {% for option in options %}
                        <dt><strong><em>{{ option.label }}</em></strong></dt>
                        <dd>{{ option.value }}</dd>
                    {% endfor %}
                </dl>
            {% endif %}
            {{ parent.getDescription() }}
        </td>
    </tr>
{% endif %}
