{# Multishipping step 1 — assign each item (and qty) to a shipping address.
   `block` is the native Checkout\Addresses block (data source). The form POSTs to
   the native controller; the submit buttons carry the `continue` / `new_address`
   flags as their own name/value so the flow works without JS (the Knockout flag
   toggling is dropped). The per-item address picker is the block's native select. #}
<section class="mx-auto w-full max-w-[1100px] px-4 py-10 md:px-8">
    <h1 class="font-display text-3xl tracking-[0.06em] text-ink">{{ __('Ship to Multiple Addresses') }}</h1>
    <p class="mt-2 text-sm text-ink-soft">{{ __('Please select a shipping address for applicable items.') }}</p>

    <form action="{{ block.getPostActionUrl()|escape_url }}" method="post" class="mt-8">
        {{ block.getBlockHtml('formkey')|raw }}
        <div class="overflow-x-auto rounded-edge border border-ash-200">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-ash-200 font-mono text-xs uppercase tracking-[0.12em] text-ink-soft">
                    <tr>
                        <th class="px-4 py-3" scope="col">{{ __('Product') }}</th>
                        <th class="px-4 py-3" scope="col">{{ __('Qty') }}</th>
                        <th class="px-4 py-3" scope="col">{{ __('Send To') }}</th>
                        <th class="px-4 py-3" scope="col"><span class="sr-only">{{ __('Actions') }}</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-ash-200">
                    {% for index, item in block.getItems() %}
                        {% if item.getQuoteItem() %}
                            <tr>
                                <td class="px-4 py-4 align-top text-ink">{{ item.getQuoteItem().getName() }}</td>
                                <td class="px-4 py-4 align-top">
                                    <label class="sr-only" for="ship-{{ index }}-{{ item.getQuoteItemId() }}-qty">{{ __('Qty') }}</label>
                                    <input type="number" min="0" size="2"
                                           id="ship-{{ index }}-{{ item.getQuoteItemId() }}-qty"
                                           name="ship[{{ index }}][{{ item.getQuoteItemId() }}][qty]"
                                           value="{{ item.getQty() }}"
                                           class="field__control field-qty w-16 px-2">
                                </td>
                                <td class="px-4 py-4 align-top">
                                    {% if item.getProduct().getIsVirtual() %}
                                        <span class="text-ink-soft">{{ __('A shipping selection is not applicable.') }}</span>
                                    {% else %}
                                        <label class="sr-only" for="ship_{{ index }}_{{ item.getQuoteItemId() }}_address">{{ __('Send To') }}</label>
                                        <div class="field-slot">
                                            {{ block.getAddressesHtmlSelect(item, index)|raw }}
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-4 align-top text-right">
                                    <a href="{{ block.getItemDeleteUrl(item)|escape_url }}" class="link text-sm text-ash-500">{{ __('Remove item') }}</a>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div class="flex flex-wrap items-center gap-4">
                <button type="submit" name="new_address" value="1" class="btn btn--outline btn--sm">{{ __('Enter a New Address') }}</button>
                <button type="submit" name="continue" value="0" class="btn btn--outline btn--sm">{{ __('Update Qty & Addresses') }}</button>
                <a href="{{ block.getBackUrl()|escape_url }}" class="font-mono text-xs uppercase tracking-[0.14em] text-ink-soft transition-colors hover:text-ink">{{ __('Back to Shopping Cart') }}</a>
            </div>
            <button type="submit" name="continue" value="1" {{ block.isContinueDisabled() ? 'disabled' : '' }}
                    class="btn btn--solid">
                {{ __('Go to Shipping Information') }}
            </button>
        </div>
    </form>
</section>
