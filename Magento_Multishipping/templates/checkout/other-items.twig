{% if block.getQuote().hasVirtualItems() %}
    {% set renderer = block.getParentBlock().getChildBlock('checkout.cart.item.renderers') %}
    <section class="rounded-edge border border-ash-200 p-6" data-other-items>
        <div class="flex items-center justify-between">
            <h2 class="font-mono text-xs uppercase tracking-eyebrow text-ink-soft">{{ __('Other items in your order') }}</h2>
            <a href="{{ block.getVirtualProductEditUrl()|escape_url }}" class="link text-xs text-ink-soft underline">{{ __('Edit Items') }}</a>
        </div>
        <p class="mt-2 text-sm text-ink-soft">{{ __('Shipping is not applicable.') }}</p>
        <ul class="mt-3 text-sm text-ink-soft">
            {% for item in block.getVirtualQuoteItems() %}
                <li>
                    {{ item.getName() }} <span class="text-ash-500">× {{ item.getQty() * 1 }}</span>
                    {% if renderer %}{{ renderer.setItem(item).toHtml()|raw }}{% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
{% endif %}
