{# Wish list sharing form. `block` is the MageObsidian Template; `sharing` is the
   core Customer\Sharing block (send URL, previously entered values, back URL).
   Native POST to wishlist/index/send — the controller validates the emails. The
   captcha child renders only when configured. No JS. #}
{% import 'Magento_Theme::macros/form.twig' as form %}
{% set sharing = block.getChildBlock('sharing') %}

<h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('Share Wish List') }}</h1>

<form action="{{ sharing.getSendUrl()|escape_url }}" method="post" class="mt-8 flex max-w-xl flex-col gap-6">
    {{ block.getBlockHtml('formkey')|raw }}
    {{ form.field({
        name: 'emails',
        id: 'email_address',
        label: __('Email addresses, separated by commas'),
        type: 'textarea',
        value: sharing.getEnteredData('emails'),
        required: true,
        attrs: { rows: 4 }
    }) }}
    {{ form.field({
        name: 'message',
        id: 'message',
        label: __('Message'),
        type: 'textarea',
        value: sharing.getEnteredData('message'),
        attrs: { rows: 5 }
    }) }}
    {{ block.getChildHtml('captcha')|raw }}
    {{ form.required_note(__('Required fields')) }}
    <div class="flex items-center gap-4">
        <button type="submit"
                class="h-11 rounded-edge bg-ink px-6 font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">
            {{ __('Share Wish List') }}
        </button>
        <a href="{{ sharing.getBackUrl()|escape_url }}"
           class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft underline-offset-4 transition-colors hover:text-accent hover:underline">
            {{ __('Back') }}
        </a>
    </div>
</form>
