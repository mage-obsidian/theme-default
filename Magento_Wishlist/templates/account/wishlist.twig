{# Wish list. `wishlist` is the core Customer\Wishlist block (item collection,
   add-all params). Item actions are native POST forms (work without JS):
   move-to-cart → wishlist/index/cart, remove → wishlist/index/remove. The
   cart controller redirects configurable products to the PDP to pick options. #}
{% set wishlist = block.getChildBlock('wishlist') %}
{% set thumbnail = block.getThumbnail() %}
{% set items = wishlist.getWishlistItems() %}
{% set labelClass = 'font-mono text-xs uppercase tracking-[0.14em] text-ink-soft' %}
{% set inputClass = 'h-10 w-16 rounded-edge border border-ash-300 bg-transparent px-2 text-center text-sm text-ink focus:border-ink focus:outline-none' %}

<div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-3xl tracking-[0.08em] text-ink">{{ __('My Wish List') }}</h1>
    {% if items.getSize() > 0 %}
        <div class="flex flex-wrap items-center gap-4">
            <a href="{{ block.getUrl('wishlist/index/share')|escape_url }}" class="font-mono text-xs uppercase tracking-[0.12em] text-ink-soft underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Share Wish List') }}</a>
            <form action="{{ block.getUrl('wishlist/index/allcart')|escape_url }}" method="post" class="inline">
                {{ block.getBlockHtml('formkey')|raw }}
                <button type="submit" class="h-11 rounded-edge bg-ink px-6 font-mono text-xs uppercase tracking-[0.18em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Add All to Cart') }}</button>
            </form>
        </div>
    {% endif %}
</div>

{% if items.getSize() > 0 %}
    <ul class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
        {% for item in items %}
            {% set product = item.getProduct() %}
            {% set img = thumbnail.get(product) %}
            <li class="flex flex-col gap-3 rounded-edge border border-ash-200 p-4">
                <a href="{{ product.getProductUrl()|escape_url }}" class="block overflow-hidden rounded-edge bg-ash-50">
                    <img src="{{ img.url|escape_url }}" width="{{ img.width }}" height="{{ img.height }}" alt="{{ img.label|escape_html_attr }}" loading="lazy" class="h-auto w-full object-cover">
                </a>
                <a href="{{ product.getProductUrl()|escape_url }}" class="text-sm text-ink underline-offset-4 transition-colors hover:text-accent hover:underline">{{ product.getName() }}</a>
                <span class="font-display text-lg text-ink">{{ product.getFinalPrice()|price }}</span>

                {% if not product.isSaleable() %}
                    <span class="mt-auto {{ labelClass }} text-ash-500">{{ __('Out of stock') }}</span>
                {% elseif product.getTypeInstance().canConfigure(product) %}
                    {# Configurable/bundle/grouped need options → send to the PDP (same
                       as ProductCard); a direct cart POST would hit the configure page. #}
                    <a href="{{ product.getProductUrl()|escape_url }}" class="mt-auto flex h-10 items-center justify-center rounded-edge bg-ink px-3 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('View Options') }}</a>
                {% else %}
                    <form action="{{ block.getUrl('wishlist/index/cart')|escape_url }}" method="post" class="mt-auto flex items-center gap-2">
                        {{ block.getBlockHtml('formkey')|raw }}
                        <input type="hidden" name="item" value="{{ item.getId()|escape_html_attr }}">
                        <label class="sr-only" for="qty-{{ item.getId() }}">{{ __('Quantity') }}</label>
                        <input type="number" id="qty-{{ item.getId() }}" name="qty" value="{{ item.getQty()|round }}" min="1" class="{{ inputClass }}">
                        <button type="submit" class="h-10 flex-1 rounded-edge bg-ink px-3 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-alabaster transition-colors hover:bg-ink-soft">{{ __('Add to Cart') }}</button>
                    </form>
                {% endif %}

                <form action="{{ block.getUrl('wishlist/index/remove')|escape_url }}" method="post">
                    {{ block.getBlockHtml('formkey')|raw }}
                    <input type="hidden" name="item" value="{{ item.getId()|escape_html_attr }}">
                    <button type="submit" class="{{ labelClass }} underline-offset-4 transition-colors hover:text-accent hover:underline">{{ __('Remove') }}</button>
                </form>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="mt-8 text-sm text-ink-soft">{{ __('You have no items in your wish list.') }}</p>
    <a href="{{ wishlist.getBackUrl()|escape_url }}" class="mt-4 inline-block font-mono text-xs uppercase tracking-[0.12em] text-accent underline-offset-4 transition-colors hover:underline">{{ __('Continue Shopping') }}</a>
{% endif %}
